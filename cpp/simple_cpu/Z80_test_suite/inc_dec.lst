0B02                TEST_DEC_SP:   
0B02                          ; Save real SP to restore later
0B02   21 00 00               LD   HL,0   
0B05   39                     ADD   HL,SP   
0B06   22 0A 00               LD   (TEMP_SP_SAVE),HL   
0B09                          ; --- Case 1: Flag Preservation and Wrap (0x0000 -> 0xFFFF) ---
0B09   31 00 00               LD   SP,0x0000   
0B0C   01 FF 00               LD   BC,0x00FF   ; B = Expected Low byte (FF - checked via SP), C = Flags (FF)
0B0F   C5                     PUSH   BC   
0B10   F1                     POP   AF   ; Load flags with 0xFF
0B11   3B                     DEC   SP   
0B12                          ; Verify Flags: Must still be 0xFF
0B12   F5                     PUSH   AF   
0B13   C1                     POP   BC   
0B14   79                     LD   A,C   
0B15   EE FF                  XOR   0xFF   
0B17   C2 0C 00               JP   NZ,ERROR   
0B1A                          ; Verify Result: SP should be 0xFFFF
0B1A   21 00 00               LD   HL,0   
0B1D   39                     ADD   HL,SP   ; HL now equals SP
0B1E   7C                     LD   A,H   
0B1F   EE FF                  XOR   0xFF   
0B21   C2 0C 00               JP   NZ,ERROR   
0B24   7D                     LD   A,L   
0B25   EE FF                  XOR   0xFF   
0B27   C2 0C 00               JP   NZ,ERROR   
0B2A                          ; Restore original SP
0B2A   2A 0A 00               LD   HL,(TEMP_SP_SAVE)   
0B2D   F9                     LD   SP,HL   
0B2E   C9                     RET