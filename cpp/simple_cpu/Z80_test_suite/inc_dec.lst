0568                TEST_DEC_A:   
0568                          ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
0568                          ; Tests basic subtraction, the Zero flag, and the N flag.
0568   11 00 01               LD   DE,0x0100   ; D = Initial A value (0x01), E = Initial Flags (0x00)
056B   D5                     PUSH   DE   ; Push DE onto the stack
056C   F1                     POP   AF   ; Pop into AF. Now Accumulator (A) = 0x01, Flags (F) = 0x00
056D   3D                     DEC   A   ; Execute Opcode: A = A - 1. A becomes 0x00.
056E   F5                     PUSH   AF   ; Push the result and the newly generated flags to the stack
056F   D1                     POP   DE   ; Pop into DE. D = Result (0x00), E = New Flags
0570                          ; Verify Result
0570   FE 00                  CP   0x00   ; Compare Accumulator with 0x00 (Subtracts 0x00 from A, updates flags, discards result)
0572   C2 0C 00               JP   NZ,ERROR   ; If A was not 0x00, the Zero flag won't be set. Jump to ERROR.
0575                          ; Verify Flags stored in E:
0575   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 0 (0x00 is not negative)
0577   C2 0C 00               JP   NZ,ERROR   ; Error if bit 7 was 1
057A   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 1 (Result of DEC was zero)
057C   CA 0C 00               JP   Z,ERROR   ; Error if bit 6 was 0
057F   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 0 (No borrow from bit 4 occurred: 0x1 -> 0x0)
0581   C2 0C 00               JP   NZ,ERROR   ; Error if bit 4 was 1
0584   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 0 (No signed overflow occurred)
0586   C2 0C 00               JP   NZ,ERROR   ; Error if bit 2 was 1
0589   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC operations)
058B   CA 0C 00               JP   Z,ERROR   ; Error if bit 1 was 0
058E   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 0 (DEC never affects the Carry flag, should remain 0)
0590   C2 0C 00               JP   NZ,ERROR   ; Error if bit 0 was 1
0593                          ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
0593                          ; Tests underflow wrapping, the Half-Carry flag, and ensuring Carry is preserved.
0593   11 FF 00               LD   DE,0x00FF   ; D = Initial A (0x00), E = Initial Flags (0xFF, sets all flags including Carry)
0596   D5                     PUSH   DE   
0597   F1                     POP   AF   ; A = 0x00, Flags = 0xFF
0598   3D                     DEC   A   ; Execute Opcode: 0x00 - 1 = 0xFF.
0599   F5                     PUSH   AF   
059A   D1                     POP   DE   ; Save results. D = Result (0xFF), E = New Flags
059B                          ; Verify Result
059B   FE FF                  CP   0xFF   ; Compare A with 0xFF
059D   C2 0C 00               JP   NZ,ERROR   ; Error if A did not correctly wrap around to 0xFF
05A0                          ; Verify Flags stored in E:
05A0   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 1 (0xFF has bit 7 set, treating it as negative)
05A2   CA 0C 00               JP   Z,ERROR   ; Error if bit 7 was 0
05A5   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 0 (Result 0xFF is not zero)
05A7   C2 0C 00               JP   NZ,ERROR   ; Error if bit 6 was 1
05AA   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow from bit 4)
05AC   CA 0C 00               JP   Z,ERROR   ; Error if bit 4 was 0
05AF   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 0 (Wrapping 0x00 to 0xFF is not a signed overflow)
05B1   C2 0C 00               JP   NZ,ERROR   ; Error if bit 2 was 1
05B4   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
05B6   CA 0C 00               JP   Z,ERROR   ; Error if bit 1 was 0
05B9   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 1 (DEC does not affect Carry; should preserve initial 1)
05BB   CA 0C 00               JP   Z,ERROR   ; Error if bit 0 was 0
05BE                          ; --- Case 3: Overflow (0x80 -> 0x7F) ---
05BE                          ; Tests the specific edge case where a negative signed byte decrements into a positive one.
05BE   11 00 80               LD   DE,0x8000   ; D = Initial A (0x80 or -128), E = Initial Flags (0x00)
05C1   D5                     PUSH   DE   
05C2   F1                     POP   AF   ; A = 0x80, Flags = 0x00
05C3   3D                     DEC   A   ; Execute Opcode: 0x80 (-128) - 1 = 0x7F (+127). This is a signed overflow.
05C4   F5                     PUSH   AF   
05C5   D1                     POP   DE   ; Save results. D = Result (0x7F), E = New Flags
05C6                          ; Verify Result
05C6   FE 7F                  CP   0x7F   ; Compare A with 0x7F
05C8   C2 0C 00               JP   NZ,ERROR   ; Error if result is not 0x7F
05CB                          ; Verify Flags stored in E:
05CB   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 0 (0x7F has bit 7 clear, it is positive)
05CD   C2 0C 00               JP   NZ,ERROR   ; Error if bit 7 was 1
05D0   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 0 (Result is not zero)
05D2   C2 0C 00               JP   NZ,ERROR   ; Error if bit 6 was 1
05D5   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow)
05D7   CA 0C 00               JP   Z,ERROR   ; Error if bit 4 was 0
05DA   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 1 (Sign changed from neg to pos: OVERFLOW!)
05DC   CA 0C 00               JP   Z,ERROR   ; Error if bit 2 was 0
05DF   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
05E1   CA 0C 00               JP   Z,ERROR   ; Error if bit 1 was 0
05E4   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 0 (DEC does not affect Carry; preserves initial 0)
05E6   C2 0C 00               JP   NZ,ERROR   ; Error if bit 0 was 1
05E9   C9                     RET   
05EA                TEST_DEC_B:   
05EA                          ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
05EA   06 01                  LD   B,0x01   ; Initial value for B
