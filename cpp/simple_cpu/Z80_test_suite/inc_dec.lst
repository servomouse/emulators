0FE1   0B                     DEC   BC   ; Execute Opcode: BC = BC - 1. BC becomes 0x0001.
0FE2   F5                     PUSH   AF   
0FE3   D1                     POP   DE   ; Extract flags into E.
0FE4                          ; Verify Result
0FE4   78                     LD   A,B   
