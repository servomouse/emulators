0AA7   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 0 (Result is not zero)
0AA9   C2 0C 00               JP   NZ,ERROR   ; Error if bit 6 was 1
0AAC   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow)
0AAE   CA 0C 00               JP   Z,ERROR   ; Error if bit 4 was 0
0AB1   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 1 (Sign changed from neg to pos: OVERFLOW!)
0AB3   CA 0C 00               JP   Z,ERROR   ; Error if bit 2 was 0
0AB6   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
0AB8   CA 0C 00               JP   Z,ERROR   ; Error if bit 1 was 0
0ABB   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 0 (DEC does not affect Carry; preserves initial 0)
0ABD   C2 0C 00               JP   NZ,ERROR   ; Error if bit 0 was 1
0AC0   C9                     RET   
