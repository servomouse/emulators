0622   78                     LD   A,B   ; Move result into A for comparison
0623   FE FF                  CP   0xFF   ; Compare with 0xFF
0625   C2 0C 00               JP   NZ,ERROR   ; Error if B did not correctly wrap around to 0xFF
0628                          ; Verify Flags stored in E:
0628   CB 7B                  BIT   7,E   ; S flag (Expected: 1)
062A   CA 0C 00               JP   Z,ERROR   
062D   CB 73                  BIT   6,E   ; Z flag (Expected: 0)
062F   C2 0C 00               JP   NZ,ERROR   
