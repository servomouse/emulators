0A28   3E 80                  LD   A,0x80   
0A2A   32 05 FF               LD   (IX_ABS_ADDR),A   
0A2D   11 00 00               LD   DE,0x0000   
0A30   D5                     PUSH   DE   
0A31   F1                     POP   AF   
