0548                TEST_DEC_B:   
0548                          ; --- Case 1: Standard Decrement (0x02 -> 0x01) ---
0548   11 00 01               LD   DE,0x0100   ; D = expected result (01), E = initial flags (00)
054B   06 02                  LD   B,0x02   
054D   D5                     PUSH   DE   
054E   F1                     POP   AF   ; Clear flags
054F   05                     DEC   B   
0550   F5                     PUSH   AF   
0551   D1                     POP   DE   ; E now contains Flags
0552                          ; Verify result (A XOR B)
0552   7A                     LD   A,D   
0553   A8                     XOR   B   
0554   C2 0A 00               JP   NZ,ERROR   
0557                          ; Verify Flags: Z=0, S=0, H=0, V=0, N=1, C=0
0557   CB 73                  BIT   6,E   ; Z flag
0559   C2 0A 00               JP   NZ,ERROR   
055C   CB 63                  BIT   4,E   ; H flag
055E   C2 0A 00               JP   NZ,ERROR   
0561   CB 4B                  BIT   1,E   ; N flag (Should be SET for DEC)
0563   CA 0A 00               JP   Z,ERROR   
0566   CB 43                  BIT   0,E   ; C flag
0568   C2 0A 00               JP   NZ,ERROR   
056B                          ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
056B   11 01 FF               LD   DE,0xFF01   ; D = expected result (FF), E = initial flags (01, C set)
056E   06 00                  LD   B,0x00   
0570   D5                     PUSH   DE   
0571   F1                     POP   AF   
0572   05                     DEC   B   
0573   F5                     PUSH   AF   
0574   D1                     POP   DE   ; E contains Flags
0575   7A                     LD   A,D   
0576   A8                     XOR   B   
0577   C2 0A 00               JP   NZ,ERROR   
057A                          ; Verify Flags: Z=0, S=1, H=1, V=0, N=1, C stays 1
057A   CB 73                  BIT   6,E   ; Z flag
057C   C2 0A 00               JP   NZ,ERROR   
057F   CB 7B                  BIT   7,E   ; S flag
0581   CA 0A 00               JP   Z,ERROR   
0584   CB 63                  BIT   4,E   ; H flag (Borrow from bit 4)
0586   CA 0A 00               JP   Z,ERROR   
0589   CB 4B                  BIT   1,E   ; N flag
058B   CA 0A 00               JP   Z,ERROR   
058E   CB 43                  BIT   0,E   ; C flag
0590   CA 0A 00               JP   Z,ERROR   
0593                          ; --- Case 3: Overflow (0x80 -> 0x7F) ---
0593   11 00 7F               LD   DE,0x7F00   ; D = expected result (7F), E = initial flags (00)
0596   06 80                  LD   B,0x80   ; Min negative
0598   D5                     PUSH   DE   
0599   F1                     POP   AF   
059A   05                     DEC   B   ; Should result in 0x7F (Max positive), setting V
059B   F5                     PUSH   AF   
059C   D1                     POP   DE   ; E contains Flags
059D   7A                     LD   A,D   
059E   A8                     XOR   B   
059F   C2 0A 00               JP   NZ,ERROR   
05A2                          ; Verify Flags: Z=0, S=0, H=0, V=1, N=1, C stays 0
05A2   CB 7B                  BIT   7,E   ; S flag
05A4   C2 0A 00               JP   NZ,ERROR   
05A7   CB 53                  BIT   2,E   ; V flag (Overflow)
05A9   CA 0A 00               JP   Z,ERROR   
05AC   CB 4B                  BIT   1,E   ; N flag
05AE   CA 0A 00               JP   Z,ERROR   
05B1   C9                     RET