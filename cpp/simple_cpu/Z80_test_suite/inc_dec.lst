096D   CB 7B                  BIT   7,E   ; S flag (Expected: 1)
096F   CA 0C 00               JP   Z,ERROR   
0972   CB 73                  BIT   6,E   ; Z flag (Expected: 0)
0974   C2 0C 00               JP   NZ,ERROR   
0977   CB 63                  BIT   4,E   ; H flag (Expected: 1)
0979   CA 0C 00               JP   Z,ERROR   
097C   CB 53                  BIT   2,E   ; V/P flag (Expected: 0)
097E   C2 0C 00               JP   NZ,ERROR   
0981   CB 4B                  BIT   1,E   ; N flag (Expected: 1)
0983   CA 0C 00               JP   Z,ERROR   
0986   CB 43                  BIT   0,E   ; C flag (Expected: 1, preserves initial 1)
0988   CA 0C 00               JP   Z,ERROR   
098B                          ; --- Case 3: Overflow (0x80 -> 0x7F) ---
098B   36 80                  LD   (HL),0x80   ; Initial memory value
098D   11 00 00               LD   DE,0x0000   ; E = Initial Flags (0x00)
0990   D5                     PUSH   DE   
0991   F1                     POP   AF   ; Flags = 0x00
0992   35                     DEC   (HL)   ; Execute Opcode: 0x80 - 1 = 0x7F.
0993   F5                     PUSH   AF   
0994   D1                     POP   DE   ; E = New Flags
0995                          ; Verify Result
0995   7E                     LD   A,(HL)   
0996   FE 7F                  CP   0x7F   
0998   C2 0C 00               JP   NZ,ERROR   
099B                          ; Verify Flags stored in E:
099B   CB 7B                  BIT   7,E   ; S flag (Expected: 0)
099D   C2 0C 00               JP   NZ,ERROR   
09A0   CB 73                  BIT   6,E   ; Z flag (Expected: 0)
09A2   C2 0C 00               JP   NZ,ERROR   
09A5   CB 63                  BIT   4,E   ; H flag (Expected: 1)
09A7   CA 0C 00               JP   Z,ERROR   
09AA   CB 53                  BIT   2,E   ; V/P flag (Expected: 1, OVERFLOW!)
09AC   CA 0C 00               JP   Z,ERROR   
09AF   CB 4B                  BIT   1,E   ; N flag (Expected: 1)
09B1   CA 0C 00               JP   Z,ERROR   
09B4   CB 43                  BIT   0,E   ; C flag (Expected: 0)
09B6   C2 0C 00               JP   NZ,ERROR   
09B9   C9                     RET   
