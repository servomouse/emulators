065D   C2 0C 00               JP   NZ,ERROR   
0660   CB 63                  BIT   4,E   ; H flag (Expected: 1)
0662   CA 0C 00               JP   Z,ERROR   
0665   CB 53                  BIT   2,E   ; V/P flag (Expected: 1, OVERFLOW!)
0667   CA 0C 00               JP   Z,ERROR   
066A   CB 4B                  BIT   1,E   ; N flag (Expected: 1)
066C   CA 0C 00               JP   Z,ERROR   
066F   CB 43                  BIT   0,E   ; C flag (Expected: 0)
0671   C2 0C 00               JP   NZ,ERROR   
0674   C9                     RET   
