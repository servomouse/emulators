092C                TEST_DEC_MEM_HL:   
092C   21 00 FF               LD   HL,TEST_RAM   ; Point HL to our writable memory location
092F                          ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
092F   36 01                  LD   (HL),0x01   ; Initial memory value
0931   11 00 00               LD   DE,0x0000   ; E = Initial Flags (0x00)
0934   D5                     PUSH   DE   
0935   F1                     POP   AF   ; Flags = 0x00
0936   35                     DEC   (HL)   ; Execute Opcode: (HL) = (HL) - 1. Memory becomes 0x00.
0937   F5                     PUSH   AF   ; Push the newly generated flags to the stack
0938   D1                     POP   DE   ; Pop into DE. E = New Flags
0939                          ; Verify Result
0939   7E                     LD   A,(HL)   ; Read the modified memory byte back into A
093A   FE 00                  CP   0x00   ; Compare with 0x00
093C   C2 0C 00               JP   NZ,ERROR   ; Error if result is not 0x00
093F                          ; Verify Flags stored in E:
093F   CB 7B                  BIT   7,E   ; S flag (Expected: 0)
0941   C2 0C 00               JP   NZ,ERROR   
0944   CB 73                  BIT   6,E   ; Z flag (Expected: 1)
0946   CA 0C 00               JP   Z,ERROR   
0949   CB 63                  BIT   4,E   ; H flag (Expected: 0)
094B   C2 0C 00               JP   NZ,ERROR   
094E   CB 53                  BIT   2,E   ; V/P flag (Expected: 0)
0950   C2 0C 00               JP   NZ,ERROR   
0953   CB 4B                  BIT   1,E   ; N flag (Expected: 1)
0955   CA 0C 00               JP   Z,ERROR   
0958   CB 43                  BIT   0,E   ; C flag (Expected: 0)
095A   C2 0C 00               JP   NZ,ERROR   
095D                          ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
095D   36 00                  LD   (HL),0x00   ; Initial memory value
095F   11 FF 00               LD   DE,0x00FF   ; E = Initial Flags (0xFF)
0962   D5                     PUSH   DE   
0963   F1                     POP   AF   ; Flags = 0xFF
0964   35                     DEC   (HL)   ; Execute Opcode: 0x00 - 1 = 0xFF.
0965   F5                     PUSH   AF   
0966   D1                     POP   DE   ; E = New Flags
0967                          ; Verify Result
0967   7E                     LD   A,(HL)   
0968   FE FF                  CP   0xFF   
096A   C2 0C 00               JP   NZ,ERROR   
