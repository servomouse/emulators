0482                TEST_INC_IX_D:   
0482   DD 21 00 FF            LD   IX,TEST_RAM   ; Point IX to base RAM address
0486                          ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
0486   3E 01                  LD   A,0x01   
0488   32 05 FF               LD   (IX_ABS_ADDR),A   ; Write 0x01 directly to 0x8005
048B   11 FF 00               LD   DE,0x00FF   ; E = Initial Flags (0xFF, testing N flag clearing)
048E   D5                     PUSH   DE   
048F   F1                     POP   AF   
0490   DD 34 05               INC   (IX+0x05)   ; Target address should calculate to 0x8005
0493   F5                     PUSH   AF   
0494   D1                     POP   DE   ; E = New Flags
0495                          ; Verify Result via absolute address
0495   3A 05 FF               LD   A,(IX_ABS_ADDR)   
0498   FE 02                  CP   0x02   
049A   C2 0C 00               JP   NZ,ERROR   
049D                          ; Verify Flags stored in E:
049D   CB 7B                  BIT   7,E   ; S flag (Expected: 0)
049F   C2 0C 00               JP   NZ,ERROR   
04A2   CB 73                  BIT   6,E   ; Z flag (Expected: 0)
04A4   C2 0C 00               JP   NZ,ERROR   
04A7   CB 63                  BIT   4,E   ; H flag (Expected: 0)
04A9   C2 0C 00               JP   NZ,ERROR   
04AC   CB 53                  BIT   2,E   ; V/P flag (Expected: 0)
04AE   C2 0C 00               JP   NZ,ERROR   
04B1   CB 4B                  BIT   1,E   ; N flag (Expected: 0, INC ALWAYS clears N)
04B3   C2 0C 00               JP   NZ,ERROR   
04B6   CB 43                  BIT   0,E   ; C flag (Expected: 1, preserves initial 1)
04B8   CA 0C 00               JP   Z,ERROR   
04BB                          ; --- Case 2: Overflow (0x7F -> 0x80) ---
04BB                          ; Tests the specific edge case where a positive signed byte increments to negative
04BB   3E 7F                  LD   A,0x7F   
04BD   32 05 FF               LD   (IX_ABS_ADDR),A   
04C0   11 00 00               LD   DE,0x0000   ; E = Initial Flags (0x00)
04C3   D5                     PUSH   DE   
04C4   F1                     POP   AF   
04C5   DD 34 05               INC   (IX+0x05)   
04C8   F5                     PUSH   AF   
04C9   D1                     POP   DE   
04CA   3A 05 FF               LD   A,(IX_ABS_ADDR)   
04CD   FE 80                  CP   0x80   
04CF   C2 0C 00               JP   NZ,ERROR   
04D2   CB 7B                  BIT   7,E   ; S flag (Expected: 1, 0x80 is negative)
04D4   CA 0C 00               JP   Z,ERROR   
04D7   CB 73                  BIT   6,E   ; Z flag (Expected: 0)
04D9   C2 0C 00               JP   NZ,ERROR   
04DC   CB 63                  BIT   4,E   ; H flag (Expected: 1, 0x7F to 0x80 carries from bit 3)
04DE   CA 0C 00               JP   Z,ERROR   
04E1   CB 53                  BIT   2,E   ; V/P flag (Expected: 1, OVERFLOW!)
04E3   CA 0C 00               JP   Z,ERROR   
04E6   CB 4B                  BIT   1,E   ; N flag (Expected: 0)
04E8   C2 0C 00               JP   NZ,ERROR   
04EB   CB 43                  BIT   0,E   ; C flag (Expected: 0, preserves initial 0)
04ED   C2 0C 00               JP   NZ,ERROR   
04F0                          ; --- Case 3: Zero Wrap (0xFF -> 0x00) ---
04F0   3E FF                  LD   A,0xFF   
04F2   32 05 FF               LD   (IX_ABS_ADDR),A   
04F5   11 FF 00               LD   DE,0x00FF   ; E = Initial Flags (0xFF)
04F8   D5                     PUSH   DE   
04F9   F1                     POP   AF   
04FA   DD 34 05               INC   (IX+0x05)   
04FD   F5                     PUSH   AF   
04FE   D1                     POP   DE   
04FF   3A 05 FF               LD   A,(IX_ABS_ADDR)   
0502   FE 00                  CP   0x00   
0504   C2 0C 00               JP   NZ,ERROR   
0507   CB 7B                  BIT   7,E   ; S flag (Expected: 0)
0509   C2 0C 00               JP   NZ,ERROR   
050C   CB 73                  BIT   6,E   ; Z flag (Expected: 1, result is zero)
050E   CA 0C 00               JP   Z,ERROR   
0511   CB 63                  BIT   4,E   ; H flag (Expected: 1, 0xFF to 0x00 carries from bit 3)
0513   CA 0C 00               JP   Z,ERROR   
0516   CB 53                  BIT   2,E   ; V/P flag (Expected: 0, wrapping to 0 is not signed overflow)
0518   C2 0C 00               JP   NZ,ERROR   
051B   CB 4B                  BIT   1,E   ; N flag (Expected: 0)
051D   C2 0C 00               JP   NZ,ERROR   
0520   CB 43                  BIT   0,E   ; C flag (Expected: 1, preserves initial 1)
0522   CA 0C 00               JP   Z,ERROR   
0525   C9                     RET   
