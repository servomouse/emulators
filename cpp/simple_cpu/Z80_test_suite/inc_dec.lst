09BE   3E 01                  LD   A,0x01   
09C0   32 05 FF               LD   (IX_ABS_ADDR),A   ; Write 0x01 directly to 0x8005
09C3   11 00 00               LD   DE,0x0000   ; E = Initial Flags (0x00)
09C6   D5                     PUSH   DE   
09C7   F1                     POP   AF   
09C8   DD 35 05               DEC   (IX+0x05)   ; Target address should calculate to 0x8005
09CB   F5                     PUSH   AF   
09CC   D1                     POP   DE   ; E = New Flags
09CD                          ; Verify Result via absolute address
09CD   3A 05 FF               LD   A,(IX_ABS_ADDR)   ; Read back directly from 0x8005
09D0   FE 00                  CP   0x00   
09D2   C2 0C 00               JP   NZ,ERROR   
09D5   CB 7B                  BIT   7,E   ; S flag (0)
09D7   C2 0C 00               JP   NZ,ERROR   
09DA   CB 73                  BIT   6,E   ; Z flag (1)
09DC   CA 0C 00               JP   Z,ERROR   
09DF   CB 63                  BIT   4,E   ; H flag (0)
09E1   C2 0C 00               JP   NZ,ERROR   
09E4   CB 53                  BIT   2,E   ; V/P flag (0)
09E6   C2 0C 00               JP   NZ,ERROR   
09E9   CB 4B                  BIT   1,E   ; N flag (1)
09EB   CA 0C 00               JP   Z,ERROR   
09EE   CB 43                  BIT   0,E   ; C flag (0)
09F0   C2 0C 00               JP   NZ,ERROR   
