1011   11 00 00               LD   DE,0x0000   ; E = 0x00 (Initial flags set to 0)
1014   D5                     PUSH   DE   
1015   F1                     POP   AF   ; Flags = 0x00
1016   0B                     DEC   BC   ; Execute Opcode: BC becomes 0x00FF.
1017   F5                     PUSH   AF   
1018   D1                     POP   DE   ; E = New Flags
1019                          ; Verify Result
1019   78                     LD   A,B   
101A   FE 00                  CP   0x00   
101C   C2 0C 00               JP   NZ,ERROR   
101F   79                     LD   A,C   
1020   FE FF                  CP   0xFF   
1022   C2 0C 00               JP   NZ,ERROR   
1025                          ; Verify Flags (Expected: all documented flags should remain 0)
1025   CB 7B                  BIT   7,E   ; S flag
1027   C2 0C 00               JP   NZ,ERROR   
102A   CB 73                  BIT   6,E   ; Z flag
