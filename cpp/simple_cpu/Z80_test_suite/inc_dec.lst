0A3A   FE 7F                  CP   0x7F   
0A3C   C2 0C 00               JP   NZ,ERROR   
0A3F   CB 7B                  BIT   7,E   ; S flag (0)
0A41   C2 0C 00               JP   NZ,ERROR   
0A44   CB 73                  BIT   6,E   ; Z flag (0)
0A46   C2 0C 00               JP   NZ,ERROR   
0A49   CB 63                  BIT   4,E   ; H flag (1)
0A4B   CA 0C 00               JP   Z,ERROR   
