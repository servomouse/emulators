05F3   D1                     POP   DE   ; Pop into DE. E = New Flags
05F4                          ; Verify Result
05F4   78                     LD   A,B   ; Move result into A for comparison
05F5   FE 00                  CP   0x00   ; Compare with 0x00
05F7   C2 0C 00               JP   NZ,ERROR   ; Error if result is not 0x00
05FA                          ; Verify Flags stored in E:
05FA   CB 7B                  BIT   7,E   ; S flag (Expected: 0)
05FC   C2 0C 00               JP   NZ,ERROR   
05FF   CB 73                  BIT   6,E   ; Z flag (Expected: 1)
0601   CA 0C 00               JP   Z,ERROR   
0604   CB 63                  BIT   4,E   ; H flag (Expected: 0)
0606   C2 0C 00               JP   NZ,ERROR   
0609   CB 53                  BIT   2,E   ; V/P flag (Expected: 0)
060B   C2 0C 00               JP   NZ,ERROR   
060E   CB 4B                  BIT   1,E   ; N flag (Expected: 1)
0610   CA 0C 00               JP   Z,ERROR   
0613   CB 43                  BIT   0,E   ; C flag (Expected: 0)
0615   C2 0C 00               JP   NZ,ERROR   
0618                          ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
0618   06 00                  LD   B,0x00   ; Initial value for B
061A   11 FF 00               LD   DE,0x00FF   ; E = Initial Flags (0xFF, sets all flags including Carry)
061D   D5                     PUSH   DE   
061E   F1                     POP   AF   ; Flags = 0xFF
