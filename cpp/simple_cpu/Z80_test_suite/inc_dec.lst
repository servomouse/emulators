0A3F                          ; Decrement opcodes:
0A3F                TEST_DEC_A:   
0A3F                          ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
0A3F                          ; Tests basic subtraction, the Zero flag, and the N flag.
0A3F   11 00 01               LD   DE,0x0100   ; D = Initial A value (0x01), E = Initial Flags (0x00)
0A42   D5                     PUSH   DE   ; Push DE onto the stack
0A43   F1                     POP   AF   ; Pop into AF. Now Accumulator (A) = 0x01, Flags (F) = 0x00
0A44   3D                     DEC   A   ; Execute Opcode: A = A - 1. A becomes 0x00.
0A45   F5                     PUSH   AF   ; Push the result and the newly generated flags to the stack
0A46   D1                     POP   DE   ; Pop into DE. D = Result (0x00), E = New Flags
0A47                          ; Verify Result
0A47   FE 00                  CP   0x00   ; Compare Accumulator with 0x00 (Subtracts 0x00 from A, updates flags, discards result)
0A49   C2 0C 00               JP   NZ,ERROR   ; If A was not 0x00, the Zero flag won't be set. Jump to ERROR.
0A4C                          ; Verify Flags stored in E:
0A4C   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 0 (0x00 is not negative)
0A4E   C2 0C 00               JP   NZ,ERROR   ; Error if bit 7 was 1
0A51   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 1 (Result of DEC was zero)
0A53   CA 0C 00               JP   Z,ERROR   ; Error if bit 6 was 0
0A56   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 0 (No borrow from bit 4 occurred: 0x1 -> 0x0)
0A58   C2 0C 00               JP   NZ,ERROR   ; Error if bit 4 was 1
0A5B   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 0 (No signed overflow occurred)
0A5D   C2 0C 00               JP   NZ,ERROR   ; Error if bit 2 was 1
0A60   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC operations)
0A62   CA 0C 00               JP   Z,ERROR   ; Error if bit 1 was 0
0A65   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 0 (DEC never affects the Carry flag, should remain 0)
0A67   C2 0C 00               JP   NZ,ERROR   ; Error if bit 0 was 1
0A6A                          ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
0A6A                          ; Tests underflow wrapping, the Half-Carry flag, and ensuring Carry is preserved.
0A6A   11 FF 00               LD   DE,0x00FF   ; D = Initial A (0x00), E = Initial Flags (0xFF, sets all flags including Carry)
0A6D   D5                     PUSH   DE   
0A6E   F1                     POP   AF   ; A = 0x00, Flags = 0xFF
0A6F   3D                     DEC   A   ; Execute Opcode: 0x00 - 1 = 0xFF.
0A70   F5                     PUSH   AF   
0A71   D1                     POP   DE   ; Save results. D = Result (0xFF), E = New Flags
0A72                          ; Verify Result
0A72   FE FF                  CP   0xFF   ; Compare A with 0xFF
0A74   C2 0C 00               JP   NZ,ERROR   ; Error if A did not correctly wrap around to 0xFF
0A77                          ; Verify Flags stored in E:
0A77   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 1 (0xFF has bit 7 set, treating it as negative)
0A79   CA 0C 00               JP   Z,ERROR   ; Error if bit 7 was 0
0A7C   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 0 (Result 0xFF is not zero)
0A7E   C2 0C 00               JP   NZ,ERROR   ; Error if bit 6 was 1
0A81   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow from bit 4)
0A83   CA 0C 00               JP   Z,ERROR   ; Error if bit 4 was 0
0A86   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 0 (Wrapping 0x00 to 0xFF is not a signed overflow)
0A88   C2 0C 00               JP   NZ,ERROR   ; Error if bit 2 was 1
0A8B   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
0A8D   CA 0C 00               JP   Z,ERROR   ; Error if bit 1 was 0
0A90   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 1 (DEC does not affect Carry; should preserve initial 1)
0A92   CA 0C 00               JP   Z,ERROR   ; Error if bit 0 was 0
