1043   01 00 00               LD   BC,0x0000   
1046   11 55 00               LD   DE,0x0055   ; E = 0x55 (Alternating: 01010101)
1049   D5                     PUSH   DE   
104A   F1                     POP   AF   ; Flags = 0x55
104B   0B                     DEC   BC   ; Execute Opcode: BC wraps around to 0xFFFF.
104C   F5                     PUSH   AF   
104D   D1                     POP   DE   ; E = New Flags
104E                          ; Verify Result
104E   78                     LD   A,B   
104F   FE FF                  CP   0xFF   
