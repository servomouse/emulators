0A1B   C2 0C 00               JP   NZ,ERROR   
0A1E   CB 4B                  BIT   1,E   ; N flag (1)
0A20   CA 0C 00               JP   Z,ERROR   
0A23   CB 43                  BIT   0,E   ; C flag (1)
0A25   CA 0C 00               JP   Z,ERROR   
