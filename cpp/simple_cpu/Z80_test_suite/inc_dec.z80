TEST_INC_H:
    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD BC, 0x0200   ; B = expected result (02), C = flags to load (00)
    LD H, 0x01
    PUSH BC
    POP AF          ; A = 02, Flags = 00

    INC H
    
    PUSH AF
    POP BC          ; C now contains Flags
    
    ; Verify result (A XOR H)
    XOR H
    JP NZ, ERROR

    ; Verify Flags: Z=0, S=0, H=0, V=0, N=0, C=0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Zero (0xFF -> 0x00) ---
    LD BC, 0x00FF   ; B = expected result (00), C = flags to load (FF)
    LD H, 0xFF
    PUSH BC
    POP AF

    INC H           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR H
    JP NZ, ERROR
    
    ; Verify Flags: Z=1, S=0, H=1, V=0, N=0, C stays 1
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; --- Case 3: Overflow (0x7F -> 0x80) ---
    LD BC, 0x8000   ; B = expected result (80), C = flags to load (00)
    LD H, 0x7F
    PUSH BC
    POP AF

    INC H           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR H
    JP NZ, ERROR
    
    ; Verify Flags: Z=0, S=1, H=1, V=1, N=0, C stays 0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    RET

TEST_INC_L:
    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD BC, 0x0200   ; B = expected result (02), C = flags to load (00)
    LD L, 0x01
    PUSH BC
    POP AF          ; A = 02, Flags = 00

    INC L
    
    PUSH AF
    POP BC          ; C now contains Flags
    
    ; Verify result (A XOR H)
    XOR L
    JP NZ, ERROR

    ; Verify Flags: Z=0, S=0, H=0, V=0, N=0, C=0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Zero (0xFF -> 0x00) ---
    LD BC, 0x00FF   ; B = expected result (00), C = flags to load (FF)
    LD L, 0xFF
    PUSH BC
    POP AF

    INC L           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR L
    JP NZ, ERROR
    
    ; Verify Flags: Z=1, S=0, H=1, V=0, N=0, C stays 1
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; --- Case 3: Overflow (0x7F -> 0x80) ---
    LD BC, 0x8000   ; B = expected result (80), C = flags to load (00)
    LD L, 0x7F
    PUSH BC
    POP AF

    INC L           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR L
    JP NZ, ERROR
    
    ; Verify Flags: Z=0, S=1, H=1, V=1, N=0, C stays 0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    RET

TEST_INC_MEM_HL:
    ; Setup: Point HL to a safe scratchpad RAM location
    ; For this example, let's assume 0xC000 is safe.
    LD HL, 0xC000

    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD (HL), 0x01
    LD BC, 0x0200   ; B = expected result (02), C = flags to load (00)
    PUSH BC
    POP AF          ; Flags cleared

    INC (HL)
    
    PUSH AF
    POP DE          ; E now contains Flags
    
    ; Verify memory result
    LD A, (HL)
    XOR B            ; Compare (HL) with 0x02
    JP NZ, ERROR

    ; Verify Flags: Z=0, S=0, H=0, V=0, N=0, C=0
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Zero (0xFF -> 0x00) ---
    LD (HL), 0xFF
    LD BC, 0x00FF   ; B = expected result (00), C = flags to load (FF)
    PUSH BC
    POP AF

    INC (HL)
    
    PUSH AF
    POP DE          ; E contains Flags
    
    ; Verify memory result
    LD A, (HL)
    XOR B
    JP NZ, ERROR
    
    ; Verify Flags: Z=1, S=0, H=1, V=0, N=0, C stays 1
    BIT 6, E        ; Z flag
    JP Z, ERROR     ; Must be set
    BIT 4, E        ; H flag
    JP Z, ERROR     ; Must be set
    BIT 2, E        ; V flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR     ; Must stay set

    ; --- Case 3: Overflow (0x7F -> 0x80) ---
    LD (HL), 0x7F
    LD BC, 0x8000   ; B = expected result (80), C = flags to load (00)
    PUSH BC
    POP AF

    INC (HL)
    
    PUSH AF
    POP DE          ; E contains Flags
    
    ; Verify memory result
    LD A, (HL)
    XOR B
    JP NZ, ERROR
    
    ; Verify Flags: Z=0, S=1, H=1, V=1, N=0, C stays 0
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR

    RET

TEST_INC_BC:
    ; --- Case 1: Basic Increment and Flag Preservation ---
    LD BC, 0x0000
    
    ; Set a known flag state
    LD HL, 0x0000
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x00
    XOR B
    JP NZ, ERROR
    LD A, 0x01
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all cleared

    BIT 6, L        ; Z flag
    JP NZ, ERROR
    BIT 7, L        ; S flag
    JP NZ, ERROR
    BIT 4, L        ; H flag
    JP NZ, ERROR
    BIT 2, L        ; V/P flag
    JP NZ, ERROR
    BIT 1, L        ; N flag
    JP NZ, ERROR
    BIT 0, L        ; C flag
    JP NZ, ERROR

    ; --- Case 2: Basic Increment and Flag Preservation ---
    LD BC, 0x1234
    
    ; Set a known flag state
    LD HL, 0x00FF
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x12
    XOR B
    JP NZ, ERROR
    LD A, 0x35
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all set

    BIT 6, L        ; Z flag
    JP Z, ERROR
    BIT 7, L        ; S flag
    JP Z, ERROR
    BIT 4, L        ; H flag
    JP Z, ERROR
    BIT 2, L        ; V/P flag
    JP Z, ERROR
    BIT 1, L        ; N flag
    JP Z, ERROR
    BIT 0, L        ; C flag
    JP Z, ERROR

    ; --- Case 3: LSB overflow and Flag Preservation ---
    LD BC, 0x12FF
    
    ; Set a known flag state
    LD HL, 0x00FF
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x13
    XOR B
    JP NZ, ERROR
    LD A, 0x00
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all set

    BIT 6, L        ; Z flag
    JP Z, ERROR
    BIT 7, L        ; S flag
    JP Z, ERROR
    BIT 4, L        ; H flag
    JP Z, ERROR
    BIT 2, L        ; V/P flag
    JP Z, ERROR
    BIT 1, L        ; N flag
    JP Z, ERROR
    BIT 0, L        ; C flag
    JP Z, ERROR

    ; --- Case 4: Sign overflow and Flag Preservation ---
    LD BC, 0x7FFF
    
    ; Set a known flag state
    LD HL, 0x0000
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x80
    XOR B
    JP NZ, ERROR
    LD A, 0x00
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all cleared

    BIT 6, L        ; Z flag
    JP NZ, ERROR
    BIT 7, L        ; S flag
    JP NZ, ERROR
    BIT 4, L        ; H flag
    JP NZ, ERROR
    BIT 2, L        ; V/P flag
    JP NZ, ERROR
    BIT 1, L        ; N flag
    JP NZ, ERROR
    BIT 0, L        ; C flag
    JP NZ, ERROR

    ; --- Case 5: Full overflow and Flag Preservation ---
    LD BC, 0xFFFF
    
    ; Set a known flag state
    LD HL, 0x00FF
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x00
    XOR B
    JP NZ, ERROR
    LD A, 0x00
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all set

    BIT 6, L        ; Z flag
    JP Z, ERROR
    BIT 7, L        ; S flag
    JP Z, ERROR
    BIT 4, L        ; H flag
    JP Z, ERROR
    BIT 2, L        ; V/P flag
    JP Z, ERROR
    BIT 1, L        ; N flag
    JP Z, ERROR
    BIT 0, L        ; C flag
    JP Z, ERROR

    RET

TEST_DEC_A:
    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    ; Tests basic subtraction, the Zero flag, and the N flag.
    
    LD DE, 0x0100   ; D = Initial A value (0x01), E = Initial Flags (0x00)
    PUSH DE         ; Push DE onto the stack
    POP AF          ; Pop into AF. Now Accumulator (A) = 0x01, Flags (F) = 0x00

    DEC A           ; Execute Opcode: A = A - 1. A becomes 0x00.
    
    PUSH AF         ; Push the result and the newly generated flags to the stack
    POP DE          ; Pop into DE. D = Result (0x00), E = New Flags

    ; Verify Result
    CP 0x00         ; Compare Accumulator with 0x00 (Subtracts 0x00 from A, updates flags, discards result)
    JP NZ, ERROR    ; If A was not 0x00, the Zero flag won't be set. Jump to ERROR.

    ; Verify Flags stored in E:
    BIT 7, E        ; Check S (Sign) flag. Expected: 0 (0x00 is not negative)
    JP NZ, ERROR    ; Error if bit 7 was 1
    
    BIT 6, E        ; Check Z (Zero) flag. Expected: 1 (Result of DEC was zero)
    JP Z, ERROR     ; Error if bit 6 was 0
    
    BIT 4, E        ; Check H (Half-Carry) flag. Expected: 0 (No borrow from bit 4 occurred: 0x1 -> 0x0)
    JP NZ, ERROR    ; Error if bit 4 was 1
    
    BIT 2, E        ; Check P/V (Parity/Overflow) flag. Expected: 0 (No signed overflow occurred)
    JP NZ, ERROR    ; Error if bit 2 was 1
    
    BIT 1, E        ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC operations)
    JP Z, ERROR     ; Error if bit 1 was 0
    
    BIT 0, E        ; Check C (Carry) flag. Expected: 0 (DEC never affects the Carry flag, should remain 0)
    JP NZ, ERROR    ; Error if bit 0 was 1


    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    ; Tests underflow wrapping, the Half-Carry flag, and ensuring Carry is preserved.
    
    LD DE, 0x00FF   ; D = Initial A (0x00), E = Initial Flags (0xFF, sets all flags including Carry)
    PUSH DE
    POP AF          ; A = 0x00, Flags = 0xFF

    DEC A           ; Execute Opcode: 0x00 - 1 = 0xFF. 
    
    PUSH AF         
    POP DE          ; Save results. D = Result (0xFF), E = New Flags

    ; Verify Result
    CP 0xFF         ; Compare A with 0xFF
    JP NZ, ERROR    ; Error if A did not correctly wrap around to 0xFF
    
    ; Verify Flags stored in E:
    BIT 7, E        ; Check S (Sign) flag. Expected: 1 (0xFF has bit 7 set, treating it as negative)
    JP Z, ERROR     ; Error if bit 7 was 0
    
    BIT 6, E        ; Check Z (Zero) flag. Expected: 0 (Result 0xFF is not zero)
    JP NZ, ERROR    ; Error if bit 6 was 1
    
    BIT 4, E        ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow from bit 4)
    JP Z, ERROR     ; Error if bit 4 was 0
    
    BIT 2, E        ; Check P/V (Parity/Overflow) flag. Expected: 0 (Wrapping 0x00 to 0xFF is not a signed overflow)
    JP NZ, ERROR    ; Error if bit 2 was 1
    
    BIT 1, E        ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
    JP Z, ERROR     ; Error if bit 1 was 0
    
    BIT 0, E        ; Check C (Carry) flag. Expected: 1 (DEC does not affect Carry; should preserve initial 1)
    JP Z, ERROR     ; Error if bit 0 was 0


    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    ; Tests the specific edge case where a negative signed byte decrements into a positive one.
    
    LD DE, 0x8000   ; D = Initial A (0x80 or -128), E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; A = 0x80, Flags = 0x00

    DEC A           ; Execute Opcode: 0x80 (-128) - 1 = 0x7F (+127). This is a signed overflow.
    
    PUSH AF
    POP DE          ; Save results. D = Result (0x7F), E = New Flags

    ; Verify Result
    CP 0x7F         ; Compare A with 0x7F
    JP NZ, ERROR    ; Error if result is not 0x7F
    
    ; Verify Flags stored in E:
    BIT 7, E        ; Check S (Sign) flag. Expected: 0 (0x7F has bit 7 clear, it is positive)
    JP NZ, ERROR    ; Error if bit 7 was 1
    
    BIT 6, E        ; Check Z (Zero) flag. Expected: 0 (Result is not zero)
    JP NZ, ERROR    ; Error if bit 6 was 1
    
    BIT 4, E        ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow)
    JP Z, ERROR     ; Error if bit 4 was 0
    
    BIT 2, E        ; Check P/V (Parity/Overflow) flag. Expected: 1 (Sign changed from neg to pos: OVERFLOW!)
    JP Z, ERROR     ; Error if bit 2 was 0
    
    BIT 1, E        ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
    JP Z, ERROR     ; Error if bit 1 was 0
    
    BIT 0, E        ; Check C (Carry) flag. Expected: 0 (DEC does not affect Carry; preserves initial 0)
    JP NZ, ERROR    ; Error if bit 0 was 1

    RET

TEST_DEC_B:
    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD B, 0x01      ; Initial value for B
    LD DE, 0x0000   ; D = Initial A (don't care), E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC B           ; Execute Opcode: B = B - 1. B becomes 0x00.
    
    PUSH AF         ; Push the newly generated flags to the stack
    POP DE          ; Pop into DE. E = New Flags

    ; Verify Result
    LD A, B         ; Move result into A for comparison
    CP 0x00         ; Compare with 0x00
    JP NZ, ERROR    ; Error if result is not 0x00

    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 1)
    JP Z, ERROR
    BIT 4, E        ; H flag (Expected: 0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD B, 0x00      ; Initial value for B
    LD DE, 0x00FF   ; E = Initial Flags (0xFF, sets all flags including Carry)
    PUSH DE
    POP AF          ; Flags = 0xFF

    DEC B           ; Execute Opcode: 0x00 - 1 = 0xFF. 
    
    PUSH AF         
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, B         ; Move result into A for comparison
    CP 0xFF         ; Compare with 0xFF
    JP NZ, ERROR    ; Error if B did not correctly wrap around to 0xFF
    
    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 1, preserves initial 1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD B, 0x80      ; Initial value for B (-128)
    LD DE, 0x0000   ; E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC B           ; Execute Opcode: 0x80 (-128) - 1 = 0x7F (+127).
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, B         ; Move result into A for comparison
    CP 0x7F         ; Compare with 0x7F
    JP NZ, ERROR    
    
    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 1, OVERFLOW!)
    JP Z, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 0)
    JP NZ, ERROR

    RET

TEST_DEC_C:
    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD C, 0x01      
    LD DE, 0x0000   
    PUSH DE
    POP AF          

    DEC C           
    
    PUSH AF         
    POP DE          

    LD A, C         
    CP 0x00         
    JP NZ, ERROR    

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD C, 0x00      
    LD DE, 0x00FF   
    PUSH DE
    POP AF          

    DEC C           
    
    PUSH AF         
    POP DE          

    LD A, C         
    CP 0xFF         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD C, 0x80      
    LD DE, 0x0000   
    PUSH DE
    POP AF          

    DEC C           
    
    PUSH AF
    POP DE          

    LD A, C         
    CP 0x7F         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    RET

TEST_DEC_D:
    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD D, 0x01      ; Initial value for D
    LD BC, 0x0000   ; B = Initial A (don't care), C = Initial Flags (0x00)
    PUSH BC
    POP AF          ; Flags = 0x00

    DEC D           
    
    PUSH AF         
    POP BC          ; C = New Flags

    LD A, D         
    CP 0x00         
    JP NZ, ERROR    

    ; Verify Flags stored in C:
    BIT 7, C        ; S flag (0)
    JP NZ, ERROR
    BIT 6, C        ; Z flag (1)
    JP Z, ERROR
    BIT 4, C        ; H flag (0)
    JP NZ, ERROR
    BIT 2, C        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, C        ; N flag (1)
    JP Z, ERROR
    BIT 0, C        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
