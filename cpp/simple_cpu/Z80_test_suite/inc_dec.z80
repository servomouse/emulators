    LD BC, 0x00FF   ; C = Initial Flags (0xFF)
    PUSH BC
    POP AF          

    DEC D           
    
    PUSH AF         
    POP BC          

    LD A, D         
    CP 0xFF         
    JP NZ, ERROR    
    
    BIT 7, C        ; S flag (1)
    JP Z, ERROR
    BIT 6, C        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, C        ; H flag (1)
    JP Z, ERROR
    BIT 2, C        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, C        ; N flag (1)
    JP Z, ERROR
    BIT 0, C        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD D, 0x80      
    LD BC, 0x0000   
    PUSH BC
    POP AF          

    DEC D           
    
    PUSH AF
    POP BC          

    LD A, D         
    CP 0x7F         
    JP NZ, ERROR    
    
    BIT 7, C        ; S flag (0)
    JP NZ, ERROR
    BIT 6, C        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, C        ; H flag (1)
    JP Z, ERROR
    BIT 2, C        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, C        ; N flag (1)
    JP Z, ERROR
    BIT 0, C        ; C flag (0)
    JP NZ, ERROR

    RET

