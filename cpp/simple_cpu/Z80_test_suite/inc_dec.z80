TEST_DEC_MEM_HL:
    LD HL, TEST_RAM ; Point HL to our writable memory location

    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD (HL), 0x01   ; Initial memory value
    LD DE, 0x0000   ; E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC (HL)        ; Execute Opcode: (HL) = (HL) - 1. Memory becomes 0x00.
    
    PUSH AF         ; Push the newly generated flags to the stack
    POP DE          ; Pop into DE. E = New Flags

    ; Verify Result
    LD A, (HL)      ; Read the modified memory byte back into A
    CP 0x00         ; Compare with 0x00
    JP NZ, ERROR    ; Error if result is not 0x00

    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 1)
    JP Z, ERROR
    BIT 4, E        ; H flag (Expected: 0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD (HL), 0x00   ; Initial memory value
    LD DE, 0x00FF   ; E = Initial Flags (0xFF)
    PUSH DE
    POP AF          ; Flags = 0xFF

    DEC (HL)        ; Execute Opcode: 0x00 - 1 = 0xFF. 
    
    PUSH AF         
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, (HL)      
    CP 0xFF         
    JP NZ, ERROR    
    
    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 1, preserves initial 1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD (HL), 0x80   ; Initial memory value
    LD DE, 0x0000   ; E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC (HL)        ; Execute Opcode: 0x80 - 1 = 0x7F.
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, (HL)      
    CP 0x7F         
    JP NZ, ERROR    
    
    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 1, OVERFLOW!)
    JP Z, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 0)
    JP NZ, ERROR

    RET

TEST_DEC_IX_D:
    LD IX, TEST_RAM     ; Point IX to base RAM address

    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    ; Setup memory via absolute address to isolate the test to DEC (IX+d)
    LD A, 0x01
    LD (IX_ABS_ADDR), A ; Write 0x01 directly to 0x8005
    
    LD DE, 0x0000       ; E = Initial Flags (0x00)
    PUSH DE
    POP AF              

    DEC (IX+0x05)       ; Target address should calculate to 0x8005
    
    PUSH AF         
    POP DE              ; E = New Flags

    ; Verify Result via absolute address
    LD A, (IX_ABS_ADDR) ; Read back directly from 0x8005
    CP 0x00         
    JP NZ, ERROR    

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD A, 0x00
    LD (IX_ABS_ADDR), A 
    
    LD DE, 0x00FF       
    PUSH DE
    POP AF              

    DEC (IX+0x05)       
    
    PUSH AF         
    POP DE              

    LD A, (IX_ABS_ADDR)     
    CP 0xFF         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD A, 0x80
    LD (IX_ABS_ADDR), A 
    
    LD DE, 0x0000       
    PUSH DE
    POP AF              

    DEC (IX+0x05)       
    
    PUSH AF
    POP DE              

    LD A, (IX_ABS_ADDR)     
    CP 0x7F         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    RET

TEST_DEC_IY_D:
    LD IY, TEST_RAM     ; Point IY to base RAM address (0x8000)

    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD A, 0x01
    LD (IY_ABS_ADDR), A ; Write 0x01 directly to 0x7FFB (0x8000 - 5)
    
    LD DE, 0x0000       ; E = Initial Flags (0x00)
    PUSH DE
    POP AF              

    DEC (IY-5)       ; Target address should calculate to 0x7FFB
    
    PUSH AF         
    POP DE              ; E = New Flags

    ; Verify Result via absolute address
    LD A, (IY_ABS_ADDR) ; Read back directly from 0x7FFB
    CP 0x00         
    JP NZ, ERROR    

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD A, 0x00
    LD (IY_ABS_ADDR), A  
    
    LD DE, 0x00FF       
    PUSH DE
    POP AF              

    DEC (IY-5)       
    
    PUSH AF         
    POP DE              

    LD A, (IY_ABS_ADDR)     
    CP 0xFF         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD A, 0x80
    LD (IY_ABS_ADDR), A 
    
    LD DE, 0x0000       
    PUSH DE
    POP AF              

    DEC (IY-5)       
    
    PUSH AF
    POP DE              

    LD A, (IY_ABS_ADDR)     
    CP 0x7F         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    RET

TEST_DEC_SP:
    ; Save real SP to restore later
    LD HL, 0
    ADD HL, SP
    LD (TEMP_SP_SAVE), HL

    ; --- Case 1: Flag Preservation and Wrap (0x0000 -> 0xFFFF) ---
    LD SP, 0x0000
    LD BC, 0x00FF   ; B = Expected Low byte (FF - checked via SP), C = Flags (FF)
    PUSH BC
    POP AF          ; Load flags with 0xFF

    DEC SP
    
    ; Verify Flags: Must still be 0xFF
    PUSH AF
    POP BC
    LD A, C
    XOR 0xFF
    JP NZ, ERROR

    ; Verify Result: SP should be 0xFFFF
    LD HL, 0
    ADD HL, SP      ; HL now equals SP
    LD A, H
    XOR 0xFF
    JP NZ, ERROR
    LD A, L
    XOR 0xFF
    JP NZ, ERROR

    ; Restore original SP
    LD HL, (TEMP_SP_SAVE)
    LD SP, HL
    RET
