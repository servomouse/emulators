00C1   C9                     RET   
00C2                TEST_RLA:   
00C2                          ; =========================================================
00C2                          ; CASE 1: 0x55 with Carry=1 -> 0xAB (Bit 7 is 0 -> New Carry=0)
00C2                          ; PRE-CONDITION: Set Sign, Zero, Overflow, and Carry (0xC5)
00C2                          ; Expected Result: 0xAB, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
