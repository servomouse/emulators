0011   76                     HALT   
0012   18 FC                  JR   ERROR   
0014                TEST_RLCA:   
0014                          ; =========================================================
0014                          ; CASE 1: 0x55 -> 0xAA (Bit 7 is 0, Carry should be 0)
0014                          ; PRE-CONDITION: Set Sign, Zero, Overflow, and Carry (0xC5) to test preservation
0014                          ; Expected Result: 0xAA, Flags: S=1, Z=1, V=1, H=0, N=0, C=0 (C is cleared)
0014                          ; =========================================================
0014   01 C5 55               LD   BC,0x55C5   ; C = Initial Flags (11000101b)
0017   C5                     PUSH   BC   
0018   F1                     POP   AF   ; Load A and Flags
0019   07                     RLCA   ; Covers 0x07
001A   F5                     PUSH   AF   
001B   C1                     POP   BC   ; C = Resulting Flags
001C                          ; Verify Result (0xAA)
001C   EE AA                  XOR   0xAA   
001E   C2 10 00               JP   NZ,ERROR   
0021                          ; Verify Flags: S, Z, V preserved (1). H, N, C must be 0.
0021   CB 79                  BIT   7,C   ; S flag
0023   CA 10 00               JP   Z,ERROR   
0026   CB 71                  BIT   6,C   ; Z flag
0028   CA 10 00               JP   Z,ERROR   
002B   CB 61                  BIT   4,C   ; H flag
002D   C2 10 00               JP   NZ,ERROR   
0030   CB 51                  BIT   2,C   ; V/P flag
0032   CA 10 00               JP   Z,ERROR   
0035   CB 49                  BIT   1,C   ; N flag
0037   C2 10 00               JP   NZ,ERROR   
003A   CB 41                  BIT   0,C   ; C flag (Should be cleared because bit 7 of 0x55 was 0)
003C   C2 10 00               JP   NZ,ERROR   
003F                          ; =========================================================
003F                          ; CASE 2: 0xAA -> 0x55 (Bit 7 is 1, Carry should be 1)
003F                          ; PRE-CONDITION: Clear all flags (0x00)
003F                          ; Expected Result: 0x55, Flags: S=0, Z=0, V=0, H=0, N=0, C=1 (C is set)
003F                          ; =========================================================
003F   01 00 AA               LD   BC,0xAA00   ; Clear all flags
0042   C5                     PUSH   BC   
0043   F1                     POP   AF   
0044   07                     RLCA   ; Covers 0x07
0045   F5                     PUSH   AF   
0046   C1                     POP   BC   
0047                          ; Verify Result (0x55)
0047   EE 55                  XOR   0x55   
0049   C2 10 00               JP   NZ,ERROR   
004C                          ; Verify Flags: S, Z, V, H, N must be 0. C must be 1.
004C   CB 79                  BIT   7,C   ; S flag
004E   C2 10 00               JP   NZ,ERROR   
0051   CB 71                  BIT   6,C   ; Z flag
0053   C2 10 00               JP   NZ,ERROR   
0056   CB 61                  BIT   4,C   ; H flag
0058   C2 10 00               JP   NZ,ERROR   
005B   CB 51                  BIT   2,C   ; V/P flag
005D   C2 10 00               JP   NZ,ERROR   
0060   CB 49                  BIT   1,C   ; N flag
0062   C2 10 00               JP   NZ,ERROR   
0065   CB 41                  BIT   0,C   ; C flag (Should be set because bit 7 of 0xAA was 1)
0067   CA 10 00               JP   Z,ERROR   
006A   C9                     RET   
006B                TEST_RRCA:   
006B                          ; =========================================================
006B                          ; CASE 1: 0x55 -> 0xAA (Bit 0 is 1, Carry should be 1)
006B                          ; PRE-CONDITION: Clear all flags (0x00)
