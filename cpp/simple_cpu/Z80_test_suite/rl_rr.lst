00D9   CB 61                  BIT   4,C   ; H flag
00DB   C2 10 00               JP   NZ,ERROR   
00DE   CB 51                  BIT   2,C   ; V/P flag
00E0   CA 10 00               JP   Z,ERROR   
00E3   CB 49                  BIT   1,C   ; N flag
00E5   C2 10 00               JP   NZ,ERROR   
00E8   CB 41                  BIT   0,C   ; C flag (Bit 7 of 0x55 was 0, so Carry clears)
00EA   C2 10 00               JP   NZ,ERROR   
00ED                          ; =========================================================
00ED                          ; CASE 2: 0xAA with Carry=0 -> 0x54 (Bit 7 is 1 -> New Carry=1)
00ED                          ; PRE-CONDITION: Clear all flags (0x00)
00ED                          ; Expected Result: 0x54, Flags: S=0, Z=0, V=0, H=0, N=0, C=1
00ED                          ; =========================================================
00ED   01 00 AA               LD   BC,0xAA00   ; B = Initial A (0xAA), C = Initial Flags (Carry is 0)
00F0   C5                     PUSH   BC   
00F1   F1                     POP   AF   
00F2   17                     RLA   ; Covers 0x17
00F3   F5                     PUSH   AF   
00F4   C1                     POP   BC   
00F5                          ; Verify Result (0x54)
00F5   EE 54                  XOR   0x54   
00F7   C2 10 00               JP   NZ,ERROR   
00FA                          ; Verify Flags: S, Z, V, H, N must be 0. C must be 1.
00FA   CB 79                  BIT   7,C   ; S flag
00FC   C2 10 00               JP   NZ,ERROR   
00FF   CB 71                  BIT   6,C   ; Z flag
0101   C2 10 00               JP   NZ,ERROR   
0104   CB 61                  BIT   4,C   ; H flag
0106   C2 10 00               JP   NZ,ERROR   
0109   CB 51                  BIT   2,C   ; V/P flag
010B   C2 10 00               JP   NZ,ERROR   
