    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (0 - +127 + -127 = 0, no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x34 = 0x46 ---
    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    LD A, 0x12
    LD H, 0x34
    ADD A, H

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
    RET

TEST_ADD_A_L:
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    LD A, 0x7F
    LD L, 0x7E
    ADD A, L

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
