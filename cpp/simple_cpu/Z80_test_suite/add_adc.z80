    LD (TEMP_SP_SAVE), SP 
    LD IY, 0x1234
    LD HL, 0x00C4   
    PUSH HL
    POP AF              
    LD SP, 0x1235       
    
    ADD IY, SP          
    
    LD (SP_RESULT_ADDR), IY 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x69
    JP NZ, ERROR

    BIT 7, E        ; S (1)
    JP Z, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (1)
    JP Z, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    LD (TEMP_SP_SAVE), SP 
    LD IY, 0xFFFF
    LD HL, 0x0080   
    PUSH HL
    POP AF              
    LD SP, 0x0001       
    
    ADD IY, SP          
    
    LD (SP_RESULT_ADDR), IY 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (1)
    JP Z, ERROR
    BIT 6, E        ; Z (0)
    JP NZ, ERROR
    BIT 4, E        ; H (1)
    JP Z, ERROR
    BIT 2, E        ; P/V (0)
    JP NZ, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (1)
    JP Z, ERROR

    RET

TEST_ADD_IY_IY:
    ; --- Case 1: 0x0900 + 0x0900 = 0x1200 ---
    LD IY, 0x0900
    LD HL, 0x0040   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x12
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x9000 = 0x2000 ---
    LD IY, 0x9000
    LD HL, 0x0044   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x20
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1234 = 0x2468 ---
    LD IY, 0x1234
    LD HL, 0x00C4   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x68
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0xFFFF = 0xFFFE ---
    LD IY, 0xFFFF
    LD HL, 0x0080   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0xFF
    JP NZ, ERROR
    LD A, L
    CP 0xFE
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    RET

TEST_ADD_HL_BC: ; Covers ADD HL, BC
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD BC, 0x0204
    LD DE, 0x00FF   ; D=0, E=Initial Flags
    PUSH DE
    POP AF          ; Load Flags

    ADD HL, BC

    PUSH AF
    POP DE          ; E = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 6, E        ; Z flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V/P flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_DE: ; Covers ADD HL, DE
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD DE, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, DE

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD DE, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, DE

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD DE, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, DE

    PUSH AF
    POP BC

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_HL: ; Covers ADD HL, HL
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1234 + 0x1234)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1224, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1234
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, HL

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1224)
    LD A, H
    XOR 0x24
    JP NZ, ERROR
    LD A, L
    XOR 0x68
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800   ; 0x0800 + 0x0800 = 0x1000
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, HL

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0x8800 + 0x8800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0x8800   ; Bit 11 and Bit 15 will both carry when doubled!
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, HL

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_SP: ; Covers ADD HL, SP
    ; Save real SP
    LD (TEMP_SP_SAVE), SP

    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD SP, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, SP

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=1, Z=1, H=0, V=1, N=0, C=0
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD SP, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, SP

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=0, Z=0, H=1, V=0, N=0, C=0
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD SP, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, SP

    PUSH AF
    POP BC

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=0, Z=0, H=1, V=0, N=0, C=1
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; Restore original SP
    LD SP, (TEMP_SP_SAVE)
    RET

; 8-bit ADC opcodes:
TEST_ADC_A_B:
    ; --- Case 1: 0x7F + 0x02 + C(1) = 0x82 ---
    LD A, 0x7F
    LD B, 0x02
    SCF             ; Set Carry flag
    ADC A, B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x82
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (carry from bit 3)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (addition)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (no carry from MSB)
    JP NZ, ERROR

    ; --- Case 2: 0xFC + 0x03 + C(1) = 0x00 ---
    LD A, 0xFC
    LD B, 0x03
    SCF             ; Set Carry flag
    ADC A, B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        ; S should be cleared (result is positive/zero)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be set (carry from bit 3)
    JP Z, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared (addition)
    JP NZ, ERROR
    BIT 0, E        ; C should be set (carry from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x34 + C(1) = 0x47 ---
    LD A, 0x12
    LD B, 0x34
    SCF             ; Set Carry flag
    ADC A, B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x47
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_ADC_A_C:
    ; --- Case 1: 0x7F + 0x02 + C(1) = 0x82 ---
