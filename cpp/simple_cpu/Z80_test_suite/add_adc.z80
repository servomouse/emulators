    ADD A, H

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0xFD
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: +127 + +126 wraps negative)
    JP Z, ERROR
