    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: +127 + +126 wraps negative)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
