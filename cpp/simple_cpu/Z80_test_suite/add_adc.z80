    LD A, 0x12
    LD L, 0x34
    ADD A, L

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
