TEST_ADC_A_IX_D:
    ; Ensure IX points to our scratchpad memory
    LD IX, TEST_RAM 

    ; --- Case 1: 0x7F + 0x02 + C(1) = 0x82 ---
    LD (IX+0x05), 0x02  ; Load operand at displacement +5
    LD A, 0x7F
    SCF                 ; Set Carry flag
    ADC A, (IX+0x05)

    PUSH AF
    POP DE              ; E = Flags

    ; Verify Result
    CP 0x82
