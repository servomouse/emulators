TEST_ADD_A_A:
    ; --- Case 1: 0x7F + 0x7F = 0xFE ---
    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    LD A, 0x7F
    ADD A, A

    PUSH AF
    POP DE

    CP 0xFE
    JP NZ, ERROR

    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: 0x80 + 0x80 = 0x00 ---
    ; Expected Flags: S=0, Z=1, H=0, P/V=1, N=0, C=1
    LD A, 0x80
    ADD A, A

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0 - 0x00 + 0x00 = 0x00, no half-carry)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: -128 + -128 wraps to positive 0)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x12 = 0x24 ---
    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    LD A, 0x12
    ADD A, A

    PUSH AF
    POP DE

    CP 0x24
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
    RET

TEST_ADD_A_N:
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    LD A, 0x7F
    ADD A, 0x7E

    PUSH AF
    POP DE

    CP 0xFD
    JP NZ, ERROR

    ; Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    LD A, 0x7F
    ADD A, 0x81

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    RET

TEST_ADD_A_HL:
    LD HL, TEST_RAM   ; Point HL to safe RAM
    
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    LD (HL), 0x7E
    LD A, 0x7F
    ADD A, (HL)

    PUSH AF
    POP DE

    CP 0xFD
    JP NZ, ERROR

    ; Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    LD (HL), 0x81
    LD A, 0x7F
    ADD A, (HL)

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    RET

TEST_ADD_HL_BC: ; Covers ADD HL, BC
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD BC, 0x0204
    LD DE, 0x00FF   ; D=0, E=Initial Flags
    PUSH DE
    POP AF          ; Load Flags

    ADD HL, BC

    PUSH AF
    POP DE          ; E = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 6, E        ; Z flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V/P flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_DE: ; Covers ADD HL, DE
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD DE, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, DE

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD DE, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, DE

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD DE, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, DE

    PUSH AF
    POP BC

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_HL: ; Covers ADD HL, HL
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1234 + 0x1234)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1224, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1234
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, HL

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1224)
    LD A, H
    XOR 0x24
    JP NZ, ERROR
    LD A, L
    XOR 0x68
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800   ; 0x0800 + 0x0800 = 0x1000
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, HL

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0x8800 + 0x8800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0x8800   ; Bit 11 and Bit 15 will both carry when doubled!
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, HL

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_SP: ; Covers ADD HL, SP
    ; Save real SP
    LD (TEMP_SP_SAVE), SP

    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD SP, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, SP

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=1, Z=1, H=0, V=1, N=0, C=0
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD SP, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, SP

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=0, Z=0, H=1, V=0, N=0, C=0
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD SP, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, SP

    PUSH AF
    POP BC

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=0, Z=0, H=1, V=0, N=0, C=1
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; Restore original SP
    LD SP, (TEMP_SP_SAVE)
    RET
