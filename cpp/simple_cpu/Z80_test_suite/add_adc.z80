    LD A, 0x7F
    LD L, 0x81
    ADD A, L

    PUSH AF
    POP DE          ; E = Flags

    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (0 - +127 + -127 = 0, no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x34 = 0x46 ---
    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    LD A, 0x12
    LD L, 0x34
    ADD A, L

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
    RET

TEST_ADD_A_IX_D:
    LD IX, TEST_RAM     ; Point IX to base RAM address (0x8000)

    ; --- Case 1: Positive Offset (+0x05) ---
    ; Math: 0x7F + 0x7E = 0xFD
    ; Reads from IX_ABS_ADDR (0x8005)
    LD A, 0x7E
    LD (IX_ABS_ADDR), A 
    
    LD A, 0x7F
    ADD A, (IX+0x05)    ; 0x8000 + 5 = 0x8005

    PUSH AF
    POP DE              

    CP 0xFD
    JP NZ, ERROR

    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: Negative Offset (0xFB = -0x05) ---
    ; Math: 0x7F + 0x81 = 0x00
    ; Reads from IY_ABS_ADDR (0x7FFB)
    LD A, 0x81
    LD (IY_ABS_ADDR), A 
    
    LD A, 0x7F
    ADD A, (IX-5)    ; 0x8000 - 5 = 0x7FFB

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Expected Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    ; --- Case 3: Positive Offset (+0x05) ---
    ; Math: 0x12 + 0x34 = 0x46
    ; Reads from IX_ABS_ADDR (0x8005)
    LD A, 0x34
    LD (IX_ABS_ADDR), A 
    
    LD A, 0x12
    ADD A, (IX+0x05)    ; 0x8000 + 5 = 0x8005

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP NZ, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    RET

TEST_ADD_A_IY_D:
    LD IY, TEST_RAM     ; Point IY to base RAM address (0x8000)

    ; --- Case 1: Negative Offset (0xFB = -0x05) ---
    ; Math: 0x7F + 0x7E = 0xFD
    ; Reads from IY_ABS_ADDR (0x7FFB)
    LD A, 0x7E
    LD (IY_ABS_ADDR), A 
    
    LD A, 0x7F
    ADD A, (IY-5)    ; 0x8000 - 5 = 0x7FFB

    PUSH AF
    POP DE              

    CP 0xFD
    JP NZ, ERROR

    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: Positive Offset (+0x05) ---
    ; Math: 0x7F + 0x81 = 0x00
    ; Reads from IX_ABS_ADDR (0x8005)
    LD A, 0x81
    LD (IX_ABS_ADDR), A 
    
    LD A, 0x7F
    ADD A, (IY+0x05)    ; 0x8000 + 5 = 0x8005

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Expected Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    ; --- Case 3: Negative Offset (0xFB = -0x05) ---
    ; Math: 0x12 + 0x34 = 0x46
    ; Reads from IY_ABS_ADDR (0x7FFB)
    LD A, 0x34
    LD (IY_ABS_ADDR), A 
    
    LD A, 0x12
    ADD A, (IY-5)    ; 0x8000 - 5 = 0x7FFB

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP NZ, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    RET

TEST_ADD_A_A:
    ; --- Case 1: 0x7F + 0x7F = 0xFE ---
    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    LD A, 0x7F
    ADD A, A

    PUSH AF
    POP DE

    CP 0xFE
    JP NZ, ERROR

    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: 0x80 + 0x80 = 0x00 ---
    ; Expected Flags: S=0, Z=1, H=0, P/V=1, N=0, C=1
    LD A, 0x80
    ADD A, A

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0 - 0x00 + 0x00 = 0x00, no half-carry)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: -128 + -128 wraps to positive 0)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x12 = 0x24 ---
    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    LD A, 0x12
    ADD A, A

    PUSH AF
    POP DE

    CP 0x24
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
    RET

TEST_ADD_A_N:
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    LD A, 0x7F
    ADD A, 0x7E

    PUSH AF
    POP DE

    CP 0xFD
    JP NZ, ERROR

    ; Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    LD A, 0x7F
    ADD A, 0x81

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    RET

TEST_ADD_A_HL:
    LD HL, TEST_RAM   ; Point HL to safe RAM
    
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    LD (HL), 0x7E
    LD A, 0x7F
    ADD A, (HL)

    PUSH AF
    POP DE

    CP 0xFD
    JP NZ, ERROR

    ; Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    LD (HL), 0x81
    LD A, 0x7F
    ADD A, (HL)

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    RET

; 16-bit ADD opcodes:
TEST_ADD_IX_BC:
    ; --- Case 1: 0x0900 + 0x0800 = 0x1100 ---
    ; Expected: Sets H, clears C. S, Z, P/V unchanged. N is reset.
    LD IX, 0x0900
    LD BC, 0x0800
    LD HL, 0x0040   ; L = Initial flags (S=0, Z=1, H=0, P/V=0, N=0, C=0)
    PUSH HL
    POP AF

    ADD IX, BC

    PUSH AF
    POP DE          ; E = New flags
    PUSH IX
    POP HL          ; HL = Result

    LD A, H
    CP 0x11
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x8000 = 0x1000 ---
    ; Expected: Clears H, sets C. S, Z, P/V unchanged. N is reset.
    LD IX, 0x9000
    LD BC, 0x8000
    LD HL, 0x0044   ; L = Initial flags (S=0, Z=1, H=0, P/V=1, N=0, C=0)
    PUSH HL
    POP AF

    ADD IX, BC

    PUSH AF
    POP DE          
    PUSH IX
    POP HL          

    LD A, H
    CP 0x10
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1235 = 0x2469 ---
    ; Expected: Clears H, clears C. S, Z, P/V unchanged. N is reset.
    LD IX, 0x1234
    LD BC, 0x1235
    LD HL, 0x00C4   ; L = Initial flags (S=1, Z=1, H=0, P/V=1, N=0, C=0)
    PUSH HL
    POP AF

    ADD IX, BC

    PUSH AF
    POP DE          
    PUSH IX
    POP HL          

    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x69
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    ; Expected: Sets H, sets C. S, Z, P/V unchanged. N is reset.
    LD IX, 0xFFFF
    LD BC, 0x0001
    LD HL, 0x0080   ; L = Initial flags (S=1, Z=0, H=0, P/V=0, N=0, C=0)
    PUSH HL
    POP AF

    ADD IX, BC

    PUSH AF
    POP DE          
    PUSH IX
    POP HL          

    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    RET

