ORG 0000h
    LD SP, 0xF000
    CALL TEST_ADDS
    CALL TEST_ADCS
    HALT

TEMP_SP_SAVE: DW 0x0000

ERROR:
    DI
    HALT
    JR ERROR

TEST_ADDS:
    CALL TEST_ADD_HL_BC
    CALL TEST_ADD_HL_DE
    CALL TEST_ADD_HL_HL
    CALL TEST_ADD_HL_SP
    RET

TEST_ADCS:
    RET

TEST_ADD_HL_BC:
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD BC, 0x0204
    LD DE, 0x00FF   ; D=0, E=Initial Flags
    PUSH DE
    POP AF          ; Load Flags

    ADD HL, BC

    PUSH AF
    POP DE          ; E = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 6, E        ; Z flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V/P flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_DE:
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD DE, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, DE

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD DE, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, DE

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD DE, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, DE

    PUSH AF
    POP BC

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_HL:
    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1234 + 0x1234)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1224, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1234
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, HL

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1224)
    LD A, H
    XOR 0x24
    JP NZ, ERROR
    LD A, L
    XOR 0x68
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800   ; 0x0800 + 0x0800 = 0x1000
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, HL

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0x8800 + 0x8800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0x8800   ; Bit 11 and Bit 15 will both carry when doubled!
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, HL

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_SP:
    ; Save real SP
    LD (TEMP_SP_SAVE), SP

    ; =========================================================
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    ; PRE-CONDITION: Set all flags to test preservation
    ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD HL, 0x1030
    LD SP, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, SP

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=1, Z=1, H=0, V=1, N=0, C=0
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
    ; =========================================================
    LD HL, 0x0800
    LD SP, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, SP

    PUSH AF
    POP BC

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=0, Z=0, H=1, V=0, N=0, C=0
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x0000, Flags: H=1, C=1, N=0
    ; =========================================================
    LD HL, 0xF800
    LD SP, 0x0800
    LD BC, 0x0000
    PUSH BC
    POP AF

    ADD HL, SP

    PUSH AF
    POP BC

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags:
    ; Expected: S=0, Z=0, H=1, V=0, N=0, C=1
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; Restore original SP
    LD SP, (TEMP_SP_SAVE)
    RET
