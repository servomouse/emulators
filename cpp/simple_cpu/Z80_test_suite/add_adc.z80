    PUSH AF
    POP BC          

    ; Verify Result
    CP 0x47
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, C        ; S should be cleared
    JP NZ, ERROR
    BIT 6, C        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, C        ; H should be cleared
    JP NZ, ERROR
    BIT 2, C        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, C        ; N should be cleared
    JP NZ, ERROR
    BIT 0, C        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_ADC_A_E:
    ; --- Case 1: 0x7F + 0x02 + C(1) = 0x82 ---
    LD A, 0x7F
    LD E, 0x02
    SCF             ; Set Carry flag
    ADC A, E

    PUSH AF
    POP BC          ; C = Flags

    ; Verify Result
    CP 0x82
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, C        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, C        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, C        ; H should be set (carry from bit 3)
    JP Z, ERROR
    BIT 2, C        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, C        ; N should be cleared (addition)
    JP NZ, ERROR
    BIT 0, C        ; C should be cleared (no carry from MSB)
    JP NZ, ERROR

    ; --- Case 2: 0xFC + 0x03 + C(1) = 0x00 ---
    LD A, 0xFC
    LD E, 0x03
    SCF             ; Set Carry flag
    ADC A, E

    PUSH AF
    POP BC          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, C        ; S should be cleared (result is positive/zero)
    JP NZ, ERROR
    BIT 6, C        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, C        ; H should be set (carry from bit 3)
    JP Z, ERROR
    BIT 2, C        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, C        ; N should be cleared (addition)
    JP NZ, ERROR
    BIT 0, C        ; C should be set (carry from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x34 + C(1) = 0x47 ---
    LD A, 0x12
    LD E, 0x34
    SCF             ; Set Carry flag
    ADC A, E

    PUSH AF
    POP BC          

    ; Verify Result
    CP 0x47
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, C        ; S should be cleared
    JP NZ, ERROR
    BIT 6, C        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, C        ; H should be cleared
    JP NZ, ERROR
    BIT 2, C        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, C        ; N should be cleared
    JP NZ, ERROR
    BIT 0, C        ; C should be cleared
    JP NZ, ERROR

    RET

