    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: +127 + +126 wraps negative)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    ; Expected Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    LD A, 0x7F
    LD L, 0x81
    ADD A, L

    PUSH AF
    POP DE          ; E = Flags

    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (0 - +127 + -127 = 0, no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
