    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x06)
    JP Z, ERROR
