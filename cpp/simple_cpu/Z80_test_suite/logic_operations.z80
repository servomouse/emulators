TEST_AND_HL:
    ; Setup memory location
    LD HL, TEST_RAM

    ; --- Case 1: 0x5A AND (HL)[0xA5] = 0x00 ---
    LD A, 0xA5
    LD (HL), A
    LD A, 0x5A
    AND (HL)

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0xF0 AND (HL)[0x8A] = 0x80 ---
    LD A, 0x8A
    LD (HL), A
    LD A, 0xF0
    AND (HL)

    PUSH AF
    POP DE          

    CP 0x80
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 3: 0x1E AND (HL)[0xE7] = 0x06 ---
    LD A, 0xE7
    LD (HL), A
    LD A, 0x1E
    AND (HL)

    PUSH AF
    POP DE          

    CP 0x06
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_AND_N:
    ; --- Case 1: 0x5A AND 0xA5 = 0x00 ---
