TEST_XOR_A:
    ; --- Single Case: 0xE7 XOR A = 0x00 ---
    ; XORing a register with itself always returns 0x00
    LD A, 0xE7
    XOR A

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=1, N=0, C=0
    ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 XOR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x00)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

TEST_XOR_IX_D:
    ; --- Case 1: Positive Offset d=0x05 -> Target: TEST_RAM_PLUS_5 (0x5A XOR 0xA5 = 0xFF) ---
    LD HL, TEST_RAM_PLUS_5
    LD (HL), 0xA5
    
    LD IX, TEST_RAM
    LD A, 0x5A
    XOR (IX+5)      ; d = +5

    PUSH AF
    POP DE          

    CP 0xFF
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: Zero Offset d=0x00 -> Target: TEST_RAM (0xE7 XOR 0xE7 = 0x00) ---
    LD HL, TEST_RAM
    LD (HL), 0xE7
    
    LD IX, TEST_RAM
    LD A, 0xE7
    XOR (IX+0)      ; d = 0

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0xE3 XOR 0x77 = 0x94) ---
    LD HL, TEST_RAM_MINUS_5
    LD (HL), 0x77
    
    LD IX, TEST_RAM
    LD A, 0xE3
    XOR (IX-5)      ; d = -5 (translated to 0xFB)

    PUSH AF
    POP DE          

    CP 0x94
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_XOR_IY_D:
    ; --- Case 1: Positive Offset d=0x05 -> Target: TEST_RAM_PLUS_5 (0x5A XOR 0xA5 = 0xFF) ---
