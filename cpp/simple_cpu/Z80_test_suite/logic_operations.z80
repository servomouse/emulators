ORG 0000h
    LD SP, 0xF000
    CALL TEST_ANDS
    CALL TEST_XORS
    CALL TEST_ORS
    CALL TEST_CPS
    HALT

TEMP_SP_SAVE: DW 0x0000
SP_RESULT_ADDR EQU 0xFF02
TEST_RAM EQU 0xFF00
TEST_RAM_PLUS_5  EQU 0xFF05  ; TEST_RAM + 0x05 (Positive offset)
TEST_RAM_MINUS_5 EQU 0xFEFB  ; TEST_RAM - 0x05 (Negative offset: 0xFB)

ERROR:
    DI
    HALT
    JR ERROR

TEST_ANDS:
    CALL TEST_AND_B
    CALL TEST_AND_C
    CALL TEST_AND_D
    CALL TEST_AND_E
    CALL TEST_AND_H
    CALL TEST_AND_L
    CALL TEST_AND_HL
    CALL TEST_AND_N
    CALL TEST_AND_A
    CALL TEST_AND_IX_D
    CALL TEST_AND_IY_D
    RET

TEST_XORS:
    CALL TEST_XOR_B
    CALL TEST_XOR_C
    CALL TEST_XOR_D
    CALL TEST_XOR_E
    CALL TEST_XOR_H
    CALL TEST_XOR_L
    CALL TEST_XOR_HL
    CALL TEST_XOR_N
    CALL TEST_XOR_A
    CALL TEST_XOR_IX_D
    CALL TEST_XOR_IY_D
    RET

TEST_ORS:
    CALL TEST_OR_B
    CALL TEST_OR_C
    CALL TEST_OR_D
    CALL TEST_OR_E
    CALL TEST_OR_H
    CALL TEST_OR_L
    CALL TEST_OR_HL
    CALL TEST_OR_N
    CALL TEST_OR_A
    CALL TEST_OR_IX_D
    CALL TEST_OR_IY_D
    RET

TEST_CPS:
    CALL TEST_CP_B
    CALL TEST_OR_C
    CALL TEST_OR_D
    CALL TEST_OR_E
    CALL TEST_OR_H
    CALL TEST_OR_L
    CALL TEST_CP_HL
    CALL TEST_CP_N
    CALL TEST_CP_A
    CALL TEST_CP_IX_D
    CALL TEST_OR_IY_D
    RET

; AND opcodes:
TEST_AND_B:
    ; --- Case 1: 0x5A AND 0xA5 = 0x00 (Zero, Even Parity, Cleared Sign) ---
    LD A, 0x5A
    LD B, 0xA5
    AND B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
    ; Note: 0x00 has 0 bits set, which is even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x00)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 2: 0xF0 AND 0x8A = 0x80 (Negative, Odd Parity, Non-Zero) ---
    LD A, 0xF0
    LD B, 0x8A
    AND B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x80
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=0, N=0, C=0
    ; Note: 0x80 has 1 bit set, which is odd parity -> P/V = 0
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity for 0x80)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 3: 0x1E AND 0xE7 = 0x06 (Positive, Even Parity, Non-Zero) ---
    LD A, 0x1E
    LD B, 0xE7
    AND B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x06
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=1, P/V=1, N=0, C=0
    ; Note: 0x06 (00000110b) has 2 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x06)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

