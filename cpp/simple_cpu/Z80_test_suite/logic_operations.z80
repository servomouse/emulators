    ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0x80 OR 0x03 = 0x83) ---
    LD HL, TEST_RAM_MINUS_5
    LD (HL), 0x03
    
    LD IY, TEST_RAM
    LD A, 0x80
    OR (IY-5)       ; d = -5 (translated to 0xFB)

    PUSH AF
    POP DE          

    CP 0x83
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

; CP opcodes:
TEST_CP_B:
    ; --- Case 1: 0x3F CP 0x1E = 0x21 internally (S=0, Z=0, H=0, P/V=0, N=1, C=0) ---
    LD A, 0x3F
    LD B, 0x1E
    CP B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify A was NOT modified
    CP 0x3F
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S should be cleared (result is positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (no lower-nibble borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (unconditionally set on Z80 subtraction)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no unsigned borrow)
    JP NZ, ERROR

    ; --- Case 2: 0x55 CP 0xAA = 0xAB internally (S=1, Z=0, H=1, P/V=1, N=1, C=1) ---
    LD A, 0x55
    LD B, 0xAA
    CP B

    PUSH AF
    POP DE          

    ; Verify A was NOT modified
    CP 0x55
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow from bit 4 occurred)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow occurred)
    JP Z, ERROR
    BIT 1, E        ; N should be set (unconditionally set on Z80 subtraction)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow from MSB occurred)
    JP Z, ERROR

    ; --- Case 3: 0xF8 CP 0xF8 = 0x00 internally (S=0, Z=1, H=0, P/V=0, N=1, C=0) ---
    LD A, 0xF8
    LD B, 0xF8
    CP B

    PUSH AF
    POP DE          

    ; Verify A was NOT modified
    CP 0xF8
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S should be cleared (result is zero/positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (values match, result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no lower-nibble borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (unconditionally set on Z80 subtraction)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no unsigned borrow)
    JP NZ, ERROR

    RET

