    BIT 0, C        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

TEST_XOR_HL:
    LD HL, TEST_RAM

    ; --- Case 1: 0x5A XOR (HL)[0xA5] = 0xFF ---
    LD A, 0xA5
    LD (HL), A
    LD A, 0x5A
    XOR (HL)

    PUSH AF
    POP DE          

    CP 0xFF
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0xE7 XOR (HL)[0xE7] = 0x00 ---
    LD A, 0xE7
    LD (HL), A
    LD A, 0xE7
    XOR (HL)

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 3: 0xE3 XOR (HL)[0x77] = 0x94 ---
    LD A, 0x77
    LD (HL), A
    LD A, 0xE3
    XOR (HL)

    PUSH AF
    POP DE          

    CP 0x94
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

