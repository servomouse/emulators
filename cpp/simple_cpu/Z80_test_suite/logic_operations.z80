    BIT 2, E        ; P/V should be set
    JP Z, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be set
    JP Z, ERROR

    ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0xF8 CP 0xF8) ---
    LD HL, TEST_RAM_MINUS_5
    LD (HL), 0xF8
    
    LD IY, TEST_RAM
    LD A, 0xF8
    CP (IY-5)       ; d = -5 (translated to 0xFB)

    PUSH AF
    POP DE          

    CP 0xF8
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

