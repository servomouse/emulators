TEST_AND_A:
    ; --- Case 1: 0x5A AND 0x5A = 0x5A (Positive, Even Parity, Non-Zero) ---
    LD A, 0x5A
    AND A

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x5A
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=1, P/V=1, N=0, C=0
    ; Note: 0x5A (01011010b) has 4 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x5A)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 2: 0x87 AND 0x87 = 0x87 (Negative, Even Parity, Non-Zero) ---
    LD A, 0x87
    AND A

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x87
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    ; Note: 0x87 (10000111b) has 4 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x87)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 3: 0x00 AND 0x00 = 0x00 (Zero, Even Parity, Cleared Sign) ---
    LD A, 0x00
    AND A

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
    ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be set (unconditionally set on Z80 AND)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x00)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

TEST_AND_IX_D:
    ; --- Case 1: Zero Offset d=0x00 -> Target: TEST_RAM (0x5A AND 0xA5 = 0x00) ---
    ; Setup target data in RAM
    LD HL, TEST_RAM
    LD (HL), 0xA5
    
    ; Points IX directly to TEST_RAM
    LD IX, TEST_RAM
    LD A, 0x5A
    AND (IX+0)      ; d = 0x00

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: Positive Offset d=0x05 -> Target: TEST_RAM_PLUS_5 (0xF0 AND 0x8A = 0x80) ---
    ; Setup target data in RAM
    LD HL, TEST_RAM_PLUS_5
    LD (HL), 0x8A
    
    ; Base IX points to TEST_RAM, offset (+5) must land on TEST_RAM_PLUS_5
    LD IX, TEST_RAM
    LD A, 0xF0
    AND (IX+5)      ; d = +5 (Signed 8-bit math)

    PUSH AF
    POP DE          

    CP 0x80
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0x1E AND 0xE7 = 0x06) ---
    ; Setup target data in RAM
    LD HL, TEST_RAM_MINUS_5
    LD (HL), 0xE7
    
    ; Base IX points to TEST_RAM, offset (-5) must land on TEST_RAM_MINUS_5
    LD IX, TEST_RAM
    LD A, 0x1E
    AND (IX-5)      ; d = -5 (Assembler translates to 0xFB)

    PUSH AF
    POP DE          

    CP 0x06
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

