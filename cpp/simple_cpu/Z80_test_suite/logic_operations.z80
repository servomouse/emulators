    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=0, P/V=1, N=0, C=0
    ; Note: 0xFF (11111111b) has 8 bits set -> even parity -> P/V = 1
    BIT 7, C        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, C        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, C        ; H should be cleared (unconditionally cleared on Z80 OR)
    JP NZ, ERROR
    BIT 2, C        ; P/V should be set (even parity for 0xFF)
    JP Z, ERROR
    BIT 1, C        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, C        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 2: 0x00 OR 0x00 = 0x00 (Positive, Even Parity, Zero) ---
    LD A, 0x00
    LD L, 0x00
    OR L

    PUSH AF
    POP BC          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=1, N=0, C=0
    ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
    BIT 7, C        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, C        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, C        ; H should be cleared (unconditionally cleared on Z80 OR)
    JP NZ, ERROR
    BIT 2, C        ; P/V should be set (even parity for 0x00)
    JP Z, ERROR
    BIT 1, C        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, C        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 3: 0x80 OR 0x03 = 0x83 (Negative, Odd Parity, Non-Zero) ---
    LD A, 0x80
    LD L, 0x03
    OR L

    PUSH AF
    POP BC          

    ; Verify Result
    CP 0x83
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=0, P/V=0, N=0, C=0
    ; Note: 0x83 (10000011b) has 3 bits set -> odd parity -> P/V = 0
    BIT 7, C        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, C        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, C        ; H should be cleared (unconditionally cleared on Z80 OR)
    JP NZ, ERROR
    BIT 2, C        ; P/V should be cleared (odd parity for 0x83)
    JP NZ, ERROR
    BIT 1, C        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, C        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

TEST_OR_HL:
    LD HL, TEST_RAM

    ; --- Case 1: 0x5A OR (HL)[0xA5] = 0xFF ---
    LD A, 0xA5
    LD (HL), A
    LD A, 0x5A
    OR (HL)

    PUSH AF
    POP DE          

    CP 0xFF
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x00 OR (HL)[0x00] = 0x00 ---
