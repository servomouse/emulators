019D                TEST_AND_A:   
019D                          ; --- Case 1: 0x5A AND 0x5A = 0x5A (Positive, Even Parity, Non-Zero) ---
019D   3E 5A                  LD   A,0x5A   
019F   A7                     AND   A   
01A0   F5                     PUSH   AF   
01A1   D1                     POP   DE   ; E = Flags
01A2                          ; Verify Result
01A2   FE 5A                  CP   0x5A   
01A4   C2 09 00               JP   NZ,ERROR   
01A7                          ; Verify Flags: S=0, Z=0, H=1, P/V=1, N=0, C=0
01A7                          ; Note: 0x5A (01011010b) has 4 bits set -> even parity -> P/V = 1
01A7   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
01A9   C2 09 00               JP   NZ,ERROR   
01AC   CB 73                  BIT   6,E   ; Z should be cleared (result is non-zero)
01AE   C2 09 00               JP   NZ,ERROR   
01B1   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
01B3   CA 09 00               JP   Z,ERROR   
01B6   CB 53                  BIT   2,E   ; P/V should be set (even parity for 0x5A)
01B8   CA 09 00               JP   Z,ERROR   
01BB   CB 4B                  BIT   1,E   ; N should be cleared (unconditionally cleared on logic ops)
01BD   C2 09 00               JP   NZ,ERROR   
01C0   CB 43                  BIT   0,E   ; C should be cleared (unconditionally cleared on logic ops)
01C2   C2 09 00               JP   NZ,ERROR   
01C5                          ; --- Case 2: 0x87 AND 0x87 = 0x87 (Negative, Even Parity, Non-Zero) ---
01C5   3E 87                  LD   A,0x87   
01C7   A7                     AND   A   
01C8   F5                     PUSH   AF   
01C9   D1                     POP   DE   
01CA                          ; Verify Result
01CA   FE 87                  CP   0x87   
01CC   C2 09 00               JP   NZ,ERROR   
01CF                          ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
01CF                          ; Note: 0x87 (10000111b) has 4 bits set -> even parity -> P/V = 1
01CF   CB 7B                  BIT   7,E   ; S should be set (result bit 7 is 1)
01D1   CA 09 00               JP   Z,ERROR   
01D4   CB 73                  BIT   6,E   ; Z should be cleared (result is non-zero)
01D6   C2 09 00               JP   NZ,ERROR   
01D9   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
01DB   CA 09 00               JP   Z,ERROR   
01DE   CB 53                  BIT   2,E   ; P/V should be set (even parity for 0x87)
01E0   CA 09 00               JP   Z,ERROR   
01E3   CB 4B                  BIT   1,E   ; N should be cleared (unconditionally cleared on logic ops)
01E5   C2 09 00               JP   NZ,ERROR   
01E8   CB 43                  BIT   0,E   ; C should be cleared (unconditionally cleared on logic ops)
01EA   C2 09 00               JP   NZ,ERROR   
01ED                          ; --- Case 3: 0x00 AND 0x00 = 0x00 (Zero, Even Parity, Cleared Sign) ---
01ED   3E 00                  LD   A,0x00   
01EF   A7                     AND   A   
01F0   F5                     PUSH   AF   
01F1   D1                     POP   DE   
01F2                          ; Verify Result
01F2   FE 00                  CP   0x00   
01F4   C2 09 00               JP   NZ,ERROR   
01F7                          ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
01F7                          ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
01F7   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
01F9   C2 09 00               JP   NZ,ERROR   
01FC   CB 73                  BIT   6,E   ; Z should be set (result is zero)
01FE   CA 09 00               JP   Z,ERROR   
0201   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
0203   CA 09 00               JP   Z,ERROR   
0206   CB 53                  BIT   2,E   ; P/V should be set (even parity for 0x00)
0208   CA 09 00               JP   Z,ERROR   
020B   CB 4B                  BIT   1,E   ; N should be cleared (unconditionally cleared on logic ops)
020D   C2 09 00               JP   NZ,ERROR   
0210   CB 43                  BIT   0,E   ; C should be cleared (unconditionally cleared on logic ops)
0212   C2 09 00               JP   NZ,ERROR   
0215   C9                     RET   
0216                TEST_AND_IX_D:   
0216                          ; --- Case 1: Zero Offset d=0x00 -> Target: TEST_RAM (0x5A AND 0xA5 = 0x00) ---
0216                          ; Setup target data in RAM
0216   21 00 FF               LD   HL,TEST_RAM   
0219   36 A5                  LD   (HL),0xA5   
021B                          ; Points IX directly to TEST_RAM
021B   DD 21 00 FF            LD   IX,TEST_RAM   
021F   3E 5A                  LD   A,0x5A   
0221   DD A6 00               AND   (IX+0)   ; d = 0x00
0224   F5                     PUSH   AF   
0225   D1                     POP   DE   
0226   FE 00                  CP   0x00   
0228   C2 09 00               JP   NZ,ERROR   
022B   CB 7B                  BIT   7,E   ; S should be cleared
022D   C2 09 00               JP   NZ,ERROR   
0230   CB 73                  BIT   6,E   ; Z should be set
0232   CA 09 00               JP   Z,ERROR   
0235   CB 63                  BIT   4,E   ; H should be set
0237   CA 09 00               JP   Z,ERROR   
023A   CB 53                  BIT   2,E   ; P/V should be set (even parity)
023C   CA 09 00               JP   Z,ERROR   
023F   CB 4B                  BIT   1,E   ; N should be cleared
0241   C2 09 00               JP   NZ,ERROR   
0244   CB 43                  BIT   0,E   ; C should be cleared
0246   C2 09 00               JP   NZ,ERROR   
0249                          ; --- Case 2: Positive Offset d=0x05 -> Target: TEST_RAM_PLUS_5 (0xF0 AND 0x8A = 0x80) ---
0249                          ; Setup target data in RAM
0249   21 05 FF               LD   HL,TEST_RAM_PLUS_5   
024C   36 8A                  LD   (HL),0x8A   
024E                          ; Base IX points to TEST_RAM, offset (+5) must land on TEST_RAM_PLUS_5
024E   DD 21 00 FF            LD   IX,TEST_RAM   
0252   3E F0                  LD   A,0xF0   
0254   DD A6 05               AND   (IX+5)   ; d = +5 (Signed 8-bit math)
0257   F5                     PUSH   AF   
0258   D1                     POP   DE   
0259   FE 80                  CP   0x80   
025B   C2 09 00               JP   NZ,ERROR   
025E   CB 7B                  BIT   7,E   ; S should be set
0260   CA 09 00               JP   Z,ERROR   
0263   CB 73                  BIT   6,E   ; Z should be cleared
0265   C2 09 00               JP   NZ,ERROR   
0268   CB 63                  BIT   4,E   ; H should be set
026A   CA 09 00               JP   Z,ERROR   
026D   CB 53                  BIT   2,E   ; P/V should be cleared (odd parity)
026F   C2 09 00               JP   NZ,ERROR   
0272   CB 4B                  BIT   1,E   ; N should be cleared
0274   C2 09 00               JP   NZ,ERROR   
0277   CB 43                  BIT   0,E   ; C should be cleared
0279   C2 09 00               JP   NZ,ERROR   
027C                          ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0x1E AND 0xE7 = 0x06) ---
027C                          ; Setup target data in RAM
027C   21 FB FE               LD   HL,TEST_RAM_MINUS_5   
027F   36 E7                  LD   (HL),0xE7   
0281                          ; Base IX points to TEST_RAM, offset (-5) must land on TEST_RAM_MINUS_5
0281   DD 21 00 FF            LD   IX,TEST_RAM   
0285   3E 1E                  LD   A,0x1E   
0287   DD A6 FB               AND   (IX-5)   ; d = -5 (Assembler translates to 0xFB)
028A   F5                     PUSH   AF   
028B   D1                     POP   DE   
028C   FE 06                  CP   0x06   
028E   C2 09 00               JP   NZ,ERROR   
0291   CB 7B                  BIT   7,E   ; S should be cleared
0293   C2 09 00               JP   NZ,ERROR   
0296   CB 73                  BIT   6,E   ; Z should be cleared
0298   C2 09 00               JP   NZ,ERROR   
029B   CB 63                  BIT   4,E   ; H should be set
029D   CA 09 00               JP   Z,ERROR   
02A0   CB 53                  BIT   2,E   ; P/V should be set (even parity)
02A2   CA 09 00               JP   Z,ERROR   
02A5   CB 4B                  BIT   1,E   ; N should be cleared
02A7   C2 09 00               JP   NZ,ERROR   
02AA   CB 43                  BIT   0,E   ; C should be cleared
02AC   C2 09 00               JP   NZ,ERROR   
02AF   C9                     RET