00AA                          ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
00AA                          ; Note: 0x00 has 0 bits set, which is even parity -> P/V = 1
00AA   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
00AC   C2 12 00               JP   NZ,ERROR   
00AF   CB 73                  BIT   6,E   ; Z should be set (result is zero)
00B1   CA 12 00               JP   Z,ERROR   
00B4   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
00B6   CA 12 00               JP   Z,ERROR   
