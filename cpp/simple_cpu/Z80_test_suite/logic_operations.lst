0000                          .ORG   0000h   
0000   31 00 F0               LD   SP,0xF000   
0003   CD 0D 00               CALL   TEST_ANDS   
0006   76                     HALT   
0007   00 00        TEMP_SP_SAVE:   DW   0x0000   
0009                SP_RESULT_ADDR:   EQU   0xFF02   
0009                TEST_RAM:   EQU   0xFF00   
0009                TEST_RAM_PLUS_5:   EQU   0xFF05   
0009                TEST_RAM_MINUS_5:   EQU   0xFEFB   
0009                ERROR:    
0009   F3                     DI   
000A   76                     HALT   
000B   18 FC                  JR   ERROR   
000D                TEST_ANDS:   
000D   CD 1D 00               CALL   TEST_AND_B   
0010   CD 9C 00               CALL   TEST_AND_HL   
0013   CD 21 01               CALL   TEST_AND_N   
0016   CD 9D 01               CALL   TEST_AND_A   
0019   CD 16 02               CALL   TEST_AND_IX_D   
001C   C9                     RET   
001D                TEST_AND_B:   
001D                          ; --- Case 1: 0x5A AND 0xA5 = 0x00 (Zero, Even Parity, Cleared Sign) ---
001D   3E 5A                  LD   A,0x5A   
001F   06 A5                  LD   B,0xA5   
0021   A0                     AND   B   
0022   F5                     PUSH   AF   
0023   D1                     POP   DE   ; E = Flags
0024                          ; Verify Result
0024   FE 00                  CP   0x00   
0026   C2 09 00               JP   NZ,ERROR   
0029                          ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
0029                          ; Note: 0x00 has 0 bits set, which is even parity -> P/V = 1
0029   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
002B   C2 09 00               JP   NZ,ERROR   
002E   CB 73                  BIT   6,E   ; Z should be set (result is zero)
0030   CA 09 00               JP   Z,ERROR   
0033   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
0035   CA 09 00               JP   Z,ERROR   
0038   CB 53                  BIT   2,E   ; P/V should be set (even parity for 0x00)
003A   CA 09 00               JP   Z,ERROR   
003D   CB 4B                  BIT   1,E   ; N should be cleared (unconditionally cleared on logic ops)
003F   C2 09 00               JP   NZ,ERROR   
0042   CB 43                  BIT   0,E   ; C should be cleared (unconditionally cleared on logic ops)
0044   C2 09 00               JP   NZ,ERROR   
0047                          ; --- Case 2: 0xF0 AND 0x8A = 0x80 (Negative, Odd Parity, Non-Zero) ---
0047   3E F0                  LD   A,0xF0   
0049   06 8A                  LD   B,0x8A   
004B   A0                     AND   B   
004C   F5                     PUSH   AF   
004D   D1                     POP   DE   
004E                          ; Verify Result
004E   FE 80                  CP   0x80   
0050   C2 09 00               JP   NZ,ERROR   
0053                          ; Verify Flags: S=1, Z=0, H=1, P/V=0, N=0, C=0
0053                          ; Note: 0x80 has 1 bit set, which is odd parity -> P/V = 0
0053   CB 7B                  BIT   7,E   ; S should be set (result bit 7 is 1)
0055   CA 09 00               JP   Z,ERROR   
0058   CB 73                  BIT   6,E   ; Z should be cleared (result is non-zero)
005A   C2 09 00               JP   NZ,ERROR   
005D   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
005F   CA 09 00               JP   Z,ERROR   
0062   CB 53                  BIT   2,E   ; P/V should be cleared (odd parity for 0x80)
0064   C2 09 00               JP   NZ,ERROR   
0067   CB 4B                  BIT   1,E   ; N should be cleared (unconditionally cleared on logic ops)
0069   C2 09 00               JP   NZ,ERROR   
006C   CB 43                  BIT   0,E   ; C should be cleared (unconditionally cleared on logic ops)
006E   C2 09 00               JP   NZ,ERROR   
0071                          ; --- Case 3: 0x1E AND 0xE7 = 0x06 (Positive, Even Parity, Non-Zero) ---
0071   3E 1E                  LD   A,0x1E   
0073   06 E7                  LD   B,0xE7   
0075   A0                     AND   B   
0076   F5                     PUSH   AF   
0077   D1                     POP   DE   
0078                          ; Verify Result
0078   FE 06                  CP   0x06   
007A   C2 09 00               JP   NZ,ERROR   
007D                          ; Verify Flags: S=0, Z=0, H=1, P/V=1, N=0, C=0
007D                          ; Note: 0x06 (00000110b) has 2 bits set -> even parity -> P/V = 1
007D   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
007F   C2 09 00               JP   NZ,ERROR   
0082   CB 73                  BIT   6,E   ; Z should be cleared (result is non-zero)
0084   C2 09 00               JP   NZ,ERROR   
0087   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
0089   CA 09 00               JP   Z,ERROR   
008C   CB 53                  BIT   2,E   ; P/V should be set (even parity for 0x06)
008E   CA 09 00               JP   Z,ERROR   
0091   CB 4B                  BIT   1,E   ; N should be cleared (unconditionally cleared on logic ops)
0093   C2 09 00               JP   NZ,ERROR   
0096   CB 43                  BIT   0,E   ; C should be cleared (unconditionally cleared on logic ops)
0098   C2 09 00               JP   NZ,ERROR   
009B   C9                     RET   
009C                TEST_AND_HL:   
