0054                          ; AND opcodes:
0054                TEST_AND_B:   
0054                          ; --- Case 1: 0x5A AND 0xA5 = 0x00 (Zero, Even Parity, Cleared Sign) ---
0054   3E 5A                  LD   A,0x5A   
0056   06 A5                  LD   B,0xA5   
0058   A0                     AND   B   
0059   F5                     PUSH   AF   
005A   D1                     POP   DE   ; E = Flags
005B                          ; Verify Result
005B   FE 00                  CP   0x00   
005D   C2 0C 00               JP   NZ,ERROR   
0060                          ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
0060                          ; Note: 0x00 has 0 bits set, which is even parity -> P/V = 1
0060   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
0062   C2 0C 00               JP   NZ,ERROR   
0065   CB 73                  BIT   6,E   ; Z should be set (result is zero)
0067   CA 0C 00               JP   Z,ERROR   
006A   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
006C   CA 0C 00               JP   Z,ERROR   
006F   CB 53                  BIT   2,E   ; P/V should be set (even parity for 0x00)
