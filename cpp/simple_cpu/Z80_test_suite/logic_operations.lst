00F0   CB 43                  BIT   0,E   ; C should be cleared
00F2   C2 09 00               JP   NZ,ERROR   
00F5                          ; --- Case 3: 0x1E AND (HL)[0xE7] = 0x06 ---
00F5   3E E7                  LD   A,0xE7   
