0085                          ; Verify Flags: S=0, Z=1, H=1, P/V=1, N=0, C=0
0085                          ; Note: 0x00 has 0 bits set, which is even parity -> P/V = 1
0085   CB 7B                  BIT   7,E   ; S should be cleared (result bit 7 is 0)
0087   C2 0F 00               JP   NZ,ERROR   
008A   CB 73                  BIT   6,E   ; Z should be set (result is zero)
008C   CA 0F 00               JP   Z,ERROR   
008F   CB 63                  BIT   4,E   ; H should be set (unconditionally set on Z80 AND)
0091   CA 0F 00               JP   Z,ERROR   
