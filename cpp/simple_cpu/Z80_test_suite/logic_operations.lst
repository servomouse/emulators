08D7                          ; Note: 0x94 (10010100b) has 3 bits set -> odd parity -> P/V = 0
08D7   CB 79                  BIT   7,C   ; S should be set (result bit 7 is 1)
08D9   CA 0C 00               JP   Z,ERROR   
