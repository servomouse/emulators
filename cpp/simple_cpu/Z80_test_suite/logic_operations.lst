08AD                          ; Verify Flags: S=0, Z=1, H=0, P/V=1, N=0, C=0
08AD                          ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
08AD   CB 79                  BIT   7,C   ; S should be cleared (result bit 7 is 0)
08AF   C2 0C 00               JP   NZ,ERROR   
08B2   CB 71                  BIT   6,C   ; Z should be set (result is zero)
08B4   CA 0C 00               JP   Z,ERROR   
08B7   CB 61                  BIT   4,C   ; H should be cleared (unconditionally cleared on Z80 XOR)
08B9   C2 0C 00               JP   NZ,ERROR   
08BC   CB 51                  BIT   2,C   ; P/V should be set (even parity for 0x00)
08BE   CA 0C 00               JP   Z,ERROR   
08C1   CB 49                  BIT   1,C   ; N should be cleared (unconditionally cleared on logic ops)
08C3   C2 0C 00               JP   NZ,ERROR   
08C6   CB 41                  BIT   0,C   ; C should be cleared (unconditionally cleared on logic ops)
08C8   C2 0C 00               JP   NZ,ERROR   
