0079                          ; AND opcodes:
0079                TEST_AND_B:   
0079                          ; --- Case 1: 0x5A AND 0xA5 = 0x00 (Zero, Even Parity, Cleared Sign) ---
0079   3E 5A                  LD   A,0x5A   
007B   06 A5                  LD   B,0xA5   
007D   A0                     AND   B   
007E   F5                     PUSH   AF   
