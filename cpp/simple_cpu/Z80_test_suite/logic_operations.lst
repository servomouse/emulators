00CF   A6                     AND   (HL)   
00D0   F5                     PUSH   AF   
00D1   D1                     POP   DE   
00D2   FE 80                  CP   0x80   
00D4   C2 09 00               JP   NZ,ERROR   
00D7   CB 7B                  BIT   7,E   ; S should be set
00D9   CA 09 00               JP   Z,ERROR   
00DC   CB 73                  BIT   6,E   ; Z should be cleared
00DE   C2 09 00               JP   NZ,ERROR   
