0710                TEST_SBC_A_A:   
0710                          ; --- Case 1: 0x44 - 0x44 - C(1) = 0xFF (Carry Mask Generation) ---
0710                          ; Subtraction of A from A with Carry set always yields 0xFF (-1).
0710   3E 44                  LD   A,0x44   
0712   37                     SCF   ; Set Carry flag
0713   9F                     SBC   A,A   
0714   F5                     PUSH   AF   
0715   D1                     POP   DE   ; E = Flags
0716                          ; Verify Result
0716   FE FF                  CP   0xFF   
0718   C2 0C 00               JP   NZ,ERROR   
071B                          ; Verify Flags: S=1, Z=0, H=1, P/V=0, N=1, C=1
071B   CB 7B                  BIT   7,E   ; S should be set (0xFF is negative)
071D   CA 0C 00               JP   Z,ERROR   
0720   CB 73                  BIT   6,E   ; Z should be cleared
0722   C2 0C 00               JP   NZ,ERROR   
0725   CB 63                  BIT   4,E   ; H should be set (borrow required 0x4 - 0x4 - 1)
0727   CA 0C 00               JP   Z,ERROR   
072A   CB 53                  BIT   2,E   ; P/V should be cleared (no signed overflow)
072C   C2 0C 00               JP   NZ,ERROR   
072F   CB 4B                  BIT   1,E   ; N should be set (subtraction operation)
0731   CA 0C 00               JP   Z,ERROR   
0734   CB 43                  BIT   0,E   ; C should be set (borrow required from MSB)
0736   CA 0C 00               JP   Z,ERROR   
0739                          ; --- Case 2: 0xAA - 0xAA - C(0) = 0x00 (Clean Zero) ---
0739                          ; Subtraction of A from A with Carry cleared always yields 0x00.
0739   3E AA                  LD   A,0xAA   
073B   A7                     AND   A   ; Clear Carry flag safely
073C   9F                     SBC   A,A   
073D   F5                     PUSH   AF   
073E   D1                     POP   DE   
073F                          ; Verify Result
073F   FE 00                  CP   0x00   
0741   C2 0C 00               JP   NZ,ERROR   
0744                          ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
0744   CB 7B                  BIT   7,E   ; S should be cleared (result is not negative)
0746   C2 0C 00               JP   NZ,ERROR   
0749   CB 73                  BIT   6,E   ; Z should be set (result is zero)
074B   CA 0C 00               JP   Z,ERROR   
074E   CB 63                  BIT   4,E   ; H should be cleared (no half-borrow)
0750   C2 0C 00               JP   NZ,ERROR   
0753   CB 53                  BIT   2,E   ; P/V should be cleared (no signed overflow)
0755   C2 0C 00               JP   NZ,ERROR   
0758   CB 4B                  BIT   1,E   ; N should be set (subtraction operation)
075A   CA 0C 00               JP   Z,ERROR   
075D   CB 43                  BIT   0,E   ; C should be cleared (no borrow)
075F   C2 0C 00               JP   NZ,ERROR   
0762   C9                     RET