45A4                TEST_EX_AF_AF:   ; Covers 0x08
45A4                          ; --- Step 1: Initialize AF' ---
45A4                          ; We need to get values into AF' first.
45A4                          ; We load them into AF, then swap them to the shadow side.
45A4   01 00 AA               LD   BC,0xAA00   ; B = 0xAA (Future A'), C = 0x00 (Will hold flags)
45A7                          ; We can't easily force 0xBB into F' directly without pushing/popping,
45A7                          ; so let's use the stack to prime our initial AF state.
45A7   11 BB AA               LD   DE,0xAABB   
45AA   D5                     PUSH   DE   
45AB   F1                     POP   AF   
45AC   08                     EX   AF,AF'   
45AD   11 22 11               LD   DE,0x1122   ; D = A value (0x11), E = F value (0x22)
45B0   D5                     PUSH   DE   
45B1   F1                     POP   AF   ; Main AF is now 0x1122
45B2   08                     EX   AF,AF'   
45B3   F5                     PUSH   AF   
45B4   C1                     POP   BC   
45B5   78                     LD   A,B   
45B6   EE AA                  XOR   0xAA   
45B8   C2 1F 00               JP   NZ,ERROR   
45BB   79                     LD   A,C   
45BC   EE BB                  XOR   0xBB   
45BE   C2 1F 00               JP   NZ,ERROR   
45C1   08                     EX   AF,AF'   
45C2   F5                     PUSH   AF   
45C3   C1                     POP   BC   
45C4   78                     LD   A,B   
45C5   EE 11                  XOR   0x11   
45C7   C2 1F 00               JP   NZ,ERROR   
45CA   79                     LD   A,C   
45CB   EE 22                  XOR   0x22   
45CD   C2 1F 00               JP   NZ,ERROR   
45D0   C9                     RET   
