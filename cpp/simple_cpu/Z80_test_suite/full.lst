2F9F                TEST_ADC_A_IY_D:   
2F9F                          ; Ensure IY points to our scratchpad memory
2F9F   FD 21 00 FF            LD   IY,TEST_RAM   
2FA3                          ; --- Case 1: 0x7F + 0x02 + C(1) = 0x82 ---
2FA3   FD 36 05 02            LD   (IY+0x05),0x02   ; Load operand at displacement +5
2FA7   3E 7F                  LD   A,0x7F   
2FA9   37                     SCF   ; Set Carry flag
2FAA   FD 8E 05               ADC   A,(IY+0x05)   
2FAD   F5                     PUSH   AF   
2FAE   D1                     POP   DE   ; E = Flags
2FAF                          ; Verify Result
2FAF   FE 82                  CP   0x82   
2FB1   C2 1F 00               JP   NZ,ERROR   
2FB4                          ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
2FB4   CB 7B                  BIT   7,E   ; S should be set (result is negative)
2FB6   CA 1F 00               JP   Z,ERROR   
2FB9   CB 73                  BIT   6,E   ; Z should be cleared (result is not zero)
2FBB   C2 1F 00               JP   NZ,ERROR   
2FBE   CB 63                  BIT   4,E   ; H should be set (carry from bit 3)
2FC0   CA 1F 00               JP   Z,ERROR   
