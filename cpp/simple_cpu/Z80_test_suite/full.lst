3739   C2 1F 00               JP   NZ,ERROR   
373C   CB 63                  BIT   4,E   ; H flag (Expected: 1, 0x7F to 0x80 carries from bit 3)
373E   CA 1F 00               JP   Z,ERROR   
3741   CB 53                  BIT   2,E   ; V/P flag (Expected: 1, OVERFLOW!)
3743   CA 1F 00               JP   Z,ERROR   
3746   CB 4B                  BIT   1,E   ; N flag (Expected: 0)
3748   C2 1F 00               JP   NZ,ERROR   
374B   CB 43                  BIT   0,E   ; C flag (Expected: 0, preserves initial 0)
374D   C2 1F 00               JP   NZ,ERROR   
