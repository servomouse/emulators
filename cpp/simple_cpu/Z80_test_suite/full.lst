3C9F                          ; 8-bit decrement opcodes:
3C9F                TEST_DEC_A:   
3C9F                          ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
3C9F                          ; Tests basic subtraction, the Zero flag, and the N flag.
3C9F   11 00 01               LD   DE,0x0100   ; D = Initial A value (0x01), E = Initial Flags (0x00)
3CA2   D5                     PUSH   DE   ; Push DE onto the stack
3CA3   F1                     POP   AF   ; Pop into AF. Now Accumulator (A) = 0x01, Flags (F) = 0x00
3CA4   3D                     DEC   A   ; Execute Opcode: A = A - 1. A becomes 0x00.
3CA5   F5                     PUSH   AF   ; Push the result and the newly generated flags to the stack
3CA6   D1                     POP   DE   ; Pop into DE. D = Result (0x00), E = New Flags
3CA7                          ; Verify Result
3CA7   FE 00                  CP   0x00   ; Compare Accumulator with 0x00 (Subtracts 0x00 from A, updates flags, discards result)
3CA9   C2 1F 00               JP   NZ,ERROR   ; If A was not 0x00, the Zero flag won't be set. Jump to ERROR.
3CAC                          ; Verify Flags stored in E:
3CAC   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 0 (0x00 is not negative)
3CAE   C2 1F 00               JP   NZ,ERROR   ; Error if bit 7 was 1
3CB1   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 1 (Result of DEC was zero)
3CB3   CA 1F 00               JP   Z,ERROR   ; Error if bit 6 was 0
3CB6   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 0 (No borrow from bit 4 occurred: 0x1 -> 0x0)
3CB8   C2 1F 00               JP   NZ,ERROR   ; Error if bit 4 was 1
3CBB   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 0 (No signed overflow occurred)
3CBD   C2 1F 00               JP   NZ,ERROR   ; Error if bit 2 was 1
3CC0   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC operations)
3CC2   CA 1F 00               JP   Z,ERROR   ; Error if bit 1 was 0
3CC5   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 0 (DEC never affects the Carry flag, should remain 0)
3CC7   C2 1F 00               JP   NZ,ERROR   ; Error if bit 0 was 1
3CCA                          ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
3CCA                          ; Tests underflow wrapping, the Half-Carry flag, and ensuring Carry is preserved.
3CCA   11 FF 00               LD   DE,0x00FF   ; D = Initial A (0x00), E = Initial Flags (0xFF, sets all flags including Carry)
3CCD   D5                     PUSH   DE   
3CCE   F1                     POP   AF   ; A = 0x00, Flags = 0xFF
3CCF   3D                     DEC   A   ; Execute Opcode: 0x00 - 1 = 0xFF.
3CD0   F5                     PUSH   AF   
3CD1   D1                     POP   DE   ; Save results. D = Result (0xFF), E = New Flags
3CD2                          ; Verify Result
3CD2   FE FF                  CP   0xFF   ; Compare A with 0xFF
3CD4   C2 1F 00               JP   NZ,ERROR   ; Error if A did not correctly wrap around to 0xFF
3CD7                          ; Verify Flags stored in E:
3CD7   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 1 (0xFF has bit 7 set, treating it as negative)
3CD9   CA 1F 00               JP   Z,ERROR   ; Error if bit 7 was 0
3CDC   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 0 (Result 0xFF is not zero)
3CDE   C2 1F 00               JP   NZ,ERROR   ; Error if bit 6 was 1
3CE1   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow from bit 4)
3CE3   CA 1F 00               JP   Z,ERROR   ; Error if bit 4 was 0
3CE6   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 0 (Wrapping 0x00 to 0xFF is not a signed overflow)
3CE8   C2 1F 00               JP   NZ,ERROR   ; Error if bit 2 was 1
3CEB   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
3CED   CA 1F 00               JP   Z,ERROR   ; Error if bit 1 was 0
3CF0   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 1 (DEC does not affect Carry; should preserve initial 1)
3CF2   CA 1F 00               JP   Z,ERROR   ; Error if bit 0 was 0
3CF5                          ; --- Case 3: Overflow (0x80 -> 0x7F) ---
3CF5                          ; Tests the specific edge case where a negative signed byte decrements into a positive one.
3CF5   11 00 80               LD   DE,0x8000   ; D = Initial A (0x80 or -128), E = Initial Flags (0x00)
3CF8   D5                     PUSH   DE   
3CF9   F1                     POP   AF   ; A = 0x80, Flags = 0x00
3CFA   3D                     DEC   A   ; Execute Opcode: 0x80 (-128) - 1 = 0x7F (+127). This is a signed overflow.
3CFB   F5                     PUSH   AF   
3CFC   D1                     POP   DE   ; Save results. D = Result (0x7F), E = New Flags
3CFD                          ; Verify Result
3CFD   FE 7F                  CP   0x7F   ; Compare A with 0x7F
3CFF   C2 1F 00               JP   NZ,ERROR   ; Error if result is not 0x7F
3D02                          ; Verify Flags stored in E:
3D02   CB 7B                  BIT   7,E   ; Check S (Sign) flag. Expected: 0 (0x7F has bit 7 clear, it is positive)
3D04   C2 1F 00               JP   NZ,ERROR   ; Error if bit 7 was 1
3D07   CB 73                  BIT   6,E   ; Check Z (Zero) flag. Expected: 0 (Result is not zero)
3D09   C2 1F 00               JP   NZ,ERROR   ; Error if bit 6 was 1
3D0C   CB 63                  BIT   4,E   ; Check H (Half-Carry) flag. Expected: 1 (Lower nibble 0x0 - 1 causes borrow)
3D0E   CA 1F 00               JP   Z,ERROR   ; Error if bit 4 was 0
3D11   CB 53                  BIT   2,E   ; Check P/V (Parity/Overflow) flag. Expected: 1 (Sign changed from neg to pos: OVERFLOW!)
3D13   CA 1F 00               JP   Z,ERROR   ; Error if bit 2 was 0
3D16   CB 4B                  BIT   1,E   ; Check N (Add/Subtract) flag. Expected: 1 (Always 1 for DEC)
3D18   CA 1F 00               JP   Z,ERROR   ; Error if bit 1 was 0
3D1B   CB 43                  BIT   0,E   ; Check C (Carry) flag. Expected: 0 (DEC does not affect Carry; preserves initial 0)
3D1D   C2 1F 00               JP   NZ,ERROR   ; Error if bit 0 was 1
3D20   C9                     RET   
