4649                TEST_CPL:   ; Covers 0x2F
4649                          ; =========================================================
4649                          ; CASE 1: 0x55 -> 0xAA (All bits flipped)
4649                          ; PRE-CONDITION: Clear all flags (0x00)
4649                          ; Expected Result: 0xAA, Flags: H=1, N=1 (Others remain 0)
4649                          ; =========================================================
4649   01 00 55               LD   BC,0x5500   ; B = Initial A (0x55), C = Initial Flags (0x00)
464C   C5                     PUSH   BC   
464D   F1                     POP   AF   
464E   2F                     CPL   
464F   F5                     PUSH   AF   
4650   C1                     POP   BC   ; C = Resulting Flags
4651                          ; Verify Result (0xAA)
4651   EE AA                  XOR   0xAA   
4653   C2 1F 00               JP   NZ,ERROR   
4656                          ; Verify Flags: H and N must be set to 1. All others must be 0.
4656   CB 79                  BIT   7,C   ; S flag
4658   C2 1F 00               JP   NZ,ERROR   
465B   CB 71                  BIT   6,C   ; Z flag
465D   C2 1F 00               JP   NZ,ERROR   
4660   CB 61                  BIT   4,C   ; H flag (Must be set by CPL)
4662   CA 1F 00               JP   Z,ERROR   
4665   CB 51                  BIT   2,C   ; V/P flag
4667   C2 1F 00               JP   NZ,ERROR   
466A   CB 49                  BIT   1,C   ; N flag (Must be set by CPL)
466C   CA 1F 00               JP   Z,ERROR   
466F   CB 41                  BIT   0,C   ; C flag
4671   C2 1F 00               JP   NZ,ERROR   
4674                          ; =========================================================
4674                          ; CASE 2: 0xAA -> 0x55
4674                          ; PRE-CONDITION: Set all flags (0xFF)
4674                          ; Expected Result: 0x55, Flags: S=1, Z=1, V=1, H=1, N=1, C=1
4674                          ; =========================================================
4674   01 FF AA               LD   BC,0xAAFF   ; B = Initial A (0xAA), C = Initial Flags (0xFF)
4677   C5                     PUSH   BC   
4678   F1                     POP   AF   
4679   2F                     CPL   
467A   F5                     PUSH   AF   
467B   C1                     POP   BC   ; C = Resulting Flags
467C                          ; Verify Result (0x55)
467C   EE 55                  XOR   0x55   
467E   C2 1F 00               JP   NZ,ERROR   
4681                          ; Verify Flags: S, Z, V, C are preserved (1). H and N are forced to 1.
4681   CB 79                  BIT   7,C   ; S flag
4683   CA 1F 00               JP   Z,ERROR   
4686   CB 71                  BIT   6,C   ; Z flag
4688   CA 1F 00               JP   Z,ERROR   
468B   CB 61                  BIT   4,C   ; H flag
