3BD2                TEST_INC_SP:   
3BD2                          ; --- Case 1: Standard Increment (0x0001 -> 0x0002) ---
3BD2   ED 73 04 00            LD   (TEMP_SP_SAVE),SP   ; Save the real stack pointer safely
3BD6                          ; Setup flags while we still have a working stack!
3BD6   11 FF 00               LD   DE,0x00FF   
3BD9   D5                     PUSH   DE   
3BDA   F1                     POP   AF   ; Flags = 0xFF
3BDB   31 01 00               LD   SP,0x0001   ; Set dummy SP
3BDE   33                     INC   SP   ; Execute Opcode!
3BDF                          ; We cannot push AF yet! Save result to a safe static memory address
3BDF   ED 73 02 FF            LD   (SP_RESULT_ADDR),SP   
3BE3   ED 7B 04 00            LD   SP,(TEMP_SP_SAVE)   ; Phew, real stack is back.
3BE7   F5                     PUSH   AF   
3BE8   D1                     POP   DE   ; E = Preserved flags
3BE9                          ; Verify Result
3BE9   2A 02 FF               LD   HL,(SP_RESULT_ADDR)   ; Read SP result back
3BEC   7C                     LD   A,H   
3BED   FE 00                  CP   0x00   
3BEF   C2 1F 00               JP   NZ,ERROR   
