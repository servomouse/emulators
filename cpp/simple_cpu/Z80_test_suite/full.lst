3D23   11 00 00               LD   DE,0x0000   ; D = Initial A (don't care), E = Initial Flags (0x00)
3D26   D5                     PUSH   DE   
3D27   F1                     POP   AF   ; Flags = 0x00
3D28   05                     DEC   B   ; Execute Opcode: B = B - 1. B becomes 0x00.
3D29   F5                     PUSH   AF   ; Push the newly generated flags to the stack
