45D1   01 11 11               LD   BC,0x1111   
45D4   11 22 22               LD   DE,0x2222   
45D7   21 33 33               LD   HL,0x3333   
45DA   D9                     EXX   
45DB   11 FF 00               LD   DE,0x00FF   ; Set flags
45DE   D5                     PUSH   DE   
45DF   F1                     POP   AF   
45E0   01 AA AA               LD   BC,0xAAAA   
45E3   11 BB BB               LD   DE,0xBBBB   
45E6   21 CC CC               LD   HL,0xCCCC   
45E9   D9                     EXX   
