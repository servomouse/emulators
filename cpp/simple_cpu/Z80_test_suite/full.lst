4610   79                     LD   A,C   
4611   EE FF                  XOR   0xFF   
4613   C2 1F 00               JP   NZ,ERROR   
4616   11 00 00               LD   DE,0x0000   ; Clear flags
4619   D5                     PUSH   DE   
461A   F1                     POP   AF   
