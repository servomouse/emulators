3759   F1                     POP   AF   
375A   DD 34 05               INC   (IX+0x05)   
375D   F5                     PUSH   AF   
375E   D1                     POP   DE   
375F   3A 05 FF               LD   A,(TEST_RAM_PLUS_5)   
3762   FE 00                  CP   0x00   
3764   C2 1F 00               JP   NZ,ERROR   
3767   CB 7B                  BIT   7,E   ; S flag (Expected: 0)
3769   C2 1F 00               JP   NZ,ERROR   
376C   CB 73                  BIT   6,E   ; Z flag (Expected: 1, result is zero)
376E   CA 1F 00               JP   Z,ERROR   
3771   CB 63                  BIT   4,E   ; H flag (Expected: 1, 0xFF to 0x00 carries from bit 3)
3773   CA 1F 00               JP   Z,ERROR   
3776   CB 53                  BIT   2,E   ; V/P flag (Expected: 0, wrapping to 0 is not signed overflow)
3778   C2 1F 00               JP   NZ,ERROR   
377B   CB 4B                  BIT   1,E   ; N flag (Expected: 0)
377D   C2 1F 00               JP   NZ,ERROR   
3780   CB 43                  BIT   0,E   ; C flag (Expected: 1, preserves initial 1)
3782   CA 1F 00               JP   Z,ERROR   
3785   C9                     RET   
