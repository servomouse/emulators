0D82   CB 53                  BIT   2,E   ; V/P flag
0D84   CA 0C 00               JP   Z,ERROR   
0D87   CB 4B                  BIT   1,E   ; N flag
0D89   C2 0C 00               JP   NZ,ERROR   
0D8C   CB 43                  BIT   0,E   ; C flag
0D8E   C2 0C 00               JP   NZ,ERROR   
