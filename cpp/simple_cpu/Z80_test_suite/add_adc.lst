0D86                TEST_ADD_HL_BC:   ; Covers ADD HL, BC
0D86                          ; =========================================================
0D86                          ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
0D86                          ; PRE-CONDITION: Set all flags to test preservation
0D86                          ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
0D86                          ; =========================================================
0D86   21 30 10               LD   HL,0x1030   
0D89   01 04 02               LD   BC,0x0204   
0D8C   11 FF 00               LD   DE,0x00FF   ; D=0, E=Initial Flags
0D8F   D5                     PUSH   DE   
0D90   F1                     POP   AF   ; Load Flags
0D91   09                     ADD   HL,BC   
0D92   F5                     PUSH   AF   
0D93   D1                     POP   DE   ; E = Resulting Flags
0D94                          ; Verify Result (0x1234)
0D94   7C                     LD   A,H   
0D95   EE 12                  XOR   0x12   
0D97   C2 0C 00               JP   NZ,ERROR   
0D9A   7D                     LD   A,L   
0D9B   EE 34                  XOR   0x34   
0D9D   C2 0C 00               JP   NZ,ERROR   
0DA0                          ; Verify Flags
0DA0   CB 7B                  BIT   7,E   ; S flag
0DA2   CA 0C 00               JP   Z,ERROR   
0DA5   CB 73                  BIT   6,E   ; Z flag
0DA7   CA 0C 00               JP   Z,ERROR   
0DAA   CB 63                  BIT   4,E   ; H flag
0DAC   C2 0C 00               JP   NZ,ERROR   
0DAF   CB 53                  BIT   2,E   ; V/P flag
0DB1   CA 0C 00               JP   Z,ERROR   
0DB4   CB 4B                  BIT   1,E   ; N flag
0DB6   C2 0C 00               JP   NZ,ERROR   
0DB9   CB 43                  BIT   0,E   ; C flag
0DBB   C2 0C 00               JP   NZ,ERROR   
0DBE                          ; =========================================================
0DBE                          ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
0DBE                          ; PRE-CONDITION: Clear all flags (0x00)
0DBE                          ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
0DBE                          ; =========================================================
0DBE   21 00 08               LD   HL,0x0800   
0DC1   01 00 08               LD   BC,0x0800   
0DC4   11 00 00               LD   DE,0x0000   
0DC7   D5                     PUSH   DE   
0DC8   F1                     POP   AF   
0DC9   09                     ADD   HL,BC   
0DCA   F5                     PUSH   AF   
0DCB   D1                     POP   DE   
0DCC                          ; Verify Result (0x1000)
0DCC   7C                     LD   A,H   
0DCD   EE 10                  XOR   0x10   
0DCF   C2 0C 00               JP   NZ,ERROR   
0DD2   7D                     LD   A,L   
0DD3   EE 00                  XOR   0x00   
0DD5   C2 0C 00               JP   NZ,ERROR   
0DD8                          ; Verify Flags
0DD8   CB 7B                  BIT   7,E   ; S flag
0DDA   C2 0C 00               JP   NZ,ERROR   
0DDD   CB 73                  BIT   6,E   ; Z flag
0DDF   C2 0C 00               JP   NZ,ERROR   
