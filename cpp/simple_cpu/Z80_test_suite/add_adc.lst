0D59                TEST_ADD_HL_BC:   ; Covers ADD HL, BC
0D59                          ; =========================================================
0D59                          ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
0D59                          ; PRE-CONDITION: Set all flags to test preservation
0D59                          ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
0D59                          ; =========================================================
0D59   21 30 10               LD   HL,0x1030   
0D5C   01 04 02               LD   BC,0x0204   
0D5F   11 FF 00               LD   DE,0x00FF   ; D=0, E=Initial Flags
0D62   D5                     PUSH   DE   
0D63   F1                     POP   AF   ; Load Flags
0D64   09                     ADD   HL,BC   
0D65   F5                     PUSH   AF   
0D66   D1                     POP   DE   ; E = Resulting Flags
0D67                          ; Verify Result (0x1234)
0D67   7C                     LD   A,H   
0D68   EE 12                  XOR   0x12   
0D6A   C2 0C 00               JP   NZ,ERROR   
0D6D   7D                     LD   A,L   
0D6E   EE 34                  XOR   0x34   
0D70   C2 0C 00               JP   NZ,ERROR   
0D73                          ; Verify Flags
0D73   CB 7B                  BIT   7,E   ; S flag
0D75   CA 0C 00               JP   Z,ERROR   
0D78   CB 73                  BIT   6,E   ; Z flag
0D7A   CA 0C 00               JP   Z,ERROR   
0D7D   CB 63                  BIT   4,E   ; H flag
