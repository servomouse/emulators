0D7A                TEST_ADD_HL_BC:   ; Covers ADD HL, BC
0D7A                          ; =========================================================
0D7A                          ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
0D7A                          ; PRE-CONDITION: Set all flags to test preservation
0D7A                          ; Expected Result: 0x1234, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
0D7A                          ; =========================================================
0D7A   21 30 10               LD   HL,0x1030   
0D7D   01 04 02               LD   BC,0x0204   
0D80   11 FF 00               LD   DE,0x00FF   ; D=0, E=Initial Flags
0D83   D5                     PUSH   DE   
0D84   F1                     POP   AF   ; Load Flags
0D85   09                     ADD   HL,BC   
0D86   F5                     PUSH   AF   
0D87   D1                     POP   DE   ; E = Resulting Flags
0D88                          ; Verify Result (0x1234)
0D88   7C                     LD   A,H   
0D89   EE 12                  XOR   0x12   
0D8B   C2 0C 00               JP   NZ,ERROR   
0D8E   7D                     LD   A,L   
0D8F   EE 34                  XOR   0x34   
0D91   C2 0C 00               JP   NZ,ERROR   
0D94                          ; Verify Flags
0D94   CB 7B                  BIT   7,E   ; S flag
0D96   CA 0C 00               JP   Z,ERROR   
0D99   CB 73                  BIT   6,E   ; Z flag
0D9B   CA 0C 00               JP   Z,ERROR   
0D9E   CB 63                  BIT   4,E   ; H flag
0DA0   C2 0C 00               JP   NZ,ERROR   
0DA3   CB 53                  BIT   2,E   ; V/P flag
0DA5   CA 0C 00               JP   Z,ERROR   
0DA8   CB 4B                  BIT   1,E   ; N flag
0DAA   C2 0C 00               JP   NZ,ERROR   
0DAD   CB 43                  BIT   0,E   ; C flag
0DAF   C2 0C 00               JP   NZ,ERROR   
0DB2                          ; =========================================================
0DB2                          ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
0DB2                          ; PRE-CONDITION: Clear all flags (0x00)
0DB2                          ; Expected Result: 0x1000, Flags: H=1, N=0, C=0 (Others 0)
0DB2                          ; =========================================================
0DB2   21 00 08               LD   HL,0x0800   
0DB5   01 00 08               LD   BC,0x0800   
0DB8   11 00 00               LD   DE,0x0000   
0DBB   D5                     PUSH   DE   
0DBC   F1                     POP   AF   
0DBD   09                     ADD   HL,BC   
0DBE   F5                     PUSH   AF   
0DBF   D1                     POP   DE   
0DC0                          ; Verify Result (0x1000)
0DC0   7C                     LD   A,H   
0DC1   EE 10                  XOR   0x10   
0DC3   C2 0C 00               JP   NZ,ERROR   
0DC6   7D                     LD   A,L   
0DC7   EE 00                  XOR   0x00   
0DC9   C2 0C 00               JP   NZ,ERROR   
0DCC                          ; Verify Flags
0DCC   CB 7B                  BIT   7,E   ; S flag
0DCE   C2 0C 00               JP   NZ,ERROR   
0DD1   CB 73                  BIT   6,E   ; Z flag
0DD3   C2 0C 00               JP   NZ,ERROR   
0DD6   CB 63                  BIT   4,E   ; H flag
0DD8   CA 0C 00               JP   Z,ERROR   
0DDB   CB 53                  BIT   2,E   ; V/P flag
0DDD   C2 0C 00               JP   NZ,ERROR   
