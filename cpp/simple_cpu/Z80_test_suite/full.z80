    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

; OR opcodes:
TEST_OR_B:
    ; --- Case 1: 0x5A OR 0xA5 = 0xFF (Negative, Even Parity, Non-Zero) ---
    LD A, 0x5A
    LD B, 0xA5
    OR B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=0, P/V=1, N=0, C=0
    ; Note: 0xFF (11111111b) has 8 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 OR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0xFF)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 2: 0x00 OR 0x00 = 0x00 (Positive, Even Parity, Zero) ---
    LD A, 0x00
    LD B, 0x00
    OR B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=1, N=0, C=0
    ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 OR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x00)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 3: 0x80 OR 0x03 = 0x83 (Negative, Odd Parity, Non-Zero) ---
    LD A, 0x80
    LD B, 0x03
    OR B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x83
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=0, P/V=0, N=0, C=0
    ; Note: 0x83 (10000011b) has 3 bits set -> odd parity -> P/V = 0
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 OR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity for 0x83)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

