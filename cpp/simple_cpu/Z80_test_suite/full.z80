TEST_ADC_A_A:
    ; --- Case 1: 0x7F + 0x7F + C(1) = 0xFF ---
    LD A, 0x7F
    SCF             ; Set Carry flag
    ADC A, A

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (carry from bit 3)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (addition)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (no carry from MSB)
    JP NZ, ERROR

    ; --- Case 2: 0x80 + 0x80 + C(0) = 0x00 ---
    LD A, 0x80
    AND A           ; Clears Carry flag (and others, but we only need C=0)
    ADC A, A

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=1, N=0, C=1
    BIT 7, E        ; S should be cleared (result is positive/zero)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no carry from bit 3)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (addition)
    JP NZ, ERROR
    BIT 0, E        ; C should be set (carry from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x12 + C(1) = 0x25 ---
    LD A, 0x12
    SCF             ; Set Carry flag
    ADC A, A

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x25
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_ADC_A_HL:
    ; --- Case 1: 0x7F + 0x02 + C(1) = 0x82 ---
