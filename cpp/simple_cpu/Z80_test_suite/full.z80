TEST_ADD_A_IX_D:
    LD IX, TEST_RAM     ; Point IX to base RAM address (0x8000)

    ; --- Case 1: Positive Offset (+0x05) ---
    ; Math: 0x7F + 0x7E = 0xFD
    ; Reads from TEST_RAM_PLUS_5 (0x8005)
    LD A, 0x7E
    LD (TEST_RAM_PLUS_5), A 
    
    LD A, 0x7F
    ADD A, (IX+0x05)    ; 0x8000 + 5 = 0x8005

    PUSH AF
    POP DE              

    CP 0xFD
    JP NZ, ERROR

    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 2: Negative Offset (0xFB = -0x05) ---
    ; Math: 0x7F + 0x81 = 0x00
    ; Reads from TEST_RAM_MINUS_5 (0x7FFB)
    LD A, 0x81
    LD (TEST_RAM_MINUS_5), A 
    
    LD A, 0x7F
    ADD A, (IX-5)    ; 0x8000 - 5 = 0x7FFB

    PUSH AF
    POP DE

    CP 0x00
    JP NZ, ERROR

    ; Expected Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    ; --- Case 3: Positive Offset (+0x05) ---
    ; Math: 0x12 + 0x34 = 0x46
    ; Reads from TEST_RAM_PLUS_5 (0x8005)
    LD A, 0x34
    LD (TEST_RAM_PLUS_5), A 
    
    LD A, 0x12
    ADD A, (IX+0x05)    ; 0x8000 + 5 = 0x8005

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP NZ, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    RET

TEST_ADD_A_IY_D:
    LD IY, TEST_RAM     ; Point IY to base RAM address (0x8000)

    ; --- Case 1: Negative Offset (0xFB = -0x05) ---
