    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1235 = 0x2469 ---
    ; Expected: Clears H, clears C. S, Z, P/V unchanged. N is reset.
    LD IY, 0x1234
    LD BC, 0x1235
    LD HL, 0x00C4   ; L = Initial flags (S=1, Z=1, H=0, P/V=1, N=0, C=0)
    PUSH HL
    POP AF

    ADD IY, BC

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x69
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    ; Expected: Sets H, sets C. S, Z, P/V unchanged. N is reset.
    LD IY, 0xFFFF
    LD BC, 0x0001
    LD HL, 0x0080   ; L = Initial flags (S=1, Z=0, H=0, P/V=0, N=0, C=0)
    PUSH HL
    POP AF

    ADD IY, BC

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    RET

TEST_ADD_IY_DE:
    ; --- Case 1: 0x0900 + 0x0800 = 0x1100 ---
    LD IY, 0x0900
    LD DE, 0x0800
    LD HL, 0x0040   
    PUSH HL
    POP AF

    ADD IY, DE

    PUSH AF
    POP HL          ; L = New flags
    PUSH IY
    POP BC          ; BC = Result

    LD A, B
    CP 0x11
    JP NZ, ERROR
    LD A, C
    CP 0x00
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, L        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, L        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, L        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x8000 = 0x1000 ---
    LD IY, 0x9000
    LD DE, 0x8000
    LD HL, 0x0044   
    PUSH HL
    POP AF

    ADD IY, DE

    PUSH AF
    POP HL          
    PUSH IY
    POP BC          

    LD A, B
    CP 0x10
    JP NZ, ERROR
    LD A, C
    CP 0x00
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, L        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, L        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, L        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1235 = 0x2469 ---
    LD IY, 0x1234
    LD DE, 0x1235
    LD HL, 0x00C4   
    PUSH HL
    POP AF

    ADD IY, DE

    PUSH AF
    POP HL          
    PUSH IY
    POP BC          

    LD A, B
    CP 0x24
    JP NZ, ERROR
    LD A, C
    CP 0x69
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, L        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, L        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, L        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    LD IY, 0xFFFF
    LD DE, 0x0001
    LD HL, 0x0080   
    PUSH HL
    POP AF

    ADD IY, DE

    PUSH AF
    POP HL          
    PUSH IY
    POP BC          

    LD A, B
    CP 0x00
    JP NZ, ERROR
    LD A, C
    CP 0x00
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, L        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, L        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, L        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Set: 1)
    JP Z, ERROR

    RET

TEST_ADD_IY_SP:
    ; --- Case 1: 0x0900 + 0x0800 = 0x1100 ---
    LD (TEMP_SP_SAVE), SP 
    LD IY, 0x0900
    LD HL, 0x0040   
    PUSH HL
    POP AF              
    LD SP, 0x0800       
    
    ADD IY, SP          
    
    LD (SP_RESULT_ADDR), IY 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              ; E = New flags
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x11
    JP NZ, ERROR
    
    BIT 7, E        ; S (0)
    JP NZ, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (1)
    JP Z, ERROR
    BIT 2, E        ; P/V (0)
    JP NZ, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x8000 = 0x1000 ---
    LD (TEMP_SP_SAVE), SP 
    LD IY, 0x9000
    LD HL, 0x0044   
    PUSH HL
    POP AF              
    LD SP, 0x8000       
    
    ADD IY, SP          
    
    LD (SP_RESULT_ADDR), IY 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x10
    JP NZ, ERROR
    
    BIT 7, E        ; S (0)
    JP NZ, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (1)
    JP Z, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1235 = 0x2469 ---
    LD (TEMP_SP_SAVE), SP 
    LD IY, 0x1234
    LD HL, 0x00C4   
    PUSH HL
    POP AF              
    LD SP, 0x1235       
    
    ADD IY, SP          
    
    LD (SP_RESULT_ADDR), IY 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x69
    JP NZ, ERROR

    BIT 7, E        ; S (1)
    JP Z, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (1)
    JP Z, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    LD (TEMP_SP_SAVE), SP 
    LD IY, 0xFFFF
    LD HL, 0x0080   
    PUSH HL
    POP AF              
    LD SP, 0x0001       
    
    ADD IY, SP          
    
    LD (SP_RESULT_ADDR), IY 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (1)
    JP Z, ERROR
    BIT 6, E        ; Z (0)
    JP NZ, ERROR
    BIT 4, E        ; H (1)
    JP Z, ERROR
    BIT 2, E        ; P/V (0)
    JP NZ, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (1)
    JP Z, ERROR

    RET

TEST_ADD_IY_IY:
    ; --- Case 1: 0x0900 + 0x0900 = 0x1200 ---
    LD IY, 0x0900
    LD HL, 0x0040   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x12
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x9000 = 0x2000 ---
    LD IY, 0x9000
    LD HL, 0x0044   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x20
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1234 = 0x2468 ---
    LD IY, 0x1234
    LD HL, 0x00C4   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x68
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0xFFFF = 0xFFFE ---
    LD IY, 0xFFFF
    LD HL, 0x0080   
    PUSH HL
    POP AF

    ADD IY, IY

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
    CP 0xFF
    JP NZ, ERROR
    LD A, L
    CP 0xFE
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    RET

TEST_ADD_HL_BC: ; Covers ADD HL, BC
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    LD HL, 0x1030
    LD BC, 0x0204
    LD DE, 0x00FF   ; D=0, E=Initial Flags
    PUSH DE
    POP AF          ; Load Flags

    ADD HL, BC

    PUSH AF
    POP DE          ; E = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 6, E        ; Z flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V/P flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; CASE 2: Half-Carry (Bit 11) (0x0800 + 0x0800)
    LD HL, 0x0800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x1000)
    LD A, H
    XOR 0x10
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; CASE 3: Half and Full Carry (0xF800 + 0x0800)
    LD HL, 0xF800
    LD BC, 0x0800
    LD DE, 0x0000
    PUSH DE
    POP AF

    ADD HL, BC

    PUSH AF
    POP DE

    ; Verify Result (0x0000)
    LD A, H
    XOR 0x00
    JP NZ, ERROR
    LD A, L
    XOR 0x00
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR

    RET

TEST_ADD_HL_DE:
    ; CASE 1: No Carry, No Half-Carry (0x1030 + 0x0204)
    LD HL, 0x1030
    LD DE, 0x0204
    LD BC, 0x00FF   ; B=0, C=Initial Flags
    PUSH BC
    POP AF          ; Load Flags

    ADD HL, DE

    PUSH AF
    POP BC          ; C = Resulting Flags
    
    ; Verify Result (0x1234)
    LD A, H
    XOR 0x12
    JP NZ, ERROR
    LD A, L
    XOR 0x34
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
