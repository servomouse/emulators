    JP NZ, ERROR
    BIT 4, C        ; H flag (1)
    JP Z, ERROR
    BIT 2, C        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, C        ; N flag (1)
    JP Z, ERROR
    BIT 0, C        ; C flag (0)
