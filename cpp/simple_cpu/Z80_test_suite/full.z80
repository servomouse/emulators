TEST_INC_H:
    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD BC, 0x0200   ; B = expected result (02), C = flags to load (00)
    LD H, 0x01
    PUSH BC
    POP AF          ; A = 02, Flags = 00

    INC H
    
    PUSH AF
    POP BC          ; C now contains Flags
    
    ; Verify result (A XOR H)
    XOR H
    JP NZ, ERROR

    ; Verify Flags: Z=0, S=0, H=0, V=0, N=0, C=0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Zero (0xFF -> 0x00) ---
    LD BC, 0x00FF   ; B = expected result (00), C = flags to load (FF)
    LD H, 0xFF
    PUSH BC
    POP AF

    INC H           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR H
    JP NZ, ERROR
    
    ; Verify Flags: Z=1, S=0, H=1, V=0, N=0, C stays 1
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; --- Case 3: Overflow (0x7F -> 0x80) ---
    LD BC, 0x8000   ; B = expected result (80), C = flags to load (00)
    LD H, 0x7F
    PUSH BC
    POP AF

    INC H           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR H
    JP NZ, ERROR
    
    ; Verify Flags: Z=0, S=1, H=1, V=1, N=0, C stays 0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    RET

TEST_INC_L:
    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD BC, 0x0200   ; B = expected result (02), C = flags to load (00)
    LD L, 0x01
    PUSH BC
    POP AF          ; A = 02, Flags = 00

    INC L
    
    PUSH AF
    POP BC          ; C now contains Flags
    
    ; Verify result (A XOR H)
    XOR L
    JP NZ, ERROR

    ; Verify Flags: Z=0, S=0, H=0, V=0, N=0, C=0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Zero (0xFF -> 0x00) ---
    LD BC, 0x00FF   ; B = expected result (00), C = flags to load (FF)
    LD L, 0xFF
    PUSH BC
    POP AF

    INC L           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR L
    JP NZ, ERROR
    
    ; Verify Flags: Z=1, S=0, H=1, V=0, N=0, C stays 1
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    ; --- Case 3: Overflow (0x7F -> 0x80) ---
    LD BC, 0x8000   ; B = expected result (80), C = flags to load (00)
    LD L, 0x7F
    PUSH BC
    POP AF

    INC L           
    
    PUSH AF
    POP BC          ; C contains Flags
    
    XOR L
    JP NZ, ERROR
    
    ; Verify Flags: Z=0, S=1, H=1, V=1, N=0, C stays 0
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    RET

TEST_INC_MEM_HL:
    ; Setup: Point HL to a safe scratchpad RAM location
    ; For this example, let's assume 0xC000 is safe.
    LD HL, 0xC000

    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD (HL), 0x01
    LD BC, 0x0200   ; B = expected result (02), C = flags to load (00)
    PUSH BC
    POP AF          ; Flags cleared

    INC (HL)
    
    PUSH AF
    POP DE          ; E now contains Flags
    
    ; Verify memory result
    LD A, (HL)
    XOR B            ; Compare (HL) with 0x02
    JP NZ, ERROR

    ; Verify Flags: Z=0, S=0, H=0, V=0, N=0, C=0
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Zero (0xFF -> 0x00) ---
    LD (HL), 0xFF
    LD BC, 0x00FF   ; B = expected result (00), C = flags to load (FF)
    PUSH BC
    POP AF

    INC (HL)
    
    PUSH AF
    POP DE          ; E contains Flags
    
    ; Verify memory result
    LD A, (HL)
    XOR B
    JP NZ, ERROR
    
    ; Verify Flags: Z=1, S=0, H=1, V=0, N=0, C stays 1
    BIT 6, E        ; Z flag
    JP Z, ERROR     ; Must be set
    BIT 4, E        ; H flag
    JP Z, ERROR     ; Must be set
    BIT 2, E        ; V flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR     ; Must stay set

    ; --- Case 3: Overflow (0x7F -> 0x80) ---
    LD (HL), 0x7F
    LD BC, 0x8000   ; B = expected result (80), C = flags to load (00)
    PUSH BC
    POP AF

    INC (HL)
    
    PUSH AF
    POP DE          ; E contains Flags
    
    ; Verify memory result
    LD A, (HL)
    XOR B
    JP NZ, ERROR
    
    ; Verify Flags: Z=0, S=1, H=1, V=1, N=0, C stays 0
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR

    RET

TEST_INC_IX_D:
    LD IX, TEST_RAM     ; Point IX to base RAM address

    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD A, 0x01
    LD (TEST_RAM_PLUS_5), A ; Write 0x01 directly to 0x8005
    
    LD DE, 0x00FF       ; E = Initial Flags (0xFF, testing N flag clearing)
    PUSH DE
    POP AF              

    INC (IX+0x05)       ; Target address should calculate to 0x8005
    
    PUSH AF         
    POP DE              ; E = New Flags

    ; Verify Result via absolute address
    LD A, (TEST_RAM_PLUS_5) 
    CP 0x02         
    JP NZ, ERROR    

    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 0, INC ALWAYS clears N)
    JP NZ, ERROR
    BIT 0, E        ; C flag (Expected: 1, preserves initial 1)
    JP Z, ERROR

    ; --- Case 2: Overflow (0x7F -> 0x80) ---
    ; Tests the specific edge case where a positive signed byte increments to negative
    LD A, 0x7F
    LD (TEST_RAM_PLUS_5), A 
    
    LD DE, 0x0000       ; E = Initial Flags (0x00)
    PUSH DE
    POP AF              

    INC (IX+0x05)       
    
    PUSH AF         
    POP DE              

    LD A, (TEST_RAM_PLUS_5)     
    CP 0x80         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (Expected: 1, 0x80 is negative)
    JP Z, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1, 0x7F to 0x80 carries from bit 3)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 1, OVERFLOW!)
    JP Z, ERROR
    BIT 1, E        ; N flag (Expected: 0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (Expected: 0, preserves initial 0)
    JP NZ, ERROR

    ; --- Case 3: Zero Wrap (0xFF -> 0x00) ---
    LD A, 0xFF
    LD (TEST_RAM_PLUS_5), A 
    
    LD DE, 0x00FF       ; E = Initial Flags (0xFF)
    PUSH DE
    POP AF              

    INC (IX+0x05)       
    
    PUSH AF
    POP DE              

    LD A, (TEST_RAM_PLUS_5)     
    CP 0x00         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 1, result is zero)
    JP Z, ERROR
    BIT 4, E        ; H flag (Expected: 1, 0xFF to 0x00 carries from bit 3)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 0, wrapping to 0 is not signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (Expected: 1, preserves initial 1)
    JP Z, ERROR

    RET

TEST_INC_IY_D:
    LD IY, TEST_RAM     ; Point IY to base RAM address

    ; --- Case 1: Standard Increment (0x01 -> 0x02) ---
    LD A, 0x01
    LD (TEST_RAM_MINUS_5), A ; Write 0x01 directly to 0x7FFB
    
    LD DE, 0x00FF       ; E = Initial Flags (0xFF)
    PUSH DE
    POP AF              

    INC (IY-5)       ; Target address should calculate to 0x7FFB
    
    PUSH AF         
    POP DE              ; E = New Flags

    LD A, (TEST_RAM_MINUS_5) 
    CP 0x02         
    JP NZ, ERROR    

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 2: Overflow (0x7F -> 0x80) ---
    LD A, 0x7F
    LD (TEST_RAM_MINUS_5), A 
    
    LD DE, 0x0000       ; E = Initial Flags (0x00)
    PUSH DE
    POP AF              

    INC (IY-5)       
    
    PUSH AF         
    POP DE              

    LD A, (TEST_RAM_MINUS_5)     
    CP 0x80         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (1, OVERFLOW)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 3: Zero Wrap (0xFF -> 0x00) ---
    LD A, 0xFF
    LD (TEST_RAM_MINUS_5), A 
    
    LD DE, 0x00FF       ; E = Initial Flags (0xFF)
    PUSH DE
    POP AF              

    INC (IY-5)       
    
    PUSH AF
    POP DE              

    LD A, (TEST_RAM_MINUS_5)     
    CP 0x00         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    RET

; 16-bit increment opcodes:
TEST_INC_BC:
    ; --- Case 1: Basic Increment and Flag Preservation ---
    LD BC, 0x0000
    
    ; Set a known flag state
    LD HL, 0x0000
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x00
    XOR B
    JP NZ, ERROR
    LD A, 0x01
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all cleared

    BIT 6, L        ; Z flag
    JP NZ, ERROR
    BIT 7, L        ; S flag
    JP NZ, ERROR
    BIT 4, L        ; H flag
    JP NZ, ERROR
    BIT 2, L        ; V/P flag
    JP NZ, ERROR
    BIT 1, L        ; N flag
    JP NZ, ERROR
    BIT 0, L        ; C flag
    JP NZ, ERROR

    ; --- Case 2: Basic Increment and Flag Preservation ---
    LD BC, 0x1234
    
    ; Set a known flag state
    LD HL, 0x00FF
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x12
    XOR B
    JP NZ, ERROR
    LD A, 0x35
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all set

    BIT 6, L        ; Z flag
    JP Z, ERROR
    BIT 7, L        ; S flag
    JP Z, ERROR
    BIT 4, L        ; H flag
    JP Z, ERROR
    BIT 2, L        ; V/P flag
    JP Z, ERROR
    BIT 1, L        ; N flag
    JP Z, ERROR
    BIT 0, L        ; C flag
    JP Z, ERROR

    ; --- Case 3: LSB overflow and Flag Preservation ---
    LD BC, 0x12FF
    
    ; Set a known flag state
    LD HL, 0x00FF
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x13
    XOR B
    JP NZ, ERROR
    LD A, 0x00
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all set

    BIT 6, L        ; Z flag
    JP Z, ERROR
    BIT 7, L        ; S flag
    JP Z, ERROR
    BIT 4, L        ; H flag
    JP Z, ERROR
    BIT 2, L        ; V/P flag
    JP Z, ERROR
    BIT 1, L        ; N flag
    JP Z, ERROR
    BIT 0, L        ; C flag
    JP Z, ERROR

    ; --- Case 4: Sign overflow and Flag Preservation ---
    LD BC, 0x7FFF
    
    ; Set a known flag state
    LD HL, 0x0000
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x80
    XOR B
    JP NZ, ERROR
    LD A, 0x00
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all cleared

    BIT 6, L        ; Z flag
    JP NZ, ERROR
    BIT 7, L        ; S flag
    JP NZ, ERROR
    BIT 4, L        ; H flag
    JP NZ, ERROR
    BIT 2, L        ; V/P flag
    JP NZ, ERROR
    BIT 1, L        ; N flag
    JP NZ, ERROR
    BIT 0, L        ; C flag
    JP NZ, ERROR

    ; --- Case 5: Full overflow and Flag Preservation ---
    LD BC, 0xFFFF
    
    ; Set a known flag state
    LD HL, 0x00FF
    PUSH HL
    POP AF
    
    INC BC
    ; Move flags to L
    PUSH AF
    POP HL
    
    ; Verify Result
    LD A, 0x00
    XOR B
    JP NZ, ERROR
    LD A, 0x00
    XOR C
    JP NZ, ERROR
    
    ; Verify Flags: Must be all set

    BIT 6, L        ; Z flag
    JP Z, ERROR
    BIT 7, L        ; S flag
    JP Z, ERROR
    BIT 4, L        ; H flag
    JP Z, ERROR
    BIT 2, L        ; V/P flag
    JP Z, ERROR
    BIT 1, L        ; N flag
    JP Z, ERROR
    BIT 0, L        ; C flag
    JP Z, ERROR

    RET

TEST_INC_DE:
    ; --- Case 1: Standard Increment (0x0001 -> 0x0002) ---
    LD DE, 0x0001   
    LD HL, 0x00FF   ; L = 0xFF (Initial flags set to 1)
    PUSH HL
    POP AF          

    INC DE          ; Execute Opcode: DE = DE + 1. DE becomes 0x0002.
    
    PUSH AF
    POP HL          ; L = Preserved Flags

    ; Verify Result 
    LD A, D
    CP 0x00
    JP NZ, ERROR
    LD A, E
    CP 0x02
    JP NZ, ERROR

    ; Verify Flags (Expected: all 1)
    BIT 7, L        
    JP Z, ERROR
    BIT 6, L        
    JP Z, ERROR
    BIT 4, L        
    JP Z, ERROR
    BIT 2, L        
    JP Z, ERROR
    BIT 1, L        
    JP Z, ERROR
    BIT 0, L        
    JP Z, ERROR

    ; --- Case 2: Byte Boundary / Half-Carry (0x00FF -> 0x0100) ---
    LD DE, 0x00FF
    LD HL, 0x0000   ; L = 0x00 (Initial flags set to 0)
    PUSH HL
    POP AF          

    INC DE          
    
    PUSH AF
    POP HL          

    ; Verify Result
    LD A, D
    CP 0x01
    JP NZ, ERROR
    LD A, E
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags (Expected: all 0)
    BIT 7, L        
    JP NZ, ERROR
    BIT 6, L        
    JP NZ, ERROR
    BIT 4, L        
    JP NZ, ERROR
    BIT 2, L        
    JP NZ, ERROR
    BIT 1, L        
    JP NZ, ERROR
    BIT 0, L        
    JP NZ, ERROR

    ; --- Case 3: 16-bit Wrap / Overflow (0xFFFF -> 0x0000) ---
    LD DE, 0xFFFF
    LD HL, 0x0055   ; L = 0x55 
    PUSH HL
    POP AF          

    INC DE          
    
    PUSH AF
    POP HL          

    ; Verify Result
    LD A, D
    CP 0x00
    JP NZ, ERROR
    LD A, E
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags (Expected: S=0, Z=1, H=1, P/V=1, N=0, C=1)
    BIT 7, L        
    JP NZ, ERROR
    BIT 6, L        
    JP Z, ERROR
    BIT 4, L        
    JP Z, ERROR
    BIT 2, L        
    JP Z, ERROR
    BIT 1, L        
    JP NZ, ERROR
    BIT 0, L        
    JP Z, ERROR

    RET

TEST_INC_HL:
    ; --- Case 1: Standard Increment (0x0001 -> 0x0002) ---
