TEST_DEC_MEM_HL:
    LD HL, TEST_RAM ; Point HL to our writable memory location

    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD (HL), 0x01   ; Initial memory value
    LD DE, 0x0000   ; E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC (HL)        ; Execute Opcode: (HL) = (HL) - 1. Memory becomes 0x00.
    
    PUSH AF         ; Push the newly generated flags to the stack
    POP DE          ; Pop into DE. E = New Flags

    ; Verify Result
    LD A, (HL)      ; Read the modified memory byte back into A
    CP 0x00         ; Compare with 0x00
    JP NZ, ERROR    ; Error if result is not 0x00

    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 1)
    JP Z, ERROR
    BIT 4, E        ; H flag (Expected: 0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD (HL), 0x00   ; Initial memory value
    LD DE, 0x00FF   ; E = Initial Flags (0xFF)
    PUSH DE
    POP AF          ; Flags = 0xFF

    DEC (HL)        ; Execute Opcode: 0x00 - 1 = 0xFF. 
    
    PUSH AF         
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, (HL)      
    CP 0xFF         
    JP NZ, ERROR    
    
    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 1, preserves initial 1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD (HL), 0x80   ; Initial memory value
    LD DE, 0x0000   ; E = Initial Flags (0x00)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC (HL)        ; Execute Opcode: 0x80 - 1 = 0x7F.
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, (HL)      
    CP 0x7F         
    JP NZ, ERROR    
    
    ; Verify Flags stored in E:
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 1, OVERFLOW!)
    JP Z, ERROR
    BIT 1, E        ; N flag (Expected: 1)
    JP Z, ERROR
    BIT 0, E        ; C flag (Expected: 0)
    JP NZ, ERROR

    RET

TEST_DEC_IX_D:
    LD IX, TEST_RAM     ; Point IX to base RAM address

    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    ; Setup memory via absolute address to isolate the test to DEC (IX+d)
    LD A, 0x01
    LD (TEST_RAM_PLUS_5), A ; Write 0x01 directly to 0x8005
    
    LD DE, 0x0000       ; E = Initial Flags (0x00)
    PUSH DE
    POP AF              

    DEC (IX+0x05)       ; Target address should calculate to 0x8005
    
    PUSH AF         
    POP DE              ; E = New Flags

    ; Verify Result via absolute address
    LD A, (TEST_RAM_PLUS_5) ; Read back directly from 0x8005
    CP 0x00         
    JP NZ, ERROR    

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD A, 0x00
    LD (TEST_RAM_PLUS_5), A 
    
    LD DE, 0x00FF       
    PUSH DE
    POP AF              

    DEC (IX+0x05)       
    
    PUSH AF         
    POP DE              

    LD A, (TEST_RAM_PLUS_5)     
    CP 0xFF         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD A, 0x80
    LD (TEST_RAM_PLUS_5), A 
    
    LD DE, 0x0000       
    PUSH DE
    POP AF              

    DEC (IX+0x05)       
    
    PUSH AF
    POP DE              

    LD A, (TEST_RAM_PLUS_5)     
    CP 0x7F         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    RET

TEST_DEC_IY_D:
    LD IY, TEST_RAM     ; Point IY to base RAM address (0x8000)

    ; --- Case 1: Standard Decrement (0x01 -> 0x00) ---
    LD A, 0x01
    LD (TEST_RAM_MINUS_5), A ; Write 0x01 directly to 0x7FFB (0x8000 - 5)
    
    LD DE, 0x0000       ; E = Initial Flags (0x00)
    PUSH DE
    POP AF              

    DEC (IY-5)       ; Target address should calculate to 0x7FFB
    
    PUSH AF         
    POP DE              ; E = New Flags

    ; Verify Result via absolute address
    LD A, (TEST_RAM_MINUS_5) ; Read back directly from 0x7FFB
    CP 0x00         
    JP NZ, ERROR    

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: Half-Carry and Wrap (0x00 -> 0xFF) ---
    LD A, 0x00
    LD (TEST_RAM_MINUS_5), A  
    
    LD DE, 0x00FF       
    PUSH DE
    POP AF              

    DEC (IY-5)       
    
    PUSH AF         
    POP DE              

    LD A, (TEST_RAM_MINUS_5)     
    CP 0xFF         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: Overflow (0x80 -> 0x7F) ---
    LD A, 0x80
    LD (TEST_RAM_MINUS_5), A 
    
    LD DE, 0x0000       
    PUSH DE
    POP AF              

    DEC (IY-5)       
    
    PUSH AF
    POP DE              

    LD A, (TEST_RAM_MINUS_5)     
    CP 0x7F         
    JP NZ, ERROR    
    
    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (1)
    JP Z, ERROR
    BIT 1, E        ; N flag (1)
    JP Z, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    RET

; 16-bit decrement opcodes:
TEST_DEC_BC:
    ; --- Case 1: Standard Decrement (0x0002 -> 0x0001) ---
    LD BC, 0x0002   ; Initial 16-bit value
    LD DE, 0x00FF   ; D = dummy A, E = 0xFF (Initial flags set to 1)
    PUSH DE
    POP AF          ; Flags = 0xFF

    DEC BC          ; Execute Opcode: BC = BC - 1. BC becomes 0x0001.
    
    PUSH AF
    POP DE          ; Extract flags into E.

    ; Verify Result 
    LD A, B
    CP 0x00
    JP NZ, ERROR
    LD A, C
    CP 0x01
    JP NZ, ERROR

    ; Verify Flags (Expected: all documented flags should remain 1)
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 6, E        ; Z flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP Z, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR

    ; --- Case 2: Byte Boundary / Borrow (0x0100 -> 0x00FF) ---
    LD BC, 0x0100
    LD DE, 0x0000   ; E = 0x00 (Initial flags set to 0)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC BC          ; Execute Opcode: BC becomes 0x00FF.
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, B
    CP 0x00
    JP NZ, ERROR
    LD A, C
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: all documented flags should remain 0)
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; --- Case 3: 16-bit Wrap / Underflow (0x0000 -> 0xFFFF) ---
    LD BC, 0x0000
    LD DE, 0x0055   ; E = 0x55 (Alternating: 01010101)
    PUSH DE
    POP AF          ; Flags = 0x55

    DEC BC          ; Execute Opcode: BC wraps around to 0xFFFF.
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Verify Result
    LD A, B
    CP 0xFF
    JP NZ, ERROR
    LD A, C
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: S=0, Z=1, H=1, P/V=1, N=0, C=1)
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 1)
    JP Z, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 1)
    JP Z, ERROR
    BIT 1, E        ; N flag (Expected: 0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (Expected: 1)
    JP Z, ERROR

    RET

TEST_DEC_DE:
    ; --- Case 1: Standard Decrement (0x0002 -> 0x0001) ---
    LD DE, 0x0002   
    LD HL, 0x00FF   ; L = 0xFF (Initial flags set to 1)
    PUSH HL
    POP AF          

    DEC DE          
    
    PUSH AF
    POP HL          ; L = Preserved Flags

    ; Verify Result 
    LD A, D
    CP 0x00
    JP NZ, ERROR
    LD A, E
    CP 0x01
    JP NZ, ERROR

    ; Verify Flags (Expected: all 1)
    BIT 7, L        
    JP Z, ERROR
    BIT 6, L        
    JP Z, ERROR
    BIT 4, L        
    JP Z, ERROR
    BIT 2, L        
    JP Z, ERROR
    BIT 1, L        
    JP Z, ERROR
    BIT 0, L        
    JP Z, ERROR

    ; --- Case 2: Byte Boundary / Borrow (0x0100 -> 0x00FF) ---
    LD DE, 0x0100
    LD HL, 0x0000   ; L = 0x00 (Initial flags set to 0)
    PUSH HL
    POP AF          

    DEC DE          
    
    PUSH AF
    POP HL          

    ; Verify Result
    LD A, D
    CP 0x00
    JP NZ, ERROR
    LD A, E
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: all 0)
    BIT 7, L        
    JP NZ, ERROR
    BIT 6, L        
    JP NZ, ERROR
    BIT 4, L        
    JP NZ, ERROR
    BIT 2, L        
    JP NZ, ERROR
    BIT 1, L        
    JP NZ, ERROR
    BIT 0, L        
    JP NZ, ERROR

    ; --- Case 3: 16-bit Wrap / Underflow (0x0000 -> 0xFFFF) ---
    LD DE, 0x0000
    LD HL, 0x0055   ; L = 0x55 
    PUSH HL
    POP AF          

    DEC DE          
    
    PUSH AF
    POP HL          

    ; Verify Result
    LD A, D
    CP 0xFF
    JP NZ, ERROR
    LD A, E
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: S=0, Z=1, H=1, P/V=1, N=0, C=1)
    BIT 7, L        
    JP NZ, ERROR
    BIT 6, L        
    JP Z, ERROR
    BIT 4, L        
    JP Z, ERROR
    BIT 2, L        
    JP Z, ERROR
    BIT 1, L        
    JP NZ, ERROR
    BIT 0, L        
    JP Z, ERROR

    RET

TEST_DEC_HL:
    ; --- Case 1: Standard Decrement (0x0002 -> 0x0001) ---
    LD HL, 0x0002   
    LD DE, 0x00FF   ; E = 0xFF (Initial flags set to 1)
    PUSH DE
    POP AF          

    DEC HL          
    
    PUSH AF
    POP DE          ; E = Preserved Flags

    ; Verify Result 
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x01
    JP NZ, ERROR

    ; Verify Flags (Expected: all 1)
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP Z, ERROR
    BIT 0, E        
    JP Z, ERROR

    ; --- Case 2: Byte Boundary / Borrow (0x0100 -> 0x00FF) ---
    LD HL, 0x0100
    LD DE, 0x0000   ; E = 0x00 (Initial flags set to 0)
    PUSH DE
    POP AF          

    DEC HL          
    
    PUSH AF
    POP DE          

    ; Verify Result
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: all 0)
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP NZ, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 3: 16-bit Wrap / Underflow (0x0000 -> 0xFFFF) ---
    LD HL, 0x0000
    LD DE, 0x0055   ; E = 0x55 
    PUSH DE
    POP AF          

    DEC HL          
    
    PUSH AF
    POP DE          

    ; Verify Result
    LD A, H
    CP 0xFF
    JP NZ, ERROR
    LD A, L
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: S=0, Z=1, H=1, P/V=1, N=0, C=1)
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    RET

TEST_DEC_IX:
    ; --- Case 1: Standard Decrement (0x0002 -> 0x0001) ---
    LD IX, 0x0002   ; Initial 16-bit value
    LD DE, 0x00FF   ; D = dummy A, E = 0xFF (Initial flags set to 1)
    PUSH DE
    POP AF          ; Flags = 0xFF

    DEC IX          ; Execute Opcode: IX = IX - 1. IX becomes 0x0001.
    
    PUSH AF
    POP DE          ; Extract flags into E.

    ; Extract IX result into HL for verification
    PUSH IX
    POP HL

    ; Verify Result 
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x01
    JP NZ, ERROR

    ; Verify Flags (Expected: all documented flags should remain 1)
    BIT 7, E        ; S flag
    JP Z, ERROR
    BIT 6, E        ; Z flag
    JP Z, ERROR
    BIT 4, E        ; H flag
    JP Z, ERROR
    BIT 2, E        ; V/P flag
    JP Z, ERROR
    BIT 1, E        ; N flag
    JP Z, ERROR
    BIT 0, E        ; C flag
    JP Z, ERROR

    ; --- Case 2: Byte Boundary / Borrow (0x0100 -> 0x00FF) ---
    LD IX, 0x0100
    LD DE, 0x0000   ; E = 0x00 (Initial flags set to 0)
    PUSH DE
    POP AF          ; Flags = 0x00

    DEC IX          ; Execute Opcode: IX becomes 0x00FF.
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Extract IX result into HL
    PUSH IX
    POP HL

    ; Verify Result
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: all documented flags should remain 0)
    BIT 7, E        ; S flag
    JP NZ, ERROR
    BIT 6, E        ; Z flag
    JP NZ, ERROR
    BIT 4, E        ; H flag
    JP NZ, ERROR
    BIT 2, E        ; V/P flag
    JP NZ, ERROR
    BIT 1, E        ; N flag
    JP NZ, ERROR
    BIT 0, E        ; C flag
    JP NZ, ERROR

    ; --- Case 3: 16-bit Wrap / Underflow (0x0000 -> 0xFFFF) ---
    LD IX, 0x0000
    LD DE, 0x0055   ; E = 0x55 (Alternating: 01010101)
    PUSH DE
    POP AF          ; Flags = 0x55

    DEC IX          ; Execute Opcode: IX wraps around to 0xFFFF.
    
    PUSH AF
    POP DE          ; E = New Flags

    ; Extract IX result into HL
    PUSH IX
    POP HL

    ; Verify Result
    LD A, H
    CP 0xFF
    JP NZ, ERROR
    LD A, L
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: S=0, Z=1, H=1, P/V=1, N=0, C=1)
    BIT 7, E        ; S flag (Expected: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (Expected: 1)
    JP Z, ERROR
    BIT 4, E        ; H flag (Expected: 1)
    JP Z, ERROR
    BIT 2, E        ; V/P flag (Expected: 1)
    JP Z, ERROR
    BIT 1, E        ; N flag (Expected: 0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (Expected: 1)
    JP Z, ERROR

    RET

TEST_DEC_IY:
    ; --- Case 1: Standard Decrement (0x0002 -> 0x0001) ---
    LD IY, 0x0002   
    LD DE, 0x00FF   ; E = 0xFF (Initial flags set to 1)
    PUSH DE
    POP AF          

    DEC IY          
    
    PUSH AF
    POP DE          ; E = Preserved Flags

    ; Extract IY result into HL for verification
    PUSH IY
    POP HL

    ; Verify Result 
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x01
    JP NZ, ERROR

    ; Verify Flags (Expected: all 1)
    BIT 7, E        
    JP Z, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP Z, ERROR
    BIT 0, E        
    JP Z, ERROR

    ; --- Case 2: Byte Boundary / Borrow (0x0100 -> 0x00FF) ---
    LD IY, 0x0100
    LD DE, 0x0000   ; E = 0x00 (Initial flags set to 0)
    PUSH DE
    POP AF          

    DEC IY          
    
    PUSH AF
    POP DE          

    ; Extract IY result into HL
    PUSH IY
    POP HL

    ; Verify Result
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: all 0)
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP NZ, ERROR
    BIT 4, E        
    JP NZ, ERROR
    BIT 2, E        
    JP NZ, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP NZ, ERROR

    ; --- Case 3: 16-bit Wrap / Underflow (0x0000 -> 0xFFFF) ---
    LD IY, 0x0000
    LD DE, 0x0055   ; E = 0x55 
    PUSH DE
    POP AF          

    DEC IY          
    
    PUSH AF
    POP DE          

    ; Extract IY result into HL
    PUSH IY
    POP HL

    ; Verify Result
    LD A, H
    CP 0xFF
    JP NZ, ERROR
    LD A, L
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags (Expected: S=0, Z=1, H=1, P/V=1, N=0, C=1)
    BIT 7, E        
    JP NZ, ERROR
    BIT 6, E        
    JP Z, ERROR
    BIT 4, E        
    JP Z, ERROR
    BIT 2, E        
    JP Z, ERROR
    BIT 1, E        
    JP NZ, ERROR
    BIT 0, E        
    JP Z, ERROR

    RET

TEST_DEC_SP:
    ; Save real SP to restore later
    LD HL, 0
    ADD HL, SP
    LD (TEMP_SP_SAVE), HL

    ; --- Case 1: Flag Preservation and Wrap (0x0000 -> 0xFFFF) ---
    LD SP, 0x0000
    LD BC, 0x00FF   ; B = Expected Low byte (FF - checked via SP), C = Flags (FF)
    PUSH BC
    POP AF          ; Load flags with 0xFF

    DEC SP
    
    ; Verify Flags: Must still be 0xFF
    PUSH AF
    POP BC
    LD A, C
    XOR 0xFF
    JP NZ, ERROR

    ; Verify Result: SP should be 0xFFFF
    LD HL, 0
    ADD HL, SP      ; HL now equals SP
    LD A, H
    XOR 0xFF
    JP NZ, ERROR
    LD A, L
    XOR 0xFF
    JP NZ, ERROR

    ; Restore original SP
    LD HL, (TEMP_SP_SAVE)
    LD SP, HL
    RET

; MISC opcodes:
TEST_EX_AF_AF:  ; Covers 0x08
    ; --- Step 1: Initialize AF' ---
    ; We need to get values into AF' first. 
    ; We load them into AF, then swap them to the shadow side.
    LD BC, 0xAA00   ; B = 0xAA (Future A'), C = 0x00 (Will hold flags)
    ; We can't easily force 0xBB into F' directly without pushing/popping,
    ; so let's use the stack to prime our initial AF state.

    LD DE, 0xAABB
    PUSH DE
    POP AF
    EX AF, AF'

    LD DE, 0x1122   ; D = A value (0x11), E = F value (0x22)
    PUSH DE
    POP AF          ; Main AF is now 0x1122

    EX AF, AF'

    PUSH AF
    POP BC
    
    LD A, B
    XOR 0xAA
    JP NZ, ERROR
    
    LD A, C
    XOR 0xBB
    JP NZ, ERROR

    EX AF, AF'
    PUSH AF
    POP BC

    LD A, B
    XOR 0x11
    JP NZ, ERROR
    
    LD A, C
    XOR 0x22
    JP NZ, ERROR

    RET

TEST_EXX:   ; Covers 0xD9
    LD BC, 0x1111
    LD DE, 0x2222
    LD HL, 0x3333
    EXX

    LD DE, 0x00FF   ; Set flags
    PUSH DE
    POP AF

    LD BC, 0xAAAA
    LD DE, 0xBBBB
    LD HL, 0xCCCC

    EXX
    PUSH AF         ; Save flags to check them later

    LD A, B
    XOR 0x11
    JP NZ, ERROR
    LD A, C
    XOR 0x11
    JP NZ, ERROR

    LD A, D
    XOR 0x22
    JP NZ, ERROR
    LD A, E
    XOR 0x22
    JP NZ, ERROR

    LD A, H
    XOR 0x33
    JP NZ, ERROR
    LD A, L
    XOR 0x33
    JP NZ, ERROR

    POP BC          ; C = Current Flags
    LD A, C
    XOR 0xFF
    JP NZ, ERROR

    LD DE, 0x0000   ; Clear flags
    PUSH DE
    POP AF          

    EXX             ; Swap back to pull shadow values into main view
    PUSH AF         ; Save flags to check them later

    LD A, B
    XOR 0xAA
    JP NZ, ERROR
    LD A, C
    XOR 0xAA
    JP NZ, ERROR

    LD A, D
    XOR 0xBB
    JP NZ, ERROR
    LD A, E
    XOR 0xBB
    JP NZ, ERROR

    LD A, H
    XOR 0xCC
    JP NZ, ERROR
    LD A, L
    XOR 0xCC
    JP NZ, ERROR

    POP BC          ; C = Current Flags
    LD A, C
    XOR 0x00
    JP NZ, ERROR

    RET

TEST_CPL:   ; Covers 0x2F
    ; =========================================================
    ; CASE 1: 0x55 -> 0xAA (All bits flipped)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0xAA, Flags: H=1, N=1 (Others remain 0)
    ; =========================================================
    LD BC, 0x5500   ; B = Initial A (0x55), C = Initial Flags (0x00)
    PUSH BC
    POP AF

    CPL

    PUSH AF
    POP BC          ; C = Resulting Flags

    ; Verify Result (0xAA)
    XOR 0xAA
    JP NZ, ERROR

    ; Verify Flags: H and N must be set to 1. All others must be 0.
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag (Must be set by CPL)
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag (Must be set by CPL)
    JP Z, ERROR
    BIT 0, C        ; C flag
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: 0xAA -> 0x55 
    ; PRE-CONDITION: Set all flags (0xFF)
    ; Expected Result: 0x55, Flags: S=1, Z=1, V=1, H=1, N=1, C=1
    ; =========================================================
    LD BC, 0xAAFF   ; B = Initial A (0xAA), C = Initial Flags (0xFF)
    PUSH BC
    POP AF

    CPL

    PUSH AF
    POP BC          ; C = Resulting Flags

    ; Verify Result (0x55)
    XOR 0x55
    JP NZ, ERROR

    ; Verify Flags: S, Z, V, C are preserved (1). H and N are forced to 1.
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP Z, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP Z, ERROR
    BIT 0, C        ; C flag
    JP Z, ERROR

    RET

TEST_DAA:   ; Covers 0x27
    ; =========================================================
    ; CASE 1: Post-Addition Adjustment (0x98 + 0x22 = 0xBA -> 120)
    ; =========================================================
    LD BC, 0x90000   ; Clear flags
    PUSH BC
    POP AF

    LD A, 0x98
    ADD A, 0x22
    LD D, A         ; Copy the result to D

    DAA

    PUSH AF
    POP BC          ; C = Resulting Flags

    ; Verify Flags first
    BIT 7, C        ; S flag
    JP NZ, ERROR    ; Result is positive
    BIT 6, C        ; Z flag
    JP NZ, ERROR    ; Result is non-zero
    BIT 4, C        ; H flag
    JP Z, ERROR     ; Expected to be set
    BIT 2, C        ; V/P flag
    JP Z, ERROR     ; Parity should be 1
    BIT 1, C        ; N flag
    JP NZ, ERROR    ; Not affected, should stay 0 after ADD
    BIT 0, C        ; C flag
    JP Z, ERROR     ; Result (120) is greater than 99 -> C should be set

    LD A, B
    XOR 0x20        ; Verify the adjusted result (0x20)
    JP NZ, ERROR

    LD A, D
    XOR 0xBA        ; Verify that addition was correct
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: Post-Subtraction Adjustment (0x92 - 0x18 = 0x7A -> 74)
    ; =========================================================
    LD BC, 0x0000   ; Clean flags
    PUSH BC
    POP AF

    LD A, 0x92
    SUB 0x18
    LD D, A         ; Copy the result to D

    DAA

    PUSH AF
    POP BC

    ; Verify flags first
    BIT 7, C        ; S flag
    JP NZ, ERROR    ; Result is negative
    BIT 6, C        ; Z flag
    JP NZ, ERROR    ; Result is not zero
    BIT 4, C        ; H flag
    JP Z, ERROR     ; Should be set
    BIT 2, C        ; V/P flag
    JP Z, ERROR     ; Parity should be 1
    BIT 1, C        ; N flag
    JP Z, ERROR     ; Not affected, should stay 1 after SUB
    BIT 0, C        ; C flag
    JP NZ, ERROR

    LD A, B
    XOR 0x74        ; Verify adjusted result (0x74)
    JP NZ, ERROR

    LD A, D
    XOR 0x7A        ; Verify that subtraction was correct
    JP NZ, ERROR

    RET

; ROT opcodes:
TEST_RLCA:
    ; =========================================================
    ; CASE 1: 0x55 -> 0xAA (Bit 7 is 0, Carry should be 0)
    ; PRE-CONDITION: Set Sign, Zero, Overflow, and Carry (0xC5) to test preservation
    ; Expected Result: 0xAA, Flags: S=1, Z=1, V=1, H=0, N=0, C=0 (C is cleared)
    ; =========================================================
    LD BC, 0x55C5   ; C = Initial Flags (11000101b)
    PUSH BC
    POP AF          ; Load A and Flags

    RLCA            ; Covers 0x07

    PUSH AF
    POP BC          ; C = Resulting Flags

    ; Verify Result (0xAA)
    XOR 0xAA
    JP NZ, ERROR

    ; Verify Flags: S, Z, V preserved (1). H, N, C must be 0.
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Should be cleared because bit 7 of 0x55 was 0)
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: 0xAA -> 0x55 (Bit 7 is 1, Carry should be 1)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x55, Flags: S=0, Z=0, V=0, H=0, N=0, C=1 (C is set)
    ; =========================================================
    LD BC, 0xAA00   ; Clear all flags
    PUSH BC
    POP AF

    RLCA            ; Covers 0x07

    PUSH AF
    POP BC

    ; Verify Result (0x55)
    XOR 0x55
    JP NZ, ERROR

    ; Verify Flags: S, Z, V, H, N must be 0. C must be 1.
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Should be set because bit 7 of 0xAA was 1)
    JP Z, ERROR

    RET

TEST_RRCA:
    ; =========================================================
    ; CASE 1: 0x55 -> 0xAA (Bit 0 is 1, Carry should be 1)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0xAA, Flags: S=0, Z=0, V=0, H=0, N=0, C=1 (C is set)
    ; =========================================================
    LD BC, 0x5500   ; Clear all flags
    PUSH BC
    POP AF

    RRCA            ; Covers 0x0F

    PUSH AF
    POP BC

    ; Verify Result (0xAA)
    XOR 0xAA
    JP NZ, ERROR

    ; Verify Flags: S, Z, V, H, N must be 0. C must be 1.
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Should be set because bit 0 of 0x55 was 1)
    JP Z, ERROR

    ; =========================================================
    ; CASE 2: 0xAA -> 0x55 (Bit 0 is 0, Carry should be 0)
    ; PRE-CONDITION: Set Sign, Zero, Overflow, and Carry (0xC5) to test preservation
    ; Expected Result: 0x55, Flags: S=1, Z=1, V=1, H=0, N=0, C=0 (C is cleared)
    ; =========================================================
    LD BC, 0xAAC5   ; C = Initial Flags (11000101b)
    PUSH BC
    POP AF

    RRCA            ; Covers 0x0F

    PUSH AF
    POP BC

    ; Verify Result (0x55)
    XOR 0x55
    JP NZ, ERROR

    ; Verify Flags: S, Z, V preserved (1). H, N, C must be 0.
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Should be cleared because bit 0 of 0xAA was 0)
    JP NZ, ERROR

    RET

TEST_RLA:
    ; =========================================================
    ; CASE 1: 0x55 with Carry=1 -> 0xAB (Bit 7 is 0 -> New Carry=0)
    ; PRE-CONDITION: Set Sign, Zero, Overflow, and Carry (0xC5)
    ; Expected Result: 0xAB, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD BC, 0x55C5   ; B = Initial A (0x55), C = Initial Flags (Carry is 1)
    PUSH BC
    POP AF          ; Load A and Flags simultaneously

    RLA             ; Covers 0x17

    PUSH AF
    POP BC          ; C = Resulting Flags

    ; Verify Result (0xAB)
    XOR 0xAB
    JP NZ, ERROR

    ; Verify Flags: S, Z, V preserved (1). H, N, C must be 0.
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Bit 7 of 0x55 was 0, so Carry clears)
    JP NZ, ERROR

    ; =========================================================
    ; CASE 2: 0xAA with Carry=0 -> 0x54 (Bit 7 is 1 -> New Carry=1)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x54, Flags: S=0, Z=0, V=0, H=0, N=0, C=1
    ; =========================================================
    LD BC, 0xAA00   ; B = Initial A (0xAA), C = Initial Flags (Carry is 0)
    PUSH BC
    POP AF

    RLA             ; Covers 0x17

    PUSH AF
    POP BC

    ; Verify Result (0x54)
    XOR 0x54
    JP NZ, ERROR

    ; Verify Flags: S, Z, V, H, N must be 0. C must be 1.
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Bit 7 of 0xAA was 1, so Carry sets)
    JP Z, ERROR

    RET

TEST_RRA:
    ; =========================================================
    ; CASE 1: 0x55 with Carry=0 -> 0x2A (Bit 0 is 1 -> New Carry=1)
    ; PRE-CONDITION: Clear all flags (0x00)
    ; Expected Result: 0x2A, Flags: S=0, Z=0, V=0, H=0, N=0, C=1
    ; =========================================================
    LD BC, 0x5500   ; B = Initial A (0x55), C = Initial Flags (Carry is 0)
    PUSH BC
    POP AF

    RRA             ; Covers 0x1F

    PUSH AF
    POP BC

    ; Verify Result (0x2A)
    XOR 0x2A
    JP NZ, ERROR

    ; Verify Flags: S, Z, V, H, N must be 0. C must be 1.
    BIT 7, C        ; S flag
    JP NZ, ERROR
    BIT 6, C        ; Z flag
    JP NZ, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP NZ, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Bit 0 of 0x55 was 1, so Carry sets)
    JP Z, ERROR

    ; =========================================================
    ; CASE 2: 0xAA with Carry=1 -> 0xD5 (Bit 0 is 0 -> New Carry=0)
    ; PRE-CONDITION: Set Sign, Zero, Overflow, and Carry (0xC5)
    ; Expected Result: 0xD5, Flags: S=1, Z=1, V=1, H=0, N=0, C=0
    ; =========================================================
    LD BC, 0xAAC5   ; B = Initial A (0xAA), C = Initial Flags (Carry is 1)
    PUSH BC
    POP AF

    RRA             ; Covers 0x1F

    PUSH AF
    POP BC

    ; Verify Result (0xD5)
    XOR 0xD5
    JP NZ, ERROR

    ; Verify Flags: S, Z, V preserved (1). H, N, C must be 0.
    BIT 7, C        ; S flag
    JP Z, ERROR
    BIT 6, C        ; Z flag
    JP Z, ERROR
    BIT 4, C        ; H flag
    JP NZ, ERROR
    BIT 2, C        ; V/P flag
    JP Z, ERROR
    BIT 1, C        ; N flag
    JP NZ, ERROR
    BIT 0, C        ; C flag (Bit 0 of 0xAA was 0, so Carry clears)
    JP NZ, ERROR

    RET


; SUB 8-bit opcodes:
TEST_SUB_B:
    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD A, 0x20
    LD B, 0x20
    SUB B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD A, 0x70
    LD B, 0x81
    SUB B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow occurred)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD A, 0x55
    LD B, 0x22
    SUB B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

