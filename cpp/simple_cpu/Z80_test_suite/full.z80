    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_CP_N:
    ; --- Case 1: 0x3F CP 0x1E ---
    LD A, 0x3F
    CP 0x1E

    PUSH AF
    POP DE          

    CP 0x3F
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x55 CP 0xAA ---
    LD A, 0x55
    CP 0xAA

    PUSH AF
    POP DE          

    CP 0x55
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set
    JP Z, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be set
    JP Z, ERROR

    ; --- Case 3: 0xF8 CP 0xF8 ---
    LD A, 0xF8
    CP 0xF8

    PUSH AF
    POP DE          

    CP 0xF8
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_CP_A:
    ; --- Single Case: 0xAA CP A = 0x00 internally (S=0, Z=1, H=0, P/V=0, N=1, C=0) ---
    ; Comparing a register to itself always guarantees a result of zero.
    LD A, 0xAA
    CP A

    PUSH AF
    POP DE          ; E = Flags

    ; Verify A was NOT modified
    CP 0xAA
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S should be cleared (result is zero/positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (identical match, result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no lower-nibble borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (unconditionally set on subtraction)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no unsigned borrow)
    JP NZ, ERROR

    RET

TEST_CP_IX_D:
    ; --- Case 1: Positive Offset d=0x05 -> Target: TEST_RAM_PLUS_5 (0x3F CP 0x1E) ---
    LD HL, TEST_RAM_PLUS_5
    LD (HL), 0x1E
    
    LD IX, TEST_RAM
    LD A, 0x3F
    CP (IX+5)       ; d = +5

    PUSH AF
    POP DE          

    CP 0x3F
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: Zero Offset d=0x00 -> Target: TEST_RAM (0x55 CP 0xAA) ---
    LD HL, TEST_RAM
    LD (HL), 0xAA
    
    LD IX, TEST_RAM
    LD A, 0x55
    CP (IX+0)       ; d = 0

    PUSH AF
    POP DE          

    CP 0x55
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set
    JP Z, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be set
    JP Z, ERROR

    ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0xF8 CP 0xF8) ---
    LD HL, TEST_RAM_MINUS_5
    LD (HL), 0xF8
    
    LD IX, TEST_RAM
    LD A, 0xF8
    CP (IX-5)       ; d = -5 (translated to 0xFB)

    PUSH AF
    POP DE          

    CP 0xF8
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_CP_IY_D:
    ; --- Case 1: Positive Offset d=0x05 -> Target: TEST_RAM_PLUS_5 (0x3F CP 0x1E) ---
    LD HL, TEST_RAM_PLUS_5
