    ; Base IY points to TEST_RAM, offset (+5) must land on TEST_RAM_PLUS_5
    LD IY, TEST_RAM
    LD A, 0xF0
    AND (IY+5)      ; OpUT

    PUSH AF
    POP DE          

    CP 0x80
    JP NZ, ERROR
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 3: Negative Offset d=-5 (0xFB) -> Target: TEST_RAM_MINUS_5 (0x1E AND 0xE7 = 0x06) ---
    ; Setup target data in RAM
    LD HL, TEST_RAM_MINUS_5
    LD (HL), 0xE7
    
    ; Base IY points to TEST_RAM, offset (-5) must land on TEST_RAM_MINUS_5
    LD IY, TEST_RAM
    LD A, 0x1E
    AND (IY-5)      ; OpUT

    PUSH AF
    POP DE          

    CP 0x06
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (even parity)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

; XOR opcodes:
TEST_XOR_B:
    ; --- Case 1: 0x5A XOR 0xA5 = 0xFF (Negative, Even Parity, Non-Zero) ---
    LD A, 0x5A
    LD B, 0xA5
    XOR B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=0, P/V=1, N=0, C=0
    ; Note: 0xFF (11111111b) has 8 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 XOR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0xFF)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 2: 0xE7 XOR 0xE7 = 0x00 (Positive, Even Parity, Zero) ---
    LD A, 0xE7
    LD B, 0xE7
    XOR B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=1, N=0, C=0
    ; Note: 0x00 has 0 bits set -> even parity -> P/V = 1
    BIT 7, E        ; S should be cleared (result bit 7 is 0)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 XOR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be set (even parity for 0x00)
    JP Z, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    ; --- Case 3: 0xE3 XOR 0x77 = 0x94 (Negative, Odd Parity, Non-Zero) ---
    LD A, 0xE3
    LD B, 0x77
    XOR B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x94
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=0, P/V=0, N=0, C=0
    ; Note: 0x94 (10010100b) has 3 bits set -> odd parity -> P/V = 0
    BIT 7, E        ; S should be set (result bit 7 is 1)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is non-zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (unconditionally cleared on Z80 XOR)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (odd parity for 0x94)
    JP NZ, ERROR
    BIT 1, E        ; N should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR
    BIT 0, E        ; C should be cleared (unconditionally cleared on logic ops)
    JP NZ, ERROR

    RET

