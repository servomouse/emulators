TEST_AND_HL:
    ; Setup memory location
    LD HL, TEST_RAM

    ; --- Case 1: 0x5A AND (HL)[0xA5] = 0x00 ---
    LD A, 0xA5
    LD (HL), A
    LD A, 0x5A
    AND (HL)    ; OpUT

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
