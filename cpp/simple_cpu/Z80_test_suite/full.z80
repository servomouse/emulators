    PUSH HL
    POP AF

    ADD IX, DE

    PUSH AF
    POP HL          
    PUSH IX
    POP BC          

    LD A, B
    CP 0x10
    JP NZ, ERROR
    LD A, C
    CP 0x00
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, L        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, L        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, L        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1235 = 0x2469 ---
    LD IX, 0x1234
    LD DE, 0x1235
    LD HL, 0x00C4   
    PUSH HL
    POP AF

    ADD IX, DE

    PUSH AF
    POP HL          
    PUSH IX
    POP BC          

    LD A, B
    CP 0x24
    JP NZ, ERROR
    LD A, C
    CP 0x69
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, L        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, L        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, L        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    LD IX, 0xFFFF
    LD DE, 0x0001
    LD HL, 0x0080   
    PUSH HL
    POP AF

    ADD IX, DE

    PUSH AF
    POP HL          
    PUSH IX
    POP BC          

    LD A, B
    CP 0x00
    JP NZ, ERROR
    LD A, C
    CP 0x00
    JP NZ, ERROR

    BIT 7, L        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, L        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, L        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, L        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, L        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, L        ; C (Set: 1)
    JP Z, ERROR

    RET

TEST_ADD_IX_SP:
    ; --- Case 1: 0x0900 + 0x0800 = 0x1100 ---
    LD (TEMP_SP_SAVE), SP 
    LD IX, 0x0900
    LD HL, 0x0040   
    PUSH HL
    POP AF              
    LD SP, 0x0800       
    
    ADD IX, SP          
    
    LD (SP_RESULT_ADDR), IX 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              ; E = New flags
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x11
    JP NZ, ERROR
    
    BIT 7, E        ; S (0)
    JP NZ, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (1)
    JP Z, ERROR
    BIT 2, E        ; P/V (0)
    JP NZ, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x8000 = 0x1000 ---
    LD (TEMP_SP_SAVE), SP 
    LD IX, 0x9000
    LD HL, 0x0044   
    PUSH HL
    POP AF              
    LD SP, 0x8000       
    
    ADD IX, SP          
    
    LD (SP_RESULT_ADDR), IX 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x10
    JP NZ, ERROR
    
    BIT 7, E        ; S (0)
    JP NZ, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (1)
    JP Z, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1235 = 0x2469 ---
    LD (TEMP_SP_SAVE), SP 
    LD IX, 0x1234
    LD HL, 0x00C4   
    PUSH HL
    POP AF              
    LD SP, 0x1235       
    
    ADD IX, SP          
    
    LD (SP_RESULT_ADDR), IX 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x69
    JP NZ, ERROR

    BIT 7, E        ; S (1)
    JP Z, ERROR
    BIT 6, E        ; Z (1)
    JP Z, ERROR
    BIT 4, E        ; H (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (1)
    JP Z, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0x0001 = 0x0000 ---
    LD (TEMP_SP_SAVE), SP 
    LD IX, 0xFFFF
    LD HL, 0x0080   
    PUSH HL
    POP AF              
    LD SP, 0x0001       
    
    ADD IX, SP          
    
    LD (SP_RESULT_ADDR), IX 
    LD SP, (TEMP_SP_SAVE) 
    PUSH AF
    POP DE              
    LD HL, (SP_RESULT_ADDR) 
    
    LD A, H
    CP 0x00
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (1)
    JP Z, ERROR
    BIT 6, E        ; Z (0)
    JP NZ, ERROR
    BIT 4, E        ; H (1)
    JP Z, ERROR
    BIT 2, E        ; P/V (0)
    JP NZ, ERROR
    BIT 1, E        ; N (0)
    JP NZ, ERROR
    BIT 0, E        ; C (1)
    JP Z, ERROR

    RET

TEST_ADD_IX_IX:
    ; --- Case 1: 0x0900 + 0x0900 = 0x1200 ---
    LD IX, 0x0900
    LD HL, 0x0040   
    PUSH HL
    POP AF

    ADD IX, IX

    PUSH AF
    POP DE          
    PUSH IX
    POP HL          

    LD A, H
