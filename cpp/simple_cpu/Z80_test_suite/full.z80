    LD IY, TEST_RAM
    LD A, 0xF8
    CP (IY-5)       ; d = -5 (translated to 0xFB)

    PUSH AF
    POP DE          

    CP 0xF8
    JP NZ, ERROR
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

; 8-bit ADD opcodes
TEST_ADD_A_B:
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    LD A, 0x7F
    LD B, 0x7E
    ADD A, B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0xFD
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: +127 + +126 wraps negative)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    ; Expected Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    LD A, 0x7F
    LD B, 0x81
    ADD A, B

    PUSH AF
    POP DE          ; E = Flags

    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (0 - +127 + -127 = 0, no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x34 = 0x46 ---
    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    LD A, 0x12
    LD B, 0x34
    ADD A, B

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
    RET

TEST_ADD_A_C:
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
    ; Expected Flags: S=1, Z=0, H=1, P/V=1, N=0, C=0
    LD A, 0x7F
    LD C, 0x7E
    ADD A, C

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0xFD
    JP NZ, ERROR

    ; Verify Flags
    BIT 7, E        ; S flag (1)
    JP Z, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (1 - Overflow: +127 + +126 wraps negative)
    JP Z, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR

    ; --- Case 2: 0x7F + 0x81 = 0x00 ---
    ; Expected Flags: S=0, Z=1, H=1, P/V=0, N=0, C=1
    LD A, 0x7F
    LD C, 0x81
    ADD A, C

    PUSH AF
    POP DE          ; E = Flags

    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (1)
    JP Z, ERROR
    BIT 4, E        ; H flag (1)
    JP Z, ERROR
    BIT 2, E        ; P/V flag (0 - +127 + -127 = 0, no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (1)
    JP Z, ERROR

    ; --- Case 3: 0x12 + 0x34 = 0x46 ---
    ; Expected Flags: S=0, Z=0, H=0, P/V=0, N=0, C=0
    LD A, 0x12
    LD C, 0x34
    ADD A, C

    PUSH AF
    POP DE

    CP 0x46
    JP NZ, ERROR

    BIT 7, E        ; S flag (0)
    JP NZ, ERROR
    BIT 6, E        ; Z flag (0)
    JP NZ, ERROR
    BIT 4, E        ; H flag (0)
    JP NZ, ERROR
    BIT 2, E        ; P/V flag (0)
    JP NZ, ERROR
    BIT 1, E        ; N flag (0)
    JP NZ, ERROR
    BIT 0, E        ; C flag (0)
    JP NZ, ERROR
    
    RET

TEST_ADD_A_D:
    ; --- Case 1: 0x7F + 0x7E = 0xFD ---
