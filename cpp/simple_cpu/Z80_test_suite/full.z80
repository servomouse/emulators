    SUB 0x22        

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_SUB_A:
    ; --- Case: 0xEF - 0xEF = 0x00 (Clean Zero Guarantee) ---
    ; Subtracting A from A always yields 0x00. We load a random 'dirty' 
    ; number to ensure the instruction properly clears the register and flags.
    LD A, 0xEF
    SUB A

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is 0x00, not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is exactly zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SUB_IX_D:
    LD IX, TEST_RAM

    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD A, 0x20
    LD (TEST_RAM_PLUS_5), A     ; Load operand at TEST_RAM + 5
    LD A, 0x20
    SUB (IX+5)

    PUSH AF
    POP DE              ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD A, 0x81     
    LD (TEST_RAM_MINUS_5), A     
    LD A, 0x70
    SUB (IX-5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD A, 0x22     
    LD (TEST_RAM_PLUS_5), A     
    LD A, 0x55
    SUB (IX+5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SUB_IY_D:
    LD IY, TEST_RAM

    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    ; -5 compiles as 0xFB. Tests correct signed address addition.
    LD A, 0x20     ; Load operand at TEST_RAM - 5
    LD (TEST_RAM_MINUS_5), A     ; Load operand at TEST_RAM - 5
    LD A, 0x20
    SUB (IY-5)

