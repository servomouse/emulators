    JP NZ, ERROR    

    BIT 7, C        ; S flag (0)
    JP NZ, ERROR
    BIT 6, C        ; Z flag (1)
    JP Z, ERROR
    BIT 4, C        ; H flag (0)
    JP NZ, ERROR
    BIT 2, C        ; V/P flag (0)
    JP NZ, ERROR
    BIT 1, C        ; N flag (1)
