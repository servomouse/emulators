    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set
    JP Z, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be set
    JP Z, ERROR

    ; --- Case 3: 0xF8 CP (HL)[0xF8] ---
    LD A, 0xF8
    LD (HL), A
