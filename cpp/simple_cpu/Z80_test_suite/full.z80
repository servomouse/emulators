    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    ; --- Case 3: 0x1234 + 0x1234 = 0x2468 ---
    LD IX, 0x1234
