    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
