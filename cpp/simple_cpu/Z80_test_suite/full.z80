    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, C        ; S should be cleared (result is positive)
    JP NZ, ERROR
    BIT 6, C        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, C        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, C        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, C        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, C        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SUB_HL:
    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD HL, TEST_RAM
    LD (HL), 0x20   ; Load operand into memory
    LD A, 0x20
    SUB (HL)

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD HL, TEST_RAM
    LD (HL), 0x81   
    LD A, 0x70
    SUB (HL)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD HL, TEST_RAM
    LD (HL), 0x22   
    LD A, 0x55
    SUB (HL)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_SUB_N:
    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD A, 0x20
    SUB 0x20        ; Immediate operand

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
