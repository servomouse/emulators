; BIT operations
TEST_BIT_OP0:
                    ; Clear flags
    LD HL, 0x0000
    PUSH HL
    POP AF

    BIT 0, A            ; Test bit 0 (should be 0)  ; OpUT
    JP NZ, ERROR
    JP C, ERROR          ; C flag should stay cleared

    PUSH AF
    POP HL
    ; Test the N flag, should be cleared unconditionally
    LD A, L
    AND 2
    JP NZ, ERROR

    ; Test the H flag, should be set unconditionally
    LD A, L
    AND 0x10
    JP Z, ERROR

                    ; Set flags
    LD HL, 0xFFFF
    PUSH HL
    POP AF

    BIT 0, A            ; Test bit 0 (should be 1)  ; OpUT
    JP Z, ERROR
    JP NC, ERROR         ; C flag should stay set

    PUSH AF
    POP HL
    ; Test the N flag, should be cleared unconditionally
    LD A, L
    AND 2
    JP NZ, ERROR

    ; Test the H flag, should be set unconditionally
    LD A, L
    AND 0x10
    JP Z, ERROR

    RET

TEST_BIT_OP1:
                    ; Clear flags
    LD HL, 0x0000
    PUSH HL
    POP AF

    BIT 1, A            ; Test bit 1 (should be 0)      ; OpUT
    JP NZ, ERROR
    JP C, ERROR          ; C flag should stay cleared

    PUSH AF
    POP HL
    ; Test the N flag, should be cleared unconditionally
    LD A, L
    AND 2
    JP NZ, ERROR

    ; Test the H flag, should be set unconditionally
    LD A, L
    AND 0x10
    JP Z, ERROR

                    ; Set flags
    LD HL, 0xFFFF
    PUSH HL
    POP AF

    BIT 1, A            ; Test bit 1 (should be 1)      ; OpUT
    JP Z, ERROR
    JP NC, ERROR         ; C flag should stay set

    PUSH AF
    POP HL
    ; Test the N flag, should be cleared unconditionally
    LD A, L
    AND 2
    JP NZ, ERROR

    ; Test the H flag, should be set unconditionally
    LD A, L
    AND 0x10
    JP Z, ERROR

    RET

