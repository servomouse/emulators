    PUSH HL
    POP AF

    ADD IX, IX

    PUSH AF
    POP DE          
    PUSH IX
    POP HL          

    LD A, H
    CP 0x24
    JP NZ, ERROR
    LD A, L
    CP 0x68
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Cleared: 0)
    JP NZ, ERROR
    BIT 2, E        ; P/V (Preserved: 1)
    JP Z, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 4: 0xFFFF + 0xFFFF = 0xFFFE ---
    LD IX, 0xFFFF
    LD HL, 0x0080   
    PUSH HL
    POP AF

    ADD IX, IX

    PUSH AF
    POP DE          
    PUSH IX
    POP HL          

    LD A, H
    CP 0xFF
    JP NZ, ERROR
    LD A, L
    CP 0xFE
    JP NZ, ERROR
    
    BIT 7, E        ; S (Preserved: 1)
    JP Z, ERROR
    BIT 6, E        ; Z (Preserved: 0)
    JP NZ, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Set: 1)
    JP Z, ERROR

    RET
TEST_ADD_IY_BC:
    ; --- Case 1: 0x0900 + 0x0800 = 0x1100 ---
    ; Expected: Sets H, clears C. S, Z, P/V unchanged. N is reset.
    LD IY, 0x0900
    LD BC, 0x0800
    LD HL, 0x0040   ; L = Initial flags (S=0, Z=1, H=0, P/V=0, N=0, C=0)
    PUSH HL
    POP AF

    ADD IY, BC

    PUSH AF
    POP DE          ; E = New flags
    PUSH IY
    POP HL          ; HL = Result

    LD A, H
    CP 0x11
    JP NZ, ERROR
    LD A, L
    CP 0x00
    JP NZ, ERROR

    BIT 7, E        ; S (Preserved: 0)
    JP NZ, ERROR
    BIT 6, E        ; Z (Preserved: 1)
    JP Z, ERROR
    BIT 4, E        ; H (Set: 1)
    JP Z, ERROR
    BIT 2, E        ; P/V (Preserved: 0)
    JP NZ, ERROR
    BIT 1, E        ; N (Reset: 0)
    JP NZ, ERROR
    BIT 0, E        ; C (Cleared: 0)
    JP NZ, ERROR

    ; --- Case 2: 0x9000 + 0x8000 = 0x1000 ---
    ; Expected: Clears H, sets C. S, Z, P/V unchanged. N is reset.
    LD IY, 0x9000
    LD BC, 0x8000
    LD HL, 0x0044   ; L = Initial flags (S=0, Z=1, H=0, P/V=1, N=0, C=0)
    PUSH HL
    POP AF

    ADD IY, BC

    PUSH AF
    POP DE          
    PUSH IY
    POP HL          

    LD A, H
