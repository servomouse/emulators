TEST_SUB_HL:
    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD HL, TEST_RAM
    LD (HL), 0x20   ; Load operand into memory
    LD A, 0x20
    SUB (HL)

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD HL, TEST_RAM
    LD (HL), 0x81   
    LD A, 0x70
    SUB (HL)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD HL, TEST_RAM
    LD (HL), 0x22   
    LD A, 0x55
    SUB (HL)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_SUB_N:
    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD A, 0x20
    SUB 0x20        ; Immediate operand

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD A, 0x70
    SUB 0x81        

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD A, 0x55
    SUB 0x22        

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_SUB_A:
    ; --- Case: 0xEF - 0xEF = 0x00 (Clean Zero Guarantee) ---
    ; Subtracting A from A always yields 0x00. We load a random 'dirty' 
    ; number to ensure the instruction properly clears the register and flags.
    LD A, 0xEF
    SUB A

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is 0x00, not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is exactly zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SUB_IX_D:
    LD IX, TEST_RAM

    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    LD A, 0x20
    LD (TEST_RAM_PLUS_5), A     ; Load operand at TEST_RAM + 5
    LD A, 0x20
    SUB (IX+5)

    PUSH AF
    POP DE              ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD A, 0x81     
    LD (TEST_RAM_MINUS_5), A     
    LD A, 0x70
    SUB (IX-5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD A, 0x22     
    LD (TEST_RAM_PLUS_5), A     
    LD A, 0x55
    SUB (IX+5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SUB_IY_D:
    LD IY, TEST_RAM

    ; --- Case 1: 0x20 - 0x20 = 0x00 (Clean Zero) ---
    ; -5 compiles as 0xFB. Tests correct signed address addition.
    LD A, 0x20     ; Load operand at TEST_RAM - 5
    LD (TEST_RAM_MINUS_5), A     ; Load operand at TEST_RAM - 5
    LD A, 0x20
    SUB (IY-5)

    PUSH AF
    POP DE              ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 = 0xEF (Everything Edge Case) ---
    LD A, 0x81     
    LD (TEST_RAM_PLUS_5), A     
    LD A, 0x70
    SUB (IY+5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 = 0x33 (Clean Slate) ---
    LD A, 0x22     
    LD (TEST_RAM_MINUS_5), A     
    LD A, 0x55
    SUB (IY-5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

; SBC 8-bit opcodes:
TEST_SBC_A_B:
    ; --- Case 1: 0x22 - 0x21 - C(1) = 0x00 (Clean Zero) ---
    LD A, 0x22
    LD B, 0x21
    SCF             ; Set Carry flag
    SBC A, B

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be set
    JP Z, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 - C(1) = 0xEE (Everything Edge Case) ---
    LD A, 0x70
    LD B, 0x81
    SCF             ; Set Carry flag
    SBC A, B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEE
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set
    JP Z, ERROR
    BIT 2, E        ; P/V should be set
    JP Z, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be set
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 - C(0) = 0x33 (Standard Positive) ---
    LD A, 0x55
    LD B, 0x22
    AND A           ; Clear Carry flag safely
    SBC A, B

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared
    JP NZ, ERROR
    BIT 1, E        ; N should be set
    JP Z, ERROR
    BIT 0, E        ; C should be cleared
    JP NZ, ERROR

    RET

TEST_SBC_A_HL:
    LD HL, TEST_RAM

    ; --- Case 1: 0x22 - 0x21 - C(1) = 0x00 ---
    LD (HL), 0x21   
    LD A, 0x22
    SCF
    SBC A, (HL)

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR

    ; Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E
    JP NZ, ERROR
    BIT 6, E
    JP Z, ERROR
    BIT 4, E
    JP NZ, ERROR
    BIT 2, E
    JP NZ, ERROR
    BIT 1, E
    JP Z, ERROR
    BIT 0, E
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 - C(1) = 0xEE ---
    LD (HL), 0x81   
    LD A, 0x70
    SCF
    SBC A, (HL)

    PUSH AF
    POP DE          

    CP 0xEE
    JP NZ, ERROR

    ; Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E
    JP Z, ERROR
    BIT 6, E
    JP NZ, ERROR
    BIT 4, E
    JP Z, ERROR
    BIT 2, E
    JP Z, ERROR
    BIT 1, E
    JP Z, ERROR
    BIT 0, E
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 - C(0) = 0x33 ---
    LD (HL), 0x22   
    LD A, 0x55
    AND A
    SBC A, (HL)

    PUSH AF
    POP DE          

    CP 0x33
    JP NZ, ERROR

    ; Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E
    JP NZ, ERROR
    BIT 6, E
    JP NZ, ERROR
    BIT 4, E
    JP NZ, ERROR
    BIT 2, E
    JP NZ, ERROR
    BIT 1, E
    JP Z, ERROR
    BIT 0, E
    JP NZ, ERROR

    RET

TEST_SBC_A_N:
    ; --- Case 1: 0x22 - 0x21 - C(1) = 0x00 ---
    LD A, 0x22
    SCF
    SBC A, 0x21

    PUSH AF
    POP DE          

    CP 0x00
    JP NZ, ERROR

    ; Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E
    JP NZ, ERROR
    BIT 6, E
    JP Z, ERROR
    BIT 4, E
    JP NZ, ERROR
    BIT 2, E
    JP NZ, ERROR
    BIT 1, E
    JP Z, ERROR
    BIT 0, E
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 - C(1) = 0xEE ---
    LD A, 0x70
    SCF
    SBC A, 0x81

    PUSH AF
    POP DE          

    CP 0xEE
    JP NZ, ERROR

    ; Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E
    JP Z, ERROR
    BIT 6, E
    JP NZ, ERROR
    BIT 4, E
    JP Z, ERROR
    BIT 2, E
    JP Z, ERROR
    BIT 1, E
    JP Z, ERROR
    BIT 0, E
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 - C(0) = 0x33 ---
    LD A, 0x55
    AND A
    SBC A, 0x22

    PUSH AF
    POP DE          

    CP 0x33
    JP NZ, ERROR

    ; Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E
    JP NZ, ERROR
    BIT 6, E
    JP NZ, ERROR
    BIT 4, E
    JP NZ, ERROR
    BIT 2, E
    JP NZ, ERROR
    BIT 1, E
    JP Z, ERROR
    BIT 0, E
    JP NZ, ERROR

    RET

TEST_SBC_A_A:
    ; --- Case 1: 0x44 - 0x44 - C(1) = 0xFF (Carry Mask Generation) ---
    ; Subtraction of A from A with Carry set always yields 0xFF (-1).
    LD A, 0x44
    SCF             ; Set Carry flag
    SBC A, A

    PUSH AF
    POP DE          ; E = Flags

    ; Verify Result
    CP 0xFF
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=0, N=1, C=1
    BIT 7, E        ; S should be set (0xFF is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required 0x4 - 0x4 - 1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 2: 0xAA - 0xAA - C(0) = 0x00 (Clean Zero) ---
    ; Subtraction of A from A with Carry cleared always yields 0x00.
    LD A, 0xAA
    AND A           ; Clear Carry flag safely
    SBC A, A

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SBC_A_IX_D:
    LD IX, TEST_RAM

    ; --- Case 1: 0x22 - 0x21 - C(1) = 0x00 (Clean Zero, IX+5) ---
    LD A, 0x21
    LD (TEST_RAM_PLUS_5), A  ; Preload operand to memory
    LD A, 0x22
    SCF                      ; Set Carry flag
    SBC A, (IX+5)

    PUSH AF
    POP DE                   ; E = Flags

    ; Verify Result
    CP 0x00
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=1, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is not negative)
    JP NZ, ERROR
    BIT 6, E        ; Z should be set (result is zero)
    JP Z, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    ; --- Case 2: 0x70 - 0x81 - C(1) = 0xEE (Everything Edge Case, IX-5) ---
    LD A, 0x81
    LD (TEST_RAM_MINUS_5), A 
    LD A, 0x70
    SCF                      
    SBC A, (IX-5)   ; -5 displacement (0xFB)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0xEE
    JP NZ, ERROR

    ; Verify Flags: S=1, Z=0, H=1, P/V=1, N=1, C=1
    BIT 7, E        ; S should be set (result is negative)
    JP Z, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be set (borrow required for 0x0 - 0x1 - 1)
    JP Z, ERROR
    BIT 2, E        ; P/V should be set (signed overflow)
    JP Z, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be set (borrow required from MSB)
    JP Z, ERROR

    ; --- Case 3: 0x55 - 0x22 - C(0) = 0x33 (Standard Positive, IX+5) ---
    LD A, 0x22
    LD (TEST_RAM_PLUS_5), A  
    LD A, 0x55
    AND A                    ; Clear Carry flag safely
    SBC A, (IX+5)

    PUSH AF
    POP DE          

    ; Verify Result
    CP 0x33
    JP NZ, ERROR

    ; Verify Flags: S=0, Z=0, H=0, P/V=0, N=1, C=0
    BIT 7, E        ; S should be cleared (result is positive)
    JP NZ, ERROR
    BIT 6, E        ; Z should be cleared (result is not zero)
    JP NZ, ERROR
    BIT 4, E        ; H should be cleared (no half-borrow)
    JP NZ, ERROR
    BIT 2, E        ; P/V should be cleared (no signed overflow)
    JP NZ, ERROR
    BIT 1, E        ; N should be set (subtraction operation)
    JP Z, ERROR
    BIT 0, E        ; C should be cleared (no borrow)
    JP NZ, ERROR

    RET

TEST_SBC_A_IY_D:
